noextract=()
backup=('etc/kibaos/features.conf' 'etc/kibaos/google-api.conf')

check() {
    bash "${srcdir}/test-session-error.sh" "${srcdir}/kibaos-session-error"
    KIBAOS_PKGBUILD_PATH="${startdir}/PKGBUILD" \
        KIBAOS_CI_DIR="${startdir}/../ci" \
        bash "${srcdir}/test-google-api-config.sh"
    bash "${srcdir}/test-local-account-flags.sh"
}

# The Files window is a resource rather than something compiled into Chromium,
# so it is placed into resources.pak after the build rather than by the build.
# It runs here, in the package, because the two paks that shipped a page which
# drew perfectly and ran nothing were both assembled by hand.
#
# ci/build-current-chromiumos-ash-package.sh copies this PKGBUILD out of the
# repo and away from ci/, so it exports KIBAOS_FILES_PAK_TOOL; a build run from
# the repo finds the tool beside it instead.
_place_files_page() {
    local out_dir="$1"
    local pak_tool="${KIBAOS_FILES_PAK_TOOL:-${startdir}/../ci/build-files-pak.sh}"

    if [ ! -x "${pak_tool}" ]; then
        echo "ERROR: cannot place the Files page: no build-files-pak.sh at ${pak_tool}" >&2
        echo "       Set KIBAOS_FILES_PAK_TOOL, or build from a full repo checkout." >&2
        return 1
    fi
    # Into the package's own staging area, never over the Chromium output.
    # That output is an input here, it belongs to whoever built it, and a
    # package build that writes into its inputs is not reproducible and not
    # permitted: as aurabuild against a root-owned out directory it simply
    # fails with "Permission denied" in the middle of build().
    install -dm755 "${srcdir}/kibaos-pak"
    "${pak_tool}" "${out_dir}" "${srcdir}/kibaos-pak/resources.pak"
}

# The session's weston shell, which spreads the desktop over every monitor.
# It is built against the libweston that is installed; a newer weston that
# can no longer load it gets kiosk-shell from the session instead.
_build_weston_shell() {
    local libweston
    libweston="$(pkg-config --list-all | grep -o '^libweston-[0-9]*' | sort -V | tail -n 1)"
    if [ -z "${libweston}" ]; then
        echo "ERROR: no libweston development files for the weston shell" >&2
        return 1
    fi
    # shellcheck disable=SC2046,SC2086
    cc ${CFLAGS} -std=gnu11 -fPIC -shared -fvisibility=hidden \
        $(pkg-config --cflags weston "${libweston}" wayland-server) \
        -o "${srcdir}/kibaos-shell.so" "${srcdir}/kibaos-weston-shell.c" \
        ${LDFLAGS} $(pkg-config --libs "${libweston}" wayland-server) \
        -L/usr/lib/weston -l:libexec_weston.so.0 \
        -Wl,-rpath,/usr/lib/weston -Wl,-z,defs
}

# The lock screen's password check, which goes through PAM like any other
# Linux locker's.
_build_unlock_check() {
    # shellcheck disable=SC2086
    cc ${CFLAGS} -std=gnu11 -Wall -Wextra \
        -o "${srcdir}/kibaos-unlock-check" "${srcdir}/kibaos-unlock-check.c" \
        ${LDFLAGS} -lpam
}

build() {
    _build_weston_shell
    _build_unlock_check

    # CHROME_SRC must point to a synced+patched ChromiumOS src dir
    local chrome_src="${CHROME_SRC:-${srcdir}/chromiumos-src}"
    # Keep the completed output separate from the source checkout. This lets
    # a release package the exact verified Chromium build without copying a
    # multi-gigabyte Ninja tree into the Arch build root.
    local out_dir="${KIBAOS_OUT_DIR:-${chrome_src}/out/Ash}"

    if [ ! -d "${chrome_src}" ]; then
        echo "ERROR: CHROME_SRC not found at ${chrome_src}"
        echo "Run 'ci/bootstrap-chromium-src.sh --run' first."
        exit 1
    fi

    cd "${chrome_src}"

    if [ "${KIBAOS_SKIP_CHROMIUM_BUILD:-0}" = "1" ]; then
        if [ ! -x "${out_dir}/chrome" ] || [ ! -x "${out_dir}/chrome_sandbox" ]; then
            echo "ERROR: KIBAOS_SKIP_CHROMIUM_BUILD=1 but chrome artifacts are missing."
            echo "Expected ${out_dir}/chrome and ${out_dir}/chrome_sandbox."
            exit 1
        fi
        echo "Using existing ChromiumOS Ash build artifacts from ${out_dir}."
        _place_files_page "${out_dir}"
        return
    fi

    local ci_dir="${KIBAOS_CI_DIR:-${startdir}/../ci}"

    # abseil-cpp is vendored in the tree's git and every TU includes it, so a
    # header that was emptied or lost there fails as undefined ABSL_* macros
    # far from the cause. Put the pinned copy back before ninja starts; its
    # series hunks are re-applied with it.
    if [ -f "${ci_dir}/restore-truncated-sources.py" ]; then
        python3 "${ci_dir}/restore-truncated-sources.py" \
            --tree "${chrome_src}" --restore-dir third_party/abseil-cpp \
            --apply ||
            echo "WARNING: abseil-cpp damage could not be repaired (see ==> source-check: above); ninja will fail on its headers" >&2
    fi

    # A dependency file truncated by a bad copy surfaces much later as a
    # compile error about a declaration that is not there (abseil's
    # cycleclock.h lost its contents and the first TU to need it failed), so
    # check every checkout, nested DEPS deps included, before ninja starts.
    # Only files that still exist and are modified outside chrome/ and the
    # patch series are restored; the pruned browser subtree never comes back.
    if [ -f "${ci_dir}/restore-truncated-sources.py" ]; then
        python3 "${ci_dir}/restore-truncated-sources.py" \
            --tree "${chrome_src}" --apply --quiet-chrome ||
            echo "WARNING: the source check above found damage it could not repair (see its ==> source-check: lines); ninja will fail on it later" >&2
    fi

    # Lumen's source import also took the include lines out of the trees it
    # imported: every `#include "absl/..."` line from third_party/abseil-cpp,
    # every quoted include from third_party/protobuf, and every quoted include
    # from base/ and build/ -- the Rust allocator's buildflags.h among them,
    # without which its translation unit does not compile. The files it kept
    # are not self-contained, so the first abseil TU fails on
    # ABSL_NAMESPACE_BEGIN while the first protobuf TU fails on `absl`. This
    # runs after the source check above, which restores modified files from
    # HEAD and would undo it. Every manifest beside the tool is applied. Every
    # block goes back between the two lines it sat between, so the result is
    # Chromium's copy again, and a file Lumen has already restored is left as
    # it is.
    # Stop here rather than let ninja report a header that looks intact: an
    # unrepaired include fails its first user hours into the build and nowhere
    # near the file that lost it.
    if [ -f "${ci_dir}/restore-imported-includes.py" ]; then
        if ! python3 "${ci_dir}/restore-imported-includes.py" \
                --tree "${chrome_src}" --apply; then
            echo "ERROR: the includes the import dropped could not be restored (see the ==> imported-includes: lines above); ninja would fail on a header that looks intact" >&2
            exit 1
        fi
    fi

    # GN arguments for the tools ci/system-tools.sh took from pacman instead of
    # Chromium's prebuilt downloads. They are written beside the checkout's own
    # output directory, which Chromium's .gitignore covers, and are empty when
    # the bootstrap kept the downloaded toolchain.
    _system_tool_gn_args() {
        if [ -r "${chrome_src}/out/.kibaos/system-tools.gn" ]; then
            cat "${chrome_src}/out/.kibaos/system-tools.gn"
        fi
    }

    # Generate GN args without Google credentials. KibaOS uses local accounts
    # for the public release, while the runtime config remains an optional
    # user-owned hook for a future private build.
    # This tree has no chrome/ source: Lumen's shell delegation in lumen/
    # replaces the browser UI chrome would provide. Root BUILD.gn still imports
    # a handful of chrome/*.gni config files unconditionally, carried as
    # config-only shims by patch 0162, and its group targets still reference
    # //chrome/* targets that do not exist, so it cannot be the build file gn
    # loads first. --root-target points the bootstrap at //lumen/BUILD.gn
    # instead, so the graph is exactly //lumen:chrome plus its transitive
    # dependencies and the pruned tree configures cleanly. --root-pattern
    # cannot do this job: it only restricts which targets generate, and gn
    # still boots from root BUILD.gn, so nothing ever loads //lumen/BUILD.gn
    # and the graph ends up empty. chrome_sandbox is a data_dep of
    # //lumen:chrome (patch 0163), so building chrome builds the sandbox
    # helper too.
    #
    # gn surfaces one pruned-file failure per attempt, so the call below is
    # a loop: every failed attempt hands its log to ci/gn_edge_cut.py, which
    # restores inert files when a mirror is available, cuts the dep edge
    # that requested a deleted build file, cuts refs to targets the pruner
    # dropped (gn's Unresolved dependencies), dedupes source listings that
    # collide into one object file, cuts input refs nothing generates, and
    # adds the generator deps gn flags as missing. The graph sheds its edges
    # into the pruned chrome/ subtree instead of growing the browser back.
    _ash_gn_gen() {
        gn gen "${out_dir}" \
        --root-target="//lumen" \
        --args="
        # Ash only builds under is_chromeos, which this tree derives from
        # current_os in build/config/BUILDCONFIG.gn: it cannot be set as a
        # gn arg. target_os=chromeos with is_chromeos_device=false is the
        # upstream linux-chromeos flavor: it compiles with the linux
        # toolchain on this host and runs as a desktop browser.
        target_os = \"chromeos\"
        target_cpu = \"x64\"
        is_debug = false
        is_component_build = false
        is_official_build = false
        is_chrome_branded = false
        is_chromeos_device = false
        symbol_level = 0
        blink_symbol_level = 0
        v8_symbol_level = 0
        treat_warnings_as_errors = false
        use_sysroot = true
        use_ozone = true
        ozone_platform_wayland = true
        use_system_minigbm = true
        enable_rust = true
        use_official_google_api_keys = false

        # Chromium turns DCHECKs on and makes them fatal for any build that is
        # not is_official_build, which this is not and cannot be without Google
        # branding. Left at that default the desktop inherits every DCHECK in
        # Chromium as an abort: ash::help_app's search handler drops a mojo
        # callback about a hundred seconds into a session and takes the whole
        # session down with it, and that is one of hundreds. A release logs
        # where a development build asserts, so the assert comes off here and
        # the bring up tree keeps it.
        dcheck_always_on = false

        # Chromium's Clang modules build (use_clang_modules) modularizes every
        # target's headers, so a target whose header or dep edges were pruned
        # or rewritten becomes an empty module and its headers define nothing.
        # That is what stops the first abseil TU here: ABSL_NAMESPACE_BEGIN,
        # ABSL_RAW_LOG and FATAL all arrive undefined because absl/base/config.h
        # was consumed as a module instead of being preprocessed. This tree is
        # pruned and patched, so compile textually as the pre-modules tree did.
        use_clang_modules = false

        $(_system_tool_gn_args)
    "
    }

    # A link at buildtools/linux64/gn is what ci/system-tools.sh leaves when a
    # package GN is used, and one that cannot read the tree's .gn fails before
    # a single build argument is read: no amount of recovery changes that, so
    # stop here and name the command that fetches the pinned GN.
    if [ -f "${ci_dir}/system-tools.sh" ] &&
        [ -L "${chrome_src}/buildtools/linux64/gn" ]; then
        bash "${ci_dir}/system-tools.sh" --check-gn "${chrome_src}" ||
            exit 1
    fi

    local gn_log="${srcdir}/gn-gen.log"
    local gn_attempt=1
    local gn_max="${KIBAOS_GN_RECOVERY_ATTEMPTS:-200}"
    while :; do
        echo "==> gn gen attempt ${gn_attempt}/${gn_max}"
        if _ash_gn_gen >"${gn_log}" 2>&1; then
            rm -f "${gn_log}"
            break
        fi
        cat "${gn_log}"
        if [ "${gn_attempt}" -ge "${gn_max}" ]; then
            echo "ERROR: gn gen did not converge within ${gn_max} attempts" >&2
            exit 1
        fi
        if [ ! -f "${ci_dir}/gn_edge_cut.py" ]; then
            echo "ERROR: ci/gn_edge_cut.py not found at ${ci_dir} to recover the gn gen failure above" >&2
            exit 1
        fi
        if ! python3 "${ci_dir}/gn_edge_cut.py" \
            --lumen "${chrome_src}" \
            --out-dir "${out_dir}" \
            ${KIBAOS_CHROMIUM_MIRROR:+--chromium "${KIBAOS_CHROMIUM_MIRROR}"} \
            ${KIBAOS_CHROMIUM_REF:+--ref "${KIBAOS_CHROMIUM_REF}"} \
            --log-file "${gn_log}"; then
            echo "ERROR: nothing in the gn log above is recoverable" >&2
            exit 1
        fi
        gn_attempt=$((gn_attempt + 1))
    done

    if grep -Eq '^[[:space:]]*google_(api_key|default_client_id|default_client_secret)[[:space:]]*=[[:space:]]*"[^"]+"' "${out_dir}/args.gn"; then
        echo 'ERROR: no-key KibaOS build contains a Google credential' >&2
        exit 1
    fi

    # Fail closed if the build would publish the desktop fake network services,
    # which look like real connections in Ash. What made them real on generic
    # Linux was patch 0038: ash_dbus_helper routed the Shill clients to their
    # own narrowly scoped bus rather than to the global one, which does not
    # exist here. That call site left with the chrome/ tree — //lumen:chrome is
    # the shell delegation entry, not a browser — and the routing now lives on
    # the KibaOS side: the shill-nm-adapter service at the root of this repo
    # owns org.chromium.flimflam on the system bus, this package depends on it,
    # and patch 0055 keeps the remaining dbus clients off the fake environment.
    # The chromium source carries no network routing of its own any more, so
    # the guard checks the adapter the runtime bridge depends on.
    #
    # This used to check toolchain.ninja for -DUSE_REAL_DBUS_CLIENTS. That flag
    # was the mechanism before 0038 existed, and it stopped being safe on
    # 2026-08-20 when upstream gave about seventy clients under
    # chromeos/ash/components/dbus a CHECK(bus) on Initialize. Setting it also
    # sets use_real_chromeos_services via chromeos/features.gni, which drops the
    # fake mojo service manager from the build entirely, so a build carrying the
    # define aborts in PostEarlyInitialization before any window appears.
    local shill_adapter="${KIBAOS_SHILL_ADAPTER_DIR:-${startdir}/../shill-nm-adapter}/shill_nm_adapter.py"
    if [[ ! -r "${shill_adapter}" ]] ||
       ! grep -Fq 'org.chromium.flimflam' "${shill_adapter}"; then
        echo 'ERROR: missing the real Shill routing: shill-nm-adapter is not in the KibaOS source tree' >&2
        return 1
    fi

    # Build the chrome target and its setuid sandbox helper.
    ninja -C "${out_dir}" -j"$(nproc)" chrome chrome_sandbox

    _place_files_page "${out_dir}"
}

package() {
    local chrome_src="${CHROME_SRC:-${srcdir}/chromiumos-src}"
    local out_dir="${KIBAOS_OUT_DIR:-${chrome_src}/out/Ash}"
    local gn_bin="gn"
    local runtime_deps="${srcdir}/chromiumos-ash.runtime_deps"

    # Fail early and clearly if there is no built Chromium output to package.
    if [ ! -x "${out_dir}/chrome" ] || [ ! -x "${out_dir}/chrome_sandbox" ]; then
        echo "ERROR: no built Chromium output in ${out_dir}" >&2
        echo "Expected ${out_dir}/chrome and ${out_dir}/chrome_sandbox." >&2
        echo "Check CHROME_SRC / KIBAOS_OUT_DIR, and that build() ran (or the" >&2
        echo "prebuilt tree was mounted) before package()." >&2
        return 1
    fi

    if [ -x "${chrome_src}/buildtools/linux64/gn" ]; then
        gn_bin="${chrome_src}/buildtools/linux64/gn"
    elif [ -x "${chrome_src}/third_party/depot_tools/gn" ]; then
        # Source checkouts keep the bootstrap GN wrapper in depot_tools when
        # the standalone buildtools binary was not materialized.
        gn_bin="${chrome_src}/third_party/depot_tools/gn"
    fi

    copy_runtime_dep() {
        local rel="${1#./}"
        local src
        local dest

        if [ -z "${rel}" ]; then
            return
        fi

        case "${rel}" in
            *.TOC|*.rsp|*.runtime_deps)
                return
                ;;
        esac

        src="${out_dir}/${rel}"
        dest="${pkgdir}/usr/lib/chromiumos-ash/${rel}"

        # build() places the Files page into a pak of its own rather than
        # over the Chromium output, so anything staged there wins.
        if [ -e "${srcdir}/kibaos-pak/${rel}" ]; then
            src="${srcdir}/kibaos-pak/${rel}"
        fi

        if [ ! -e "${src}" ]; then
            printf 'warning: runtime dependency not found: %s\n' "${rel}" >&2
            return
        fi

        if [ -d "${src}" ]; then
            mkdir -p "${dest}"
            cp -a "${src}/." "${dest}/"
        else
            install -Dm644 "${src}" "${dest}"
            if [ -x "${src}" ]; then
                chmod 755 "${dest}"
            fi
        fi
    }

    (
        cd "${chrome_src}"
        if ! "${gn_bin}" desc "${out_dir}" //lumen:chrome runtime_deps >"${runtime_deps}"; then
            cat >"${runtime_deps}" <<'EOF'
./chrome
./chrome_crashpad_handler
./chrome_sandbox
chrome_100_percent.pak
chrome_200_percent.pak
icudtl.dat
keyboard_resources.pak
resources.pak
snapshot_blob.bin
libEGL.so
libGLESv2.so
libvk_swiftshader.so
libvulkan.so.1
liboptimization_guide_internal.so
vk_swiftshader_icd.json
IwaKeyDistribution
MEIPreload
PrivacySandboxAttestationsPreloaded
dbus
locales
mojo_service_manager
resources
EOF
        fi
    )

    while IFS= read -r runtime_dep; do
        copy_runtime_dep "${runtime_dep}"
    done < <(sort -u "${runtime_deps}")

    # KibaOS compatibility: Chromium's ChromeOS accessibility extensions are
    # emitted as generated files under resources/.  GN runtime_deps currently
    # lists their manifests but not every extension payload, so copying only
    # runtime_deps leaves ChromeVox and Select-to-Speak unable to start.
    # Preserve the complete generated trees in the package.
    for resource_dir in \
        accessibility \
        chromeos/accessibility; do
        if [ -d "${out_dir}/resources/${resource_dir}" ]; then
            mkdir -p "${pkgdir}/usr/lib/chromiumos-ash/resources/${resource_dir}"
            cp -a "${out_dir}/resources/${resource_dir}/." \
                "${pkgdir}/usr/lib/chromiumos-ash/resources/${resource_dir}/"
        fi
    done

    if [ -e "${pkgdir}/usr/lib/chromiumos-ash/chrome_sandbox" ]; then
        mv "${pkgdir}/usr/lib/chromiumos-ash/chrome_sandbox" \
            "${pkgdir}/usr/lib/chromiumos-ash/chrome-sandbox"
    fi

    chmod -R u+rwX,go+rX "${pkgdir}/usr/lib/chromiumos-ash"

    if [ -e "${pkgdir}/usr/lib/chromiumos-ash/chrome-sandbox" ]; then
        chown root:root "${pkgdir}/usr/lib/chromiumos-ash/chrome-sandbox"
        chmod 4755 "${pkgdir}/usr/lib/chromiumos-ash/chrome-sandbox"
    fi

    # KibaOS compatibility: Arch's ttf-roboto package installs under
    # /usr/share/fonts/TTF, while some ChromeOS readahead paths still probe the
    # ChromeOS-style /usr/share/fonts/roboto directory.
    install -dm755 "${pkgdir}/usr/share/fonts/roboto"
    ln -s /usr/share/fonts/TTF/Roboto-Regular.ttf \
        "${pkgdir}/usr/share/fonts/roboto/Roboto-Regular.ttf"
    ln -s /usr/share/fonts/TTF/Roboto-Medium.ttf \
        "${pkgdir}/usr/share/fonts/roboto/Roboto-Medium.ttf"

    # Install launcher script
    install -Dm755 "${srcdir}/chromiumos-ash.sh" \
        "${pkgdir}/usr/bin/chromiumos-ash"
    install -Dm755 "${srcdir}/chromiumos-ash-session.sh" \
        "${pkgdir}/usr/bin/chromiumos-ash-session"
    install -Dm755 "${srcdir}/chromiumos-ash-session-child.sh" \
        "${pkgdir}/usr/bin/chromiumos-ash-session-child"
    install -Dm755 "${srcdir}/kibaos-session-error" \
        "${pkgdir}/usr/bin/kibaos-session-error"
    install -Dm755 "${srcdir}/kibaos-shell.so" \
        "${pkgdir}/usr/lib/chromiumos-ash/kibaos-shell.so"
    install -Dm755 "${srcdir}/kibaos-unlock-check" \
        "${pkgdir}/usr/lib/chromiumos-ash/kibaos-unlock-check"
    install -Dm644 "${srcdir}/kibaos-lock.pam" \
        "${pkgdir}/etc/pam.d/kibaos-lock"

    # Install X11 session entry for display managers.
    install -Dm644 "${srcdir}/chromiumos-ash.desktop" \
        "${pkgdir}/usr/share/xsessions/chromiumos-ash.desktop"
    install -Dm644 "${srcdir}/chromiumos-ash-wayland.desktop" \
        "${pkgdir}/usr/share/wayland-sessions/chromiumos-ash.desktop"

    # Install feature defaults.
    install -Dm644 "${srcdir}/kibaos.features.conf" \
        "${pkgdir}/etc/kibaos/features.conf"
    # The wallpaper the desktop shows until somebody picks another, and takes
    # its colours from. The session hands Ash the path KIBAOS_DEFAULT_WALLPAPER
    # names, so the file has to be installed beside the setting rather than
    # borrowed from somewhere else: kibaos-wallpapers carries the photographs
    # Personalization offers, is optional, and a desktop whose first wallpaper
    # is missing falls back to a grey gradient.
    install -Dm644 "${srcdir}/kibaos-default-wallpaper.png" \
        "${pkgdir}/usr/share/kibaos/default-wallpaper.png"
    local google_api_runtime_config="${KIBAOS_GOOGLE_API_CONFIG:-${srcdir}/google-api.conf.example}"
    install -Dm644 "${google_api_runtime_config}" \
        "${pkgdir}/etc/kibaos/google-api.conf"
    install -Dm644 "${srcdir}/google-api.conf.example" \
        "${pkgdir}/usr/share/doc/${pkgname}/google-api.conf.example"

    # Install optional SessionManager shim components. D-Bus activation can
    # start this on demand once the KibaOS session lifecycle switches from the
    # in-process fake client to a host service.
    install -Dm755 "${srcdir}/kibaos-session-manager-shim.py" \
        "${pkgdir}/usr/lib/chromiumos-ash/kibaos-session-manager-shim.py"
    install -Dm644 "${srcdir}/kibaos-session-manager.service" \
        "${pkgdir}/usr/lib/systemd/system/kibaos-session-manager.service"
    install -Dm644 "${srcdir}/org.chromium.SessionManager.conf" \
        "${pkgdir}/usr/share/dbus-1/system.d/org.chromium.SessionManager.conf"
    install -Dm644 "${srcdir}/org.chromium.SessionManager.service" \
        "${pkgdir}/usr/share/dbus-1/system-services/org.chromium.SessionManager.service"

    # KibaOS compatibility: generic Linux installs need the Wayland group for
    # exo's Wayland server and writable ChromeOS metrics state directories.
    install -Dm644 "${srcdir}/chromiumos-ash.sysusers.conf" \
        "${pkgdir}/usr/lib/sysusers.d/chromiumos-ash.conf"
    install -Dm644 "${srcdir}/chromiumos-ash.tmpfiles.conf" \
        "${pkgdir}/usr/lib/tmpfiles.d/chromiumos-ash.conf"

    # GTK title bars with the desktop's buttons; see the files themselves.
    install -Dm644 "${srcdir}/kibaos-gtk-settings.ini" \
        "${pkgdir}/etc/xdg/gtk-3.0/settings.ini"
    install -Dm644 "${srcdir}/kibaos-gtk-settings.ini" \
        "${pkgdir}/etc/xdg/gtk-4.0/settings.ini"
    install -Dm644 "${srcdir}/90_kibaos.gschema.override" \
        "${pkgdir}/usr/share/glib-2.0/schemas/90_kibaos.gschema.override"
    # X11 applications' defaults, loaded by the session when the X11 bridge
    # comes up; ~/.Xresources still wins.
    install -Dm644 "${srcdir}/kibaos-Xresources" \
        "${pkgdir}/usr/share/kibaos/Xresources"
    # GTK 4 window controls drawn as Ash draws its own; the session points the
    # user's gtk.css at it.
    install -Dm644 "${srcdir}/kibaos-gtk4.css" \
        "${pkgdir}/usr/share/kibaos/gtk-4.0/gtk.css"
    # Ash answers xdg-desktop-portal's appearance settings (light or dark,
    # accent colour); GTK's backend answers everything else.
    install -Dm644 "${srcdir}/kibaos.portal" \
        "${pkgdir}/usr/share/xdg-desktop-portal/portals/kibaos.portal"
    install -Dm644 "${srcdir}/kibaos-portals.conf" \
        "${pkgdir}/usr/share/xdg-desktop-portal/kibaos-portals.conf"
    # Qt and KDE applications: the Breeze style's settings and a starting
    # kdeglobals, under the configuration path Ash gives them, behind the
    # live colour scheme Ash writes into the runtime directory.
    install -Dm644 "${srcdir}/kibaos-breezerc" \
        "${pkgdir}/usr/share/kibaos/xdg/breezerc"
    install -Dm644 "${srcdir}/kibaos-kdeglobals" \
        "${pkgdir}/usr/share/kibaos/xdg/kdeglobals"
    # Folders open in KibaOS Files, through Ash's FileManager1, whatever
    # other file manager is installed.
    install -Dm755 "${srcdir}/kibaos-open-folder" \
        "${pkgdir}/usr/bin/kibaos-open-folder"
    install -Dm644 "${srcdir}/kibaos-files.desktop" \
        "${pkgdir}/usr/share/applications/kibaos-files.desktop"
    # Links open in the KibaOS browser, through Ash's org.kibaos.Browser on
    # the desktop's session bus, whatever other browser is installed.
    install -Dm755 "${srcdir}/kibaos-open-url" \
        "${pkgdir}/usr/bin/kibaos-open-url"
    install -Dm644 "${srcdir}/kibaos-browser.desktop" \
        "${pkgdir}/usr/share/applications/kibaos-browser.desktop"
    # Settings changes the system's time zone, not only the desktop's.
    install -Dm644 "${srcdir}/kibaos-timezone.rules" \
        "${pkgdir}/usr/share/polkit-1/rules.d/50-kibaos-timezone.rules"
    install -Dm644 "${srcdir}/kibaos-mimeapps.list" \
        "${pkgdir}/usr/share/applications/kibaos-mimeapps.list"
    install -Dm644 "${srcdir}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}