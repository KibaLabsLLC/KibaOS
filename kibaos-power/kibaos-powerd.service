[Unit]
Description=KibaOS Linux power lifecycle bridge
After=dbus.service systemd-tmpfiles-setup.service upower.service
Wants=upower.service

[Service]
Type=simple
ExecStart=/usr/lib/kibaos/kibaos-powerd
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/kibaos /var/lib/kibaos

[Install]
WantedBy=multi-user.target
