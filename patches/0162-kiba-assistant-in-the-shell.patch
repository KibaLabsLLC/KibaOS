+namespace ash {
+
+class KibaBubbleContents;
+
+// KibaOS compatibility: what the Kiba assistant's bubble shows, a card drawn
+// with Views from the state kibavoiced reports. It owns no state of its own.
+struct KibaBubbleState {
+  std::string state = "idle";
+  std::u16string status;
+  bool muted = false;
+};
+
+class KibaBubble {
+ public:
+  struct Callbacks {
+    // The orb was pressed: talk when idle, stop when speaking.
+    base::RepeatingClosure orb_pressed;
+    base::RepeatingCallback<void(bool muted)> set_muted;
+    // The bubble went away, however it did.
+    base::OnceClosure closed;
+  };
+
+  // `pinned` bubbles come from a click and take focus; the others come from
+  // the wake phrase and neither take it nor stay. `anchor` is a point on the
+  // screen the bubble opens beside.
+  static std::unique_ptr<KibaBubble> Create(const KibaBubbleState& state,
+                                            const gfx::Point& anchor,
+                                            bool pinned,
+                                            Callbacks callbacks);
+
+  KibaBubble(const KibaBubble&) = delete;
+  KibaBubble& operator=(const KibaBubble&) = delete;
+  ~KibaBubble();
+
+  void SetState(const KibaBubbleState& state);
+  // rms 0..1; low, mid and high are spectral weights.
+  void SetLevel(double rms, double low, double mid, double high);
+  bool pinned() const { return pinned_; }
+  void Close();
+
+ private:
+  KibaBubble();
+
+  bool pinned_ = false;
+  base::WeakPtr<views::Widget> widget_;
+  // Goes with the widget, which is why every use checks `widget_` first.
+  raw_ptr<KibaBubbleContents, DisableDanglingPtrDetection> contents_ = nullptr;
+  base::WeakPtrFactory<KibaBubble> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_KIBA_BUBBLE_H_
