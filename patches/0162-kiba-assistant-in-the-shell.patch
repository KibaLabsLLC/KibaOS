+#ifndef CHROME_BROWSER_ASH_DBUS_KIBA_ASSISTANT_H_
+#define CHROME_BROWSER_ASH_DBUS_KIBA_ASSISTANT_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "ash/shell.h"
+#include "ash/shell_observer.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ash/dbus/kiba_bubble.h"
+#include "ui/gfx/geometry/point.h"
+
+namespace aura {
+class Window;
+}  // namespace aura
+
+namespace base {
+class Thread;
+}  // namespace base
+
+namespace dbus {
+class Bus;
+class MethodCall;
+class ObjectProxy;
+class Response;
+class Signal;
+}  // namespace dbus
+
+namespace ash {
+
+// KibaOS compatibility: the Kiba voice assistant in the shell. The engine is
+// kibavoiced, which owns the microphone, the wake phrase, the model and the
+// voice and answers on org.kibaos.Kiba of the session bus (see
+// kibaos-kai/org.kibaos.Kiba1.xml). Ash draws it: a status icon whose click
+// opens a card with the orb, what Kiba is doing and a wave that follows the
+// microphone, and a card that opens by itself, without taking focus, when
+// "Hey Kiba" is heard and tucks away after the answer.
+//
+// The icon is there while kibavoiced is. Asking for its state is also what
+// starts it, because the bus activates the name.
+class KibaAssistant : public ShellObserver {
+ public:
+  // Returns null when the client cannot start.
+  static std::unique_ptr<KibaAssistant> Create();
+
+  KibaAssistant(const KibaAssistant&) = delete;
+  KibaAssistant& operator=(const KibaAssistant&) = delete;
+  ~KibaAssistant() override;
+
+  // ShellObserver:
+  void OnRootWindowAdded(aura::Window* root_window) override;
+
+ private:
+  KibaAssistant();
+
+  bool Start();
+
+  // The daemon's name gained or lost an owner.
+  void OnNameOwnerChanged(const std::string& old_owner,
+                          const std::string& new_owner);
+  void RefreshProperties();
+  void OnProperties(dbus::Response* response);
+  void OnStateChanged(dbus::Signal* signal);
+  void OnWakeHeard(dbus::Signal* signal);
+  void OnLevel(dbus::Signal* signal);
+
+  // Calls a method of org.kibaos.Kiba1 with at most one argument.
+  void Call(const char* method);
+  void CallBool(const char* method, bool value);
+
+  void SetPresent(bool present);
+  void UpdateIcons();
+  void OnIconActivated(const gfx::Point& screen_point);
+  void OpenBubble(const gfx::Point& anchor, bool pinned);
+  void OnOrbPressed();
+  void OnBubbleClosed(int generation);
+  void HideTimerFired();
+  KibaBubbleState BubbleState() const;
+
+  std::unique_ptr<base::Thread> dbus_thread_;
+  scoped_refptr<dbus::Bus> bus_;
+  raw_ptr<dbus::ObjectProxy> proxy_ = nullptr;
+
+  bool present_ = false;
+  std::string state_ = "idle";
+  std::u16string status_;
+  bool muted_ = false;
+
+  std::unique_ptr<KibaBubble> bubble_;
+  // Which bubble a closed notice is about: a late one for a bubble already
+  // replaced must not take the new one away.
+  int bubble_generation_ = 0;
+  bool level_stream_ = false;
+  base::OneShotTimer hide_timer_;
+
+  base::ScopedObservation<Shell, ShellObserver> shell_observation_{this};
+  base::WeakPtrFactory<KibaAssistant> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_KIBA_ASSISTANT_H_
