+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/kiba_assistant.h"
+
+#include <utility>
+
+#include "ash/shell.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/message_loop/message_pump_type.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/threading/thread.h"
+#include "base/time/time.h"
+#include "cc/paint/paint_flags.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "dbus/object_proxy.h"
+#include "ui/aura/window.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/image/canvas_image_source.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/skia_paint_util.h"
+
+namespace ash {
+
+namespace {
+
+constexpr char kService[] = "org.kibaos.Kiba";
+constexpr char kPath[] = "/org/kibaos/Kiba";
+constexpr char kInterface[] = "org.kibaos.Kiba1";
+constexpr char kPropertiesInterface[] = "org.freedesktop.DBus.Properties";
+
+// Clear of the IDs Chrome's own status icons count up from 2 and of the ones
+// the Linux applications' icons take from 1 << 24, and small enough to become
+// a view's ID.
+constexpr int64_t kIconId = int64_t{1} << 23;
+
+constexpr int kIconSizeDip = 20;
+// How long a card that opened by itself stays after Kiba is idle again.
+constexpr base::TimeDelta kAutoHideDelay = base::Seconds(4);
+// What the daemon is asked to wait for; a missing daemon must not hang us.
+constexpr int kCallTimeoutMs = 5000;
+
+constexpr SkColor kCyan = SkColorSetRGB(0x6A, 0xD8, 0xFD);
+constexpr SkColor kBlue = SkColorSetRGB(0x3E, 0x64, 0xEB);
+constexpr SkColor kViolet = SkColorSetRGB(0x7E, 0x63, 0xFA);
+constexpr SkColor kPink = SkColorSetRGB(0xF2, 0x9E, 0xF5);
+constexpr SkColor kMutedGray = SkColorSetRGB(0x9A, 0x9F, 0xB5);
+
+// The tray icon, a small version of the orb: dimmed when muted or when Kiba
+// cannot listen, in the busy colors while it works.
+class OrbIconSource : public gfx::CanvasImageSource {
+ public:
+  OrbIconSource(bool dim, bool busy)
+      : gfx::CanvasImageSource(gfx::Size(kIconSizeDip, kIconSizeDip)),
+        dim_(dim),
+        busy_(busy) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    const gfx::PointF center(kIconSizeDip / 2.f, kIconSizeDip / 2.f);
+    const float radius = kIconSizeDip * 0.40f;
+    cc::PaintFlags body;
+    body.setAntiAlias(true);
+    if (dim_) {
+      body.setColor(kMutedGray);
+    } else {
+      body.setShader(gfx::CreateGradientShader(
+          gfx::Point(0, 2), gfx::Point(0, kIconSizeDip - 2),
+          busy_ ? kPink : kCyan, kBlue));
+    }
+    canvas->DrawCircle(center, radius, body);
+    cc::PaintFlags rim;
+    rim.setAntiAlias(true);
+    rim.setStyle(cc::PaintFlags::kStroke_Style);
+    rim.setStrokeWidth(1.5f);
+    rim.setColor(dim_ ? kMutedGray : kViolet);
+    canvas->DrawCircle(center, radius, rim);
+  }
+
+ private:
+  const bool dim_;
+  const bool busy_;
+};
+
+// Reads one {string: variant} entry of a GetAll answer.
+void ReadProperty(dbus::MessageReader* entry,
+                  std::string* state,
+                  std::string* status,
+                  bool* muted) {
+  std::string name;
+  dbus::MessageReader variant(nullptr);
+  if (!entry->PopString(&name) || !entry->PopVariant(&variant)) {
+    return;
+  }
+  if (name == "State") {
+    variant.PopString(state);
+  } else if (name == "Status") {
+    variant.PopString(status);
+  } else if (name == "Muted") {
+    variant.PopBool(muted);
+  }
+}
+
+}  // namespace
+
+KibaAssistant::KibaAssistant() = default;
+
+KibaAssistant::~KibaAssistant() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  hide_timer_.Stop();
+  bubble_.reset();
+  if (Shell::HasInstance()) {
+    present_ = false;
+    UpdateIcons();
+  }
+  proxy_ = nullptr;
+  if (bus_) {
+    bus_->ShutdownOnDBusThreadAndBlock();
+    bus_.reset();
+  }
+  if (dbus_thread_) {
+    dbus_thread_->Stop();
+  }
+}
+
+// static
+std::unique_ptr<KibaAssistant> KibaAssistant::Create() {
+  auto assistant = std::unique_ptr<KibaAssistant>(new KibaAssistant());
+  if (!assistant->Start()) {
+    return nullptr;
+  }
+  return assistant;
+}
+
+bool KibaAssistant::Start() {
+  if (!Shell::HasInstance()) {
+    return false;
+  }
+  dbus_thread_ = std::make_unique<base::Thread>("KibaOS assistant D-Bus thread");
+  base::Thread::Options thread_options;
+  thread_options.message_pump_type = base::MessagePumpType::IO;
+  if (!dbus_thread_->StartWithOptions(std::move(thread_options))) {
+    LOG(ERROR) << "KibaOS assistant could not start its D-Bus thread";
+    return false;
+  }
+
+  dbus::Bus::Options bus_options;
+  bus_options.bus_type = dbus::Bus::SESSION;
+  bus_options.connection_type = dbus::Bus::PRIVATE;
+  bus_options.dbus_task_runner = dbus_thread_->task_runner();
+  bus_ = new dbus::Bus(std::move(bus_options));
+
+  proxy_ = bus_->GetObjectProxyWithOptions(
+      kService, dbus::ObjectPath(kPath),
+      dbus::ObjectProxy::IGNORE_SERVICE_UNKNOWN_ERRORS);
+  proxy_->SetNameOwnerChangedCallback(base::BindRepeating(
+      &KibaAssistant::OnNameOwnerChanged, weak_ptr_factory_.GetWeakPtr()));
+
+  const auto connect = [this](const char* signal, auto handler) {
+    proxy_->ConnectToSignal(
+        kInterface, signal,
+        base::BindRepeating(handler, weak_ptr_factory_.GetWeakPtr()),
+        base::DoNothing());
+  };
+  connect("StateChanged", &KibaAssistant::OnStateChanged);
+  connect("WakeHeard", &KibaAssistant::OnWakeHeard);
+  connect("Level", &KibaAssistant::OnLevel);
+
+  shell_observation_.Observe(Shell::Get());
+  // The first question is also what makes the bus start the daemon.
+  RefreshProperties();
+  return true;
+}
+
+void KibaAssistant::OnNameOwnerChanged(const std::string& old_owner,
+                                       const std::string& new_owner) {
+  if (new_owner.empty()) {
+    SetPresent(false);
+  } else {
+    RefreshProperties();
+  }
+}
+
+void KibaAssistant::RefreshProperties() {
+  dbus::MethodCall method_call(kPropertiesInterface, "GetAll");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(kInterface);
+  proxy_->CallMethod(&method_call, kCallTimeoutMs,
+                     base::BindOnce(&KibaAssistant::OnProperties,
+                                    weak_ptr_factory_.GetWeakPtr()));
+}
+
+void KibaAssistant::OnProperties(dbus::Response* response) {
+  if (!response) {
+    // No daemon, or it is not answering: no icon.
+    SetPresent(false);
+    return;
+  }
+  dbus::MessageReader reader(response);
+  dbus::MessageReader array(nullptr);
+  if (!reader.PopArray(&array)) {
+    return;
+  }
+  std::string state = state_;
+  std::string status;
+  bool muted = muted_;
+  while (array.HasMoreData()) {
+    dbus::MessageReader entry(nullptr);
+    if (array.PopDictEntry(&entry)) {
+      ReadProperty(&entry, &state, &status, &muted);
+    }
+  }
+  state_ = std::move(state);
+  status_ = base::UTF8ToUTF16(status);
+  muted_ = muted;
+  SetPresent(true);
+  UpdateIcons();
+  if (bubble_) {
+    bubble_->SetState(BubbleState());
+  }
+}
+
+void KibaAssistant::OnStateChanged(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  std::string state;
+  std::string status;
+  if (!reader.PopString(&state) || !reader.PopString(&status)) {
+    return;
+  }
+  state_ = std::move(state);
+  status_ = base::UTF8ToUTF16(status);
+  // The mute switch is a property; a state change is also when it is read.
+  RefreshProperties();
+  UpdateIcons();
+  if (bubble_) {
+    bubble_->SetState(BubbleState());
+    // A card that opened by itself goes a moment after the answer; a clicked
+    // one stays until it is dismissed.
+    if (state_ == "idle" && !bubble_->pinned()) {
+      hide_timer_.Start(FROM_HERE, kAutoHideDelay,
+                        base::BindOnce(&KibaAssistant::HideTimerFired,
+                                       base::Unretained(this)));
+    } else {
+      hide_timer_.Stop();
+    }
+  }
+}
+
+void KibaAssistant::OnWakeHeard(dbus::Signal* signal) {
+  if (bubble_ || !present_) {
+    return;
+  }
+  // No click to anchor to: the bottom right of the primary display, where
+  // the status area is.
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetPrimaryDisplay().work_area();
+  OpenBubble(gfx::Point(work_area.right() - 8, work_area.bottom() - 8),
+             /*pinned=*/false);
+}
+
+void KibaAssistant::OnLevel(dbus::Signal* signal) {
+  if (!bubble_) {
+    return;
+  }
+  dbus::MessageReader reader(signal);
+  double rms = 0;
+  double low = 0;
+  double mid = 0;
+  double high = 0;
+  if (reader.PopDouble(&rms) && reader.PopDouble(&low) &&
+      reader.PopDouble(&mid) && reader.PopDouble(&high)) {
+    bubble_->SetLevel(rms, low, mid, high);
+  }
+}
+
+void KibaAssistant::Call(const char* method) {
+  dbus::MethodCall method_call(kInterface, method);
+  proxy_->CallMethod(&method_call, kCallTimeoutMs, base::DoNothing());
+}
+
+void KibaAssistant::CallBool(const char* method, bool value) {
+  dbus::MethodCall method_call(kInterface, method);
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendBool(value);
+  proxy_->CallMethod(&method_call, kCallTimeoutMs, base::DoNothing());
+}
+
+void KibaAssistant::SetPresent(bool present) {
+  if (present_ == present) {
+    return;
+  }
+  present_ = present;
+  if (!present_) {
+    hide_timer_.Stop();
+    bubble_.reset();
+    level_stream_ = false;
+  }
+  UpdateIcons();
+}
+
+KibaBubbleState KibaAssistant::BubbleState() const {
+  KibaBubbleState state;
+  state.state = state_;
+  state.status = status_;
+  state.muted = muted_;
+  return state;
+}
+
+void KibaAssistant::UpdateIcons() {
+  if (!Shell::HasInstance()) {
+    return;
+  }
+  TrayIconConfiguration configuration;
+  configuration.id = kIconId;
+  if (present_) {
+    const bool dim = muted_ || state_ == "unavailable";
+    const bool busy = state_ != "idle" && state_ != "unavailable";
+    configuration.image = gfx::CanvasImageSource::MakeImageSkia<OrbIconSource>(
+        dim, busy);
+    configuration.tool_tip =
+        u"Kiba: " + (status_.empty() ? std::u16string(u"ready") : status_);
+  }
+  // Each monitor's status area is asked rather than remembered: a monitor
+  // plugged in again comes back with the same display ID and an empty one.
+  for (aura::Window* root_window : Shell::GetAllRootWindows()) {
+    const int64_t display_id =
+        display::Screen::Get()->GetDisplayNearestWindow(root_window).id();
+    if (!present_) {
+      Shell::Get()->RemoveStatusTrayIcon(configuration, display_id);
+    } else if (!Shell::Get()->UpdateStatusTrayIcon(configuration,
+                                                   display_id)) {
+      TrayIconHandlers handlers;
+      handlers.activate = base::BindRepeating(
+          &KibaAssistant::OnIconActivated, weak_ptr_factory_.GetWeakPtr());
+      Shell::Get()->AddStatusTrayIcon(configuration, display_id,
+                                      std::move(handlers));
+    }
+  }
+}
+
+void KibaAssistant::OnRootWindowAdded(aura::Window* root_window) {
+  UpdateIcons();
+}
+
+void KibaAssistant::OnIconActivated(const gfx::Point& screen_point) {
+  if (bubble_ && bubble_->pinned()) {
+    bubble_.reset();   // the second click closes it
+    hide_timer_.Stop();
+    if (level_stream_) {
+      level_stream_ = false;
+      CallBool("SetLevelStream", false);
+    }
+    return;
+  }
+  bubble_.reset();
+  OpenBubble(screen_point, /*pinned=*/true);
+}
+
+void KibaAssistant::OpenBubble(const gfx::Point& anchor, bool pinned) {
+  KibaBubble::Callbacks callbacks;
+  callbacks.orb_pressed = base::BindRepeating(&KibaAssistant::OnOrbPressed,
+                                              weak_ptr_factory_.GetWeakPtr());
+  callbacks.set_muted = base::BindRepeating(
+      [](base::WeakPtr<KibaAssistant> self, bool muted) {
+        if (self) {
+          self->CallBool("SetMuted", muted);
+        }
+      },
+      weak_ptr_factory_.GetWeakPtr());
+  const int generation = ++bubble_generation_;
+  callbacks.closed = base::BindOnce(&KibaAssistant::OnBubbleClosed,
+                                    weak_ptr_factory_.GetWeakPtr(), generation);
+  bubble_ = KibaBubble::Create(BubbleState(), anchor, pinned,
+                               std::move(callbacks));
+  if (!bubble_) {
+    return;
+  }
+  // The wave is only streamed while somebody can see it.
+  level_stream_ = true;
+  CallBool("SetLevelStream", true);
+}
+
+void KibaAssistant::OnOrbPressed() {
+  if (state_ == "speaking") {
+    Call("Stop");
+  } else if (state_ == "idle") {
+    Call("Talk");
+  }
+}
+
+void KibaAssistant::OnBubbleClosed(int generation) {
+  if (generation != bubble_generation_) {
+    return;   // an older card, already replaced
+  }
+  bubble_.reset();
+  hide_timer_.Stop();
+  if (level_stream_ && present_) {
+    CallBool("SetLevelStream", false);
+  }
+  level_stream_ = false;
+}
+
+void KibaAssistant::HideTimerFired() {
+  if (bubble_ && !bubble_->pinned() && state_ == "idle") {
+    bubble_.reset();
+    if (level_stream_) {
+      level_stream_ = false;
+      CallBool("SetLevelStream", false);
+    }
+  }
+}
+
+}  // namespace ash
