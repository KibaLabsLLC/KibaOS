+
+namespace ash {
+
+namespace {
+
+// Colors sampled from the Kiba mascot. The card is always light.
+constexpr SkColor kCyan = SkColorSetRGB(0x6A, 0xD8, 0xFD);
+constexpr SkColor kBlue = SkColorSetRGB(0x3E, 0x64, 0xEB);
+constexpr SkColor kViolet = SkColorSetRGB(0x7E, 0x63, 0xFA);
+constexpr SkColor kPink = SkColorSetRGB(0xF2, 0x9E, 0xF5);
+constexpr SkColor kNavy = SkColorSetRGB(0x14, 0x1E, 0x4F);
+constexpr SkColor kMist = SkColorSetRGB(0xF4, 0xF5, 0xFE);
+constexpr SkColor kMuted = SkColorSetRGB(0x7B, 0x82, 0xB8);
+constexpr SkColor kError = SkColorSetRGB(0xD6, 0x56, 0x8F);
+
+constexpr int kCardWidth = 280;
+constexpr int kOrbSize = 132;
+constexpr int kWaveHeight = 56;
+
+// The orb, drawn rather than shipped: a gradient disc with a rim that glows
+// while Kiba is busy and swells with the voice.
+class OrbView : public views::View {
+  METADATA_HEADER(OrbView, views::View)
+
+ public:
+  explicit OrbView(base::RepeatingClosure pressed)
+      : pressed_(std::move(pressed)) {}
+
+  void SetActive(bool active) {
+    active_ = active;
+    SchedulePaint();
+  }
+  void SetLevel(double rms) {
+    level_ = std::clamp(rms, 0.0, 1.0);
+    SchedulePaint();
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kCardWidth, kOrbSize);
+  }
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    return event.IsOnlyLeftMouseButton();
+  }
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (event.IsLeftMouseButton() && HitTestPoint(event.location())) {
+      pressed_.Run();
+    }
+  }
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::PointF center(width() / 2.f, height() / 2.f);
+    const float base_radius = kOrbSize * 0.36f;
+    const float radius = base_radius * (1.f + 0.12f * level_);
+
+    if (active_) {
+      cc::PaintFlags glow;
+      glow.setAntiAlias(true);
+      glow.setColor(SkColorSetA(kViolet, 0x38));
+      canvas->DrawCircle(center, radius + 12.f, glow);
+    }
+    cc::PaintFlags body;
+    body.setAntiAlias(true);
+    body.setShader(gfx::CreateGradientShader(
+        gfx::Point(0, static_cast<int>(center.y() - radius)),
+        gfx::Point(0, static_cast<int>(center.y() + radius)),
+        active_ ? kPink : kCyan, kBlue));
+    canvas->DrawCircle(center, radius, body);
+
+    cc::PaintFlags rim;
+    rim.setAntiAlias(true);
+    rim.setStyle(cc::PaintFlags::kStroke_Style);
+    rim.setStrokeWidth(3.f);
+    rim.setColor(kViolet);
+    canvas->DrawCircle(center, radius, rim);
+
+    // A small highlight, so the disc reads as a bubble.
+    cc::PaintFlags shine;
+    shine.setAntiAlias(true);
+    shine.setColor(SkColorSetA(SK_ColorWHITE, 0x99));
+    canvas->DrawCircle(gfx::PointF(center.x() - radius * 0.38f,
+                                   center.y() - radius * 0.42f),
+                       radius * 0.16f, shine);
+  }
+
+ private:
+  base::RepeatingClosure pressed_;
+  bool active_ = false;
+  double level_ = 0;
+};
+
+BEGIN_METADATA(OrbView)
+END_METADATA
+
+// A gradient wave along the bottom that follows the microphone.
+class WaveView : public views::View {
+  METADATA_HEADER(WaveView, views::View)
+
+ public:
+  void SetLevel(double rms, double low, double mid, double high) {
+    rms_ = std::clamp(rms, 0.0, 1.0);
+    low_ = low;
+    mid_ = mid;
+    high_ = high;
+    SchedulePaint();
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kCardWidth, kWaveHeight);
+  }
+  void OnPaint(gfx::Canvas* canvas) override {
+    // Three bands of bars, one per spectral weight, drawn from the middle.
+    const int bars = 28;
+    const float step = static_cast<float>(width()) / bars;
+    const float mid_y = height() / 2.f;
+    for (int i = 0; i < bars; ++i) {
+      const float t = static_cast<float>(i) / (bars - 1);
+      const double weight = t < 0.34f ? low_ : t < 0.67f ? mid_ : high_;
+      // A bump in the middle of the card, so quiet looks like a calm line.
+      const float envelope = 1.f - std::abs(t - 0.5f) * 1.2f;
+      const float h = 2.f + (height() / 2.f - 4.f) *
+                                static_cast<float>(rms_ * weight * 3.0) *
+                                envelope;
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(t < 0.5f ? kCyan : kPink);
+      const float x = i * step + step * 0.2f;
+      canvas->DrawRoundRect(
+          gfx::RectF(x, mid_y - std::min(h, mid_y), step * 0.6f,
+                     2 * std::min(h, mid_y)),
+          step * 0.3f, flags);
+    }
+  }
+
+ private:
+  double rms_ = 0, low_ = 0.34, mid_ = 0.33, high_ = 0.33;
+};
+
+BEGIN_METADATA(WaveView)
+END_METADATA
+
+}  // namespace
+
+// The card's contents.
+class KibaBubbleContents : public views::View {
+  METADATA_HEADER(KibaBubbleContents, views::View)
+
+ public:
+  explicit KibaBubbleContents(KibaBubble::Callbacks* callbacks)
+      : callbacks_(callbacks) {
+    SetBackground(views::CreateSolidBackground(SK_ColorWHITE));
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(8, 0), 4));
+    orb_ = AddChildView(std::make_unique<OrbView>(
+        base::BindRepeating(&KibaBubbleContents::OnOrbPressed, base::Unretained(this))));
+    status_ = AddChildView(std::make_unique<views::Label>());
+    status_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    status_->SetFontList(
+        gfx::FontList().DeriveWithSizeDelta(1).DeriveWithWeight(
+            gfx::Font::Weight::MEDIUM));
+    wave_ = AddChildView(std::make_unique<WaveView>());
+    mute_ = AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating(&KibaBubbleContents::OnMutePressed, base::Unretained(this)),
+        std::u16string()));
+    mute_->SetEnabledTextColors(kNavy);
+  }
+
+  void SetState(const KibaBubbleState& state) {
+    muted_ = state.muted;
+    const bool error = state.state == "unavailable";
+    status_->SetText(state.status);
+    status_->SetEnabledColor(error ? kError : kMuted);
+    orb_->SetActive(state.state != "idle" && state.state != "unavailable");
+    mute_->SetText(muted_ ? u"Unmute Kiba" : u"Mute Kiba");
+    if (state.state != "listening") {
+      wave_->SetLevel(0, 0.34, 0.33, 0.33);
+      orb_->SetLevel(0);
+    }
+    state_ = state.state;
+  }
+  void SetLevel(double rms, double low, double mid, double high) {
+    if (state_ != "listening") {
+      return;
+    }
+    wave_->SetLevel(rms, low, mid, high);
+    orb_->SetLevel(rms);
+  }
+
+ private:
+  void OnOrbPressed() { callbacks_->orb_pressed.Run(); }
+  void OnMutePressed() { callbacks_->set_muted.Run(!muted_); }
+
+  raw_ptr<KibaBubble::Callbacks> callbacks_;
+  raw_ptr<OrbView> orb_ = nullptr;
+  raw_ptr<views::Label> status_ = nullptr;
+  raw_ptr<WaveView> wave_ = nullptr;
+  raw_ptr<views::LabelButton> mute_ = nullptr;
+  bool muted_ = false;
+  std::string state_;
+};
+
+BEGIN_METADATA(KibaBubbleContents)
+END_METADATA
+
+namespace {
+
+// Keeps the callbacks the card's views call alive as long as the card is,
+// and tells the owner when the card is gone, whoever closed it.
+class Delegate : public views::BubbleDialogDelegate {
+ public:
+  Delegate(const gfx::Rect& anchor, KibaBubble::Callbacks callbacks)
+      : views::BubbleDialogDelegate(static_cast<views::View*>(nullptr),
+                                    views::BubbleBorder::BOTTOM_RIGHT,
+                                    views::BubbleBorder::STANDARD_SHADOW),
+        callbacks_(std::move(callbacks)) {
+    SetAnchorRect(anchor);
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    set_margins(gfx::Insets());
+    set_corner_radius(24);
+    SetShowCloseButton(false);
+  }
+  ~Delegate() override {
+    if (callbacks_.closed) {
+      std::move(callbacks_.closed).Run();
+    }
+  }
+  KibaBubble::Callbacks* callbacks() { return &callbacks_; }
+
+ private:
+  KibaBubble::Callbacks callbacks_;
+};
+
+}  // namespace
+
+KibaBubble::KibaBubble() = default;
+
+KibaBubble::~KibaBubble() {
+  Close();
+}
+
+// static
+std::unique_ptr<KibaBubble> KibaBubble::Create(const KibaBubbleState& state,
+                                               const gfx::Point& anchor,
+                                               bool pinned,
+                                               Callbacks callbacks) {
+  if (!Shell::HasInstance()) {
+    return nullptr;
+  }
+  const display::Display display =
+      display::Screen::Get()->GetDisplayNearestPoint(anchor);
+  aura::Window* root = Shell::GetRootWindowForDisplayId(display.id());
+  if (!root) {
+    return nullptr;
+  }
+  auto bubble = base::WrapUnique(new KibaBubble());
+  bubble->pinned_ = pinned;
+
+  gfx::Rect anchor_rect(anchor, gfx::Size(1, 1));
+  auto delegate = std::make_unique<Delegate>(anchor_rect, std::move(callbacks));
+  delegate->set_parent_window(
+      Shell::GetContainer(root, kShellWindowId_SettingBubbleContainer));
+  delegate->set_close_on_deactivate(pinned);
+  delegate->SetCanActivate(pinned);
+  auto contents = std::make_unique<KibaBubbleContents>(delegate->callbacks());
+  contents->SetState(state);
+  bubble->contents_ = delegate->SetContentsView(std::move(contents));
+
+  // The widget owns the delegate and goes away on its own when the bubble
+  // is dismissed; `widget_` follows it without owning it.
+  views::Widget* widget = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(delegate), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  bubble->widget_ = widget->GetWeakPtr();
+  if (pinned) {
+    widget->Show();
+  } else {
+    widget->ShowInactive();
+  }
+  return bubble;
+}
+
+void KibaBubble::SetState(const KibaBubbleState& state) {
+  if (contents_ && widget_) {
+    contents_->SetState(state);
+  }
+}
+
+void KibaBubble::SetLevel(double rms, double low, double mid, double high) {
+  if (contents_ && widget_) {
+    contents_->SetLevel(rms, low, mid, high);
+  }
+}
+
+void KibaBubble::Close() {
+  if (widget_) {
+    contents_ = nullptr;
+    widget_->Close();
+  }
+}
+
+}  // namespace ash
