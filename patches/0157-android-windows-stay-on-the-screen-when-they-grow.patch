     const gfx::Rect& new_bounds,
     ui::PropertyChangeReason reason) {
   compat_mode_button_controller_->Update(window);
+
+  // KibaOS: an Android window that grew past the work area while keeping the
+  // origin it opened with is moved back onto the screen.
+  if (window->IsVisible() && !new_bounds.IsEmpty()) {
+    const display::Display display =
+        display::Screen::Get()->GetDisplayNearestWindow(window);
+    const gfx::Rect work_area = display.work_area();
+    gfx::Rect bounds = window->GetBoundsInScreen();
+    if (bounds.width() <= work_area.width() &&
+        bounds.height() <= work_area.height() &&
+        !work_area.Contains(bounds)) {
+      bounds.AdjustToFit(work_area);
+      window->SetBoundsInScreen(bounds, display);
+    }
+  }
 }
 
