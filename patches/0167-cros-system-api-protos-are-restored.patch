+  }
+
+  // Status of the entire operation. Individual results should be checked even
+  // if status is OK.
+  Status status = 1;
+
+  // Human readable failure reason.
+  string failure_reason = 2;
+
+  // Results of actions per VmDevice.
+  // The keys are really VmDevice, but proto doesn't allow enum keys.
+  map<string, UpdateResult> results = 3;
+}
diff --git a/third_party/cros_system_api/dbus/vm_concierge/concierge_service.proto b/third_party/cros_system_api/dbus/vm_concierge/concierge_service.proto
new file mode 100644
--- /dev/null
+++ b/third_party/cros_system_api/dbus/vm_concierge/concierge_service.proto
@@ -0,0 +1,1637 @@
