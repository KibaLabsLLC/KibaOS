diff --git a/chromeos/ash/components/disks/disk_mount_manager.cc b/chromeos/ash/components/disks/disk_mount_manager.cc
index 6faa9a2e00..b86b624660 100644
--- a/chromeos/ash/components/disks/disk_mount_manager.cc
+++ b/chromeos/ash/components/disks/disk_mount_manager.cc
@@ -1050,6 +1050,13 @@ class DiskMountManagerImpl : public DiskMountManager,
   void RefreshAfterEnumerateMountEntries(
       const std::vector<MountPoint>& entries) {
     for (const MountPoint& entry : entries) {
+      // A system disk (the root, /boot, the Android images) mounts and
+      // unmounts on its own; Files must not take it for a drive just plugged
+      // in. cros-disks never reported these, so Files has no filter for them.
+      const Disks::const_iterator disk_it = disks_.find(entry.source_path);
+      if (disk_it != disks_.end() && (*disk_it)->is_hidden()) {
+        continue;
+      }
       OnMountCompleted(entry);
     }
     RefreshCompleted(true);
