+/**
+ * Every visual state worth pinning, rendered in isolation.
+ *
+ * A golden per story is what stops a hairline moving by a pixel and nobody
+ * noticing until it is on the hardware. Each one is deterministic: a fixed
+ * clock, fixed sizes, no randomness, no network.
+ */
+import type {EntryDto, Metadata, Volume} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import type {EmptyReason} from '../../ui/copy.js';
+import {FileList} from '../../ui/file_list.js';
+import {createRow, updateRow} from '../../ui/file_row.js';
+import {MockBackend} from '../../port/mock_backend.js';
+import {Sidebar} from '../../ui/sidebar.js';
+import {FilesShell} from '../../ui/shell.js';
+import type {Place} from '../../ui/sidebar.js';
+import {placesFor} from '../../ui/places.js';
+
+export interface Story {
+  readonly name: string;
+  readonly width: number;
+  readonly height: number;
+  readonly theme?: 'light'|'dark';
+  readonly density?: 'compact'|'relaxed';
+  /** May be async: a story driven through the port has to load first. */
+  render(root: HTMLElement): void|Promise<void>;
+}
+
+const NOW = new Date('2026-09-02T15:30:00').getTime();
+const ROOT = asFileKey('mock://myfiles');
+
+function entry(name: string, isDirectory = false): EntryDto {
+  return {key: asFileKey(`${ROOT}/${name}`), name, isDirectory, parent: ROOT};
+}
+
+interface Row {
+  entry: EntryDto;
+  metadata?: Metadata;
+  selected?: boolean;
+  cut?: boolean;
+  share?: number;
+}
+
+function panel(root: HTMLElement, rows: Row[]): void {
+  const panelEl = document.createElement('div');
+  panelEl.className = 'kibaos-panel';
+  panelEl.setAttribute('role', 'listbox');
+  for (const row of rows) {
+    const element = createRow();
+    updateRow(element, {
+      entry: row.entry,
+      metadata: row.metadata,
+      selected: row.selected ?? false,
+      cut: row.cut ?? false,
+      share: row.share,
+      now: NOW,
+    });
+    panelEl.appendChild(element);
+  }
+  root.appendChild(panelEl);
+}
+
+const SAMPLE: Row[] = [
+  {
+    entry: entry('Downloads', true),
+    metadata: {modificationTime: NOW - 43 * 60_000},
+  },
+  {
+    entry: entry('holiday-in-porto.jpeg'),
+    metadata: {size: 4_713_211, modificationTime: NOW - 3 * 3_600_000},
+    share: 0.62,
+  },
+  {
+    entry: entry('linux-6.18.2-1-x86_64.pkg.tar.zst'),
+    metadata: {size: 1_884_160, modificationTime: NOW - 86_400_000},
+    share: 0.25,
+  },
+  {
+    entry: entry('navigation_session.ts'),
+    metadata: {size: 7_168, modificationTime: NOW - 26 * 86_400_000},
+    share: 0.01,
+  },
+  {
+    entry: entry('quarterly-report.pdf'),
+    metadata: {
+      size: 512_000,
+      modificationTime: new Date('2025-05-12T09:04:00').getTime(),
+    },
+    share: 0.07,
+  },
+];
+
+/** A list in a panel of a fixed height, so a golden is comparable run to run. */
+function listPanel(
+    root: HTMLElement, rows: Row[], height: number,
+    setup?: (list: FileList) => void): FileList {
+  const panelEl = document.createElement('div');
+  panelEl.className = 'kibaos-panel';
+  panelEl.style.height = `${height}px`;
+  root.appendChild(panelEl);
+  const list = new FileList(panelEl, {rowHeight: 40});
+  setup?.(list);
+  list.setEntries(rows.map(row => row.entry), NOW);
+  const metadata = new Map(
+      rows.filter(row => row.metadata).map(row => [row.entry.key, row.metadata!]));
+  list.setMetadata(metadata);
+  return list;
+}
+
+const MANY: Row[] = Array.from({length: 14}, (_, i) => ({
+  entry: entry(
+      i % 5 === 0 ? `project-${i}` : `document-${i}.pdf`, i % 5 === 0),
+  metadata: {
+    size: (i + 1) * 180_000,
+    modificationTime: NOW - i * 7 * 3_600_000,
+  },
+}));
+
+function emptyStory(name: string, reason: EmptyReason, subject?: string): Story {
+  return {
+    name,
+    width: 720,
+    height: 300,
+    theme: 'dark',
+    render: root => {
+      listPanel(root, [], 280, list => {
+        list.setEmptyReason(reason, subject);
+      });
+    },
+  };
+}
+
+
+/**
+ * One sidebar, holding the states that are easy to get wrong: a drive with
+ * room, a drive with none, and a count. The near full stick is here on purpose,
+ * because the colour it turns is the kind of thing that survives a refactor
+ * looking fine and is only wrong when you put the two bars side by side.
+ */
+const PLACES: Place[] = (() => {
+  const gib = 1024 * 1024 * 1024;
+  const internal: Volume = {
+    id: 'internal',
+    root: asFileKey('mock://internal'),
+    label: 'Home',
+    kind: 'system' as const,
+    removable: false,
+    readOnly: false,
+    capacity: {total: 32 * gib, free: 8 * gib},
+  };
+  const stick: Volume = {
+    id: 'stick',
+    root: asFileKey('mock://stick'),
+    label: 'CRUZER',
+    kind: 'removable' as const,
+    removable: true,
+    readOnly: false,
+    capacity: {total: 16 * gib, free: 128 * 1024 * 1024},
+  };
+  return [
+    {key: asFileKey('fake://recent'), label: 'Recent', kind: 'recent'},
+    {key: asFileKey('fake://starred'), label: 'Starred', kind: 'starred'},
+    {key: asFileKey('fake://trash'), label: 'Trash', kind: 'trash'},
+    // Through placesFor rather than written out, so the golden shows the
+    // meters the app would actually draw rather than the ones a fixture felt
+    // like asking for. Two different disks here, so two bars.
+    ...placesFor([internal, stick]),
+    {key: asFileKey('fake://basket'), label: 'Basket', kind: 'basket', badge: 3},
+  ];
+})();
+
+/**
+ * One place per purpose, which is the whole point of having purposes.
+ *
+ * Every one of these is the same kind of storage, a local disk, so before the
+ * purpose existed this was seven identical laptop glyphs in a column. Left as
+ * its own story rather than folded into the ones above, because those are
+ * about grouping and capacity and are worth keeping still.
+ */
+const PURPOSED: Place[] = placesFor(
+    (['home', 'desktop', 'documents', 'downloads', 'music', 'pictures',
+      'videos'] as const)
+        .map(purpose => ({
+               id: purpose,
+               root: asFileKey(`mock://${purpose}`),
+               label: purpose[0]!.toUpperCase() + purpose.slice(1),
+               kind: 'system' as const,
+               removable: false,
+               readOnly: false,
+               capacity: null,
+               purpose,
+             })));
+
+function purposes(root: HTMLElement): void {
+  const host = document.createElement('div');
+  host.className = 'kibaos-panel';
+  root.appendChild(host);
+  new Sidebar(host).setPlaces(PURPOSED);
+}
+
+function sidebar(root: HTMLElement, selected?: string): void {
+  const host = document.createElement('div');
+  host.className = 'kibaos-panel';
+  root.appendChild(host);
+  const widget = new Sidebar(host);
+  widget.setPlaces(PLACES);
+  if (selected) {
+    widget.setSelected(asFileKey(selected));
+  }
+}
+
+
+/**
+ * The whole window, driven through the port exactly as the app will drive it.
+ *
+ * This is the story that would catch the two halves drifting apart. Everything
+ * else renders a component against a literal; this one renders whatever the
+ * backend actually says, which is the only version that can be wrong.
+ */
+interface ShellStory {
+  /** Folder names to open in turn, so the trail has more than one crumb. */
+  readonly into?: readonly string[];
+  /** Chevron level to leave open, for pinning the popover. */
+  readonly popover?: number;
+}
+
+async function shell(root: HTMLElement, story: ShellStory = {}): Promise<void> {
+  const backend = new MockBackend();
+  backend.addVolume({
+    id: 'recent', root: asFileKey('mock://recent'), label: 'Recent',
+    kind: 'recent', removable: false, readOnly: false, capacity: null,
+  });
+  backend.addVolume({
+    id: 'system', root: ROOT, label: 'Home', kind: 'system',
+    removable: false, readOnly: false,
+    capacity: {total: 32 * 1024 ** 3, free: 8 * 1024 ** 3},
+  });
+  backend.addVolume({
+    id: 'usb', root: asFileKey('mock://usb'), label: 'CRUZER',
+    kind: 'removable', removable: true, readOnly: false,
+    capacity: {total: 16 * 1024 ** 3, free: 128 * 1024 ** 2},
+  });
+  backend.addVolume({
+    id: 'gdrive', root: asFileKey('mock://gdrive'), label: 'Google Drive',
+    kind: 'drive', removable: false, readOnly: false, capacity: null,
+  });
+  const documents = backend.add(ROOT, 'Documents', true);
+  backend.add(ROOT, 'Photos', true);
+  backend.add(ROOT, 'Music', true);
+  backend.add(documents, 'Work', true);
+  backend.add(documents, 'Play', true);
+  for (const [name, size] of [
+           ['budget-2026.ods', 48_120], ['keynote.pdf', 2_430_000],
+           ['kibaos-0.2.0.pkg.tar.zst', 91_800_000],
+           ['session.log', 12_400], ['wallpaper.png', 5_120_000]] as
+       Array<[string, number]>) {
+    backend.add(ROOT, name, false, {size, modificationTime: NOW - 86_400_000});
+  }
+
+  const host = document.createElement('div');
+  host.style.height = '523px';
+  root.appendChild(host);
+  const widget = new FilesShell(host, backend, {rowHeight: 40});
+  await widget.start();
+  const settle = async () => {
+    // Metadata is fetched against the window after the rows exist, so a story
+    // is not finished until that second round trip has landed.
+    for (let i = 0; i < 5; i++) {
+      await new Promise(resolve => setTimeout(resolve, 0));
+    }
+  };
+  await settle();
+  for (const name of story.into ?? []) {
+    const row = [...host.querySelectorAll<HTMLElement>('.kibaos-row')].find(
+        candidate =>
+            candidate.querySelector('.kibaos-name')?.textContent === name);
+    row?.dispatchEvent(new MouseEvent('dblclick', {bubbles: true}));
+    await settle();
+  }
+  if (story.popover !== undefined) {
+    host.querySelector<HTMLElement>(
+            `.kibaos-chevron[data-chevron="${story.popover}"]`)
+        ?.click();
+    await settle();
+  }
+}
+
+export const STORIES: Story[] = [
+  {
+    name: 'shell-light',
+    width: 900,
+    height: 539,
+    theme: 'light',
+    render: root => shell(root),
+  },
+  {
+    name: 'shell-dark',
+    width: 900,
+    height: 539,
+    theme: 'dark',
+    render: root => shell(root),
+  },
+  {
+    name: 'shell-deep',
+    width: 900,
+    height: 539,
+    theme: 'dark',
+    render: root => shell(root, {into: ['Documents']}),
+  },
+  {
+    name: 'shell-sibling-popover',
+    width: 900,
+    height: 539,
+    theme: 'dark',
+    render: root => shell(root, {into: ['Documents'], popover: 0}),
+  },
+  {
+    name: 'sidebar-light',
+    width: 268,
+    height: 430,
+    theme: 'light',
+    render: root => sidebar(root),
+  },
+  {
+    name: 'sidebar-dark',
+    width: 268,
+    height: 430,
+    theme: 'dark',
+    render: root => sidebar(root),
+  },
+  {
+    name: 'sidebar-current',
+    width: 268,
+    height: 430,
+    theme: 'dark',
+    render: root => sidebar(root, 'mock://internal'),
+  },
+  {
+    name: 'sidebar-purposes',
+    width: 268,
+    height: 340,
+    theme: 'dark',
+    render: root => purposes(root),
+  },
+  {
+    name: 'rows-light',
+    width: 720,
+    height: 260,
+    theme: 'light',
+    render: root => panel(root, SAMPLE),
+  },
+  {
+    name: 'rows-dark',
+    width: 720,
+    height: 260,
+    theme: 'dark',
+    render: root => panel(root, SAMPLE),
+  },
+  {
+    name: 'row-selected',
+    width: 720,
+    height: 120,
+    theme: 'dark',
+    render: root => panel(root, [
+      {...SAMPLE[0]!, selected: true},
+      SAMPLE[1]!,
+    ]),
+  },
+  {
+    name: 'row-cut',
+    width: 720,
+    height: 120,
+    theme: 'dark',
+    render: root => panel(root, [
+      {...SAMPLE[1]!, cut: true},
+      SAMPLE[2]!,
+    ]),
+  },
+  {
+    name: 'row-long-name',
+    width: 420,
+    height: 120,
+    theme: 'dark',
+    render: root => panel(root, [
+      {
+        entry: entry(
+            'a-name-that-keeps-going-well-past-what-the-column-can-hold.txt'),
+        metadata: {size: 1024, modificationTime: NOW},
+      },
+      SAMPLE[3]!,
+    ]),
+  },
+  {
+    name: 'rows-compact',
+    width: 720,
+    height: 220,
+    theme: 'dark',
+    density: 'compact',
+    render: root => panel(root, SAMPLE),
+  },
+  {
+    name: 'rows-relaxed',
+    width: 720,
+    height: 320,
+    theme: 'dark',
+    density: 'relaxed',
+    render: root => panel(root, SAMPLE),
+  },
+  {
+    name: 'list-populated',
+    width: 760,
+    height: 420,
+    theme: 'dark',
+    render: root => {
+      listPanel(root, MANY, 400);
+    },
+  },
+  {
+    name: 'list-selection-range',
+    width: 760,
+    height: 420,
+    theme: 'dark',
+    render: root => {
+      const list = listPanel(root, MANY, 400);
+      list.setSelectedIndices([3, 4, 5, 6, 7]);
+    },
+  },
+  emptyStory('list-empty', 'empty'),
+  emptyStory('list-empty-search', 'search', 'quarterly report'),
+  emptyStory('list-empty-offline', 'offline', 'Samsung Flash Drive'),
+  emptyStory('list-empty-unreadable', 'unreadable'),
+];
