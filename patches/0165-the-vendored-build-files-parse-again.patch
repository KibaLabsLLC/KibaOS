@@ -0,0 +1,86 @@
+/** Runs the shared contract against the in memory backend. */
+import {MockBackend} from '../../port/mock_backend.js';
+import type {FileKey} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import {runSessionTests} from '../session/session_test.js';
+import {runFormatTests} from '../ui/format_test.js';
+import {runHistoryTests} from '../ui/history_test.js';
+import {runPlacesTests} from '../ui/places_test.js';
+import {runVoiceTests} from '../ui/voice_test.js';
+import type {Fixture} from './port_contract.js';
+import {runContract} from './port_contract.js';
+import {currentCheck} from '../progress.js';
+import {runAdapterTests} from '../adapter/adapter_test.js';
+import {runAdapterContract} from '../adapter/run_adapter.js';
+
+const ROOT = asFileKey('mock://myfiles');
+
+function makeFixture(): Fixture {
+  const backend = new MockBackend();
+  backend.addVolume({
+    id: 'system',
+    root: ROOT,
+    label: 'My files',
+    kind: 'system',
+    removable: false,
+    readOnly: false,
+    capacity: {total: 512e9, free: 8.7e9},
+  });
+  backend.addVolume({
+    id: 'usb',
+    root: asFileKey('mock://usb'),
+    label: 'Samsung Flash Drive',
+    kind: 'removable',
+    removable: true,
+    readOnly: false,
+    capacity: {total: 128e9, free: 96e9},
+  });
+  return {
+    port: backend,
+    root: ROOT,
+    add: (parent: FileKey, name: string, isDirectory: boolean) =>
+        backend.add(parent, name, isDirectory, {size: 1024}),
+    remove: (key: FileKey) => backend.remove(key),
+    failWith: (key: FileKey, error: FilesError) =>
+        backend.setFailure(key, error),
+  };
+}
+
+// Declared rather than pulled in from @types/node, which is not on this
+// tree's path and would be a dependency for one property.
+declare const process: {exitCode: number, exit(code: number): never};
+
+async function main(): Promise<void> {
+  // Set before anything runs, cleared only once everything has finished.
+  //
+  // Node exits silently with code 0 when nothing is left on the event loop,
+  // including when that is because a promise will never settle. So a suite
+  // that hangs half way through prints nothing further and reports success,
+  // and three mutations escaped exactly that way: they made a test wait
+  // forever for an event that had been dropped, and the runner called it a
+  // pass. A hang is a failure.
+  process.exitCode = 1;
+  const watchdog = setTimeout(() => {
+    // Naming it matters twice over: a person can go straight to the test, and
+    // the mutation gate can tell that the hang is the escape it was looking
+    // for rather than an unrelated stall.
+    console.log(`a suite hung and never finished, in: ${currentCheck()}`);
+    process.exit(1);
+  }, 120_000);
+  const contract = await runContract('MockBackend', makeFixture);
+  const adapter = await runAdapterContract();
+  const adapterUnits = await runAdapterTests();
+  const sessions = await runSessionTests();
+  const formats = runFormatTests();
+  const voice = runVoiceTests();
+  const places = runPlacesTests();
+  const history = runHistoryTests();
+  clearTimeout(watchdog);
+  process.exitCode =
+      contract.every(r => r.ok) && adapter.every(r => r.ok) &&
+          adapterUnits &&
+          sessions && formats && voice &&
+          places && history ? 0 : 1;
+}
+
+void main();
diff --git a/ui/file_manager/file_manager/kibaos/tests/dom/list_test.ts b/ui/file_manager/file_manager/kibaos/tests/dom/list_test.ts
new file mode 100644
index 0000000000..d0780a22c1
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/dom/list_test.ts
@@ -0,0 +1,469 @@
+/**
+ * The list, driven the way a person drives it.
+ *
+ * The unit suite runs in node and has no DOM, so keyboard handling, ARIA and
+ * recycling had roles and handlers written but nothing exercising them. This
+ * runs in a real browser against real events.
+ *
+ * Every assertion here is about behaviour a person would notice: whether the
+ * arrow key moved the selection, whether a screen reader is told how many
+ * items there are, whether scrolling a hundred thousand rows quietly builds a
+ * hundred thousand elements.
+ */
+import type {EntryDto, Metadata} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import {FileList} from '../../ui/file_list.js';
+
+const NOW = new Date('2026-09-02T15:30:00').getTime();
+const ROOT = asFileKey('mock://myfiles');
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+interface Harness {
+  list: FileList;
+  host: HTMLElement;
+  viewport: HTMLElement;
+  entries: EntryDto[];
+  rows(): HTMLElement[];
+  key(key: string, modifiers?: {shift?: boolean, ctrl?: boolean}): void;
+  selectedNames(): string[];
+  destroy(): void;
+}
+
+function entriesOf(count: number): EntryDto[] {
+  const entries: EntryDto[] = [];
+  for (let i = 0; i < count; i++) {
+    const name = i % 4 === 0 ? `folder-${i}` : `file-${i}.txt`;
+    entries.push({
+      key: asFileKey(`${ROOT}/${name}`),
+      name,
+      isDirectory: i % 4 === 0,
+      parent: ROOT,
+    });
+  }
+  return entries;
+}
+
+function stage(height = 400): HTMLElement {
+  const host = document.createElement('div');
+  host.style.height = `${height}px`;
+  host.style.width = '760px';
+  document.body.appendChild(host);
+  return host;
+}
+
+function makeHarness(count = 20, height = 400): Harness {
+  const host = stage(height);
+
+  const entries = entriesOf(count);
+  const metadata = new Map<ReturnType<typeof asFileKey>, Metadata>();
+  entries.forEach((entry, i) => {
+    metadata.set(entry.key, {size: (i + 1) * 1024, modificationTime: NOW});
+  });
+
+  const list = new FileList(host, {rowHeight: 40});
+  list.setEntries(entries, NOW);
+  list.setMetadata(metadata);
+  const viewport = host.querySelector('.kibaos-list') as HTMLElement;
+
+  return {
+    list,
+    host,
+    viewport,
+    entries,
+    rows: () => [...host.querySelectorAll<HTMLElement>('.kibaos-row')],
+    key(key, modifiers = {}) {
+      viewport.dispatchEvent(new KeyboardEvent('keydown', {
+        key,
+        bubbles: true,
+        cancelable: true,
+        shiftKey: !!modifiers.shift,
+        ctrlKey: !!modifiers.ctrl,
+      }));
+    },
+    selectedNames() {
+      const keys = list.selectedKeys();
+      return entries.filter(e => keys.has(e.key)).map(e => e.name);
+    },
+    destroy() {
+      list.destroy();
+      host.remove();
+    },
+  };
+}
+
+interface Case {
+  name: string;
+  run(): void;
+}
+
+const CASES: Case[] = [
+  {
+    name: 'the list tells a screen reader what it is and how big it is',
+    run() {
+      const h = makeHarness(20);
+      try {
+        equal(h.viewport.getAttribute('role'), 'listbox', 'role');
+        equal(h.viewport.getAttribute('aria-multiselectable'), 'true',
+              'multiselectable');
+        equal(h.viewport.getAttribute('aria-setsize'), '20', 'set size');
+        const rows = h.rows();
+        assert(rows.length > 0, 'some rows are rendered');
+        equal(rows[0]!.getAttribute('role'), 'option', 'row role');
+        equal(rows[0]!.getAttribute('aria-posinset'), '1',
+              'the first row is position one, not zero');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'every row carries a name that reads as a sentence, not as cells',
+    run() {
+      const h = makeHarness(6);
+      try {
+        const label = h.rows()[1]!.getAttribute('aria-label') ?? '';
+        assert(label.includes('file-1.txt'), `names the file: ${label}`);
+        assert(label.includes('Document') || label.includes('File'),
+               `says what kind it is: ${label}`);
+        assert(label.split(',').length >= 3,
+               `carries the columns rather than just the name: ${label}`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'arrow keys move the selection',
+    run() {
+      const h = makeHarness(20);
+      try {
+        h.key('ArrowDown');
+        equal(h.selectedNames().length, 1, 'one selected');
+        h.key('ArrowDown');
+        h.key('ArrowDown');
+        equal(h.selectedNames()[0], 'file-3.txt', 'moved three down');
+        h.key('ArrowUp');
+        equal(h.selectedNames()[0], 'file-2.txt', 'and back up one');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'shift and an arrow extends the selection rather than moving it',
+    run() {
+      const h = makeHarness(20);
+      try {
+        h.key('ArrowDown');
+        h.key('ArrowDown', {shift: true});
+        h.key('ArrowDown', {shift: true});
+        equal(h.selectedNames().length, 3, 'three in the range');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'home and end reach the ends without walking there',
+    run() {
+      const h = makeHarness(500);
+      try {
+        h.key('End');
+        equal(h.selectedNames()[0], 'file-499.txt', 'the last entry');
+        h.key('Home');
+        equal(h.selectedNames()[0], 'folder-0', 'the first entry');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'page keys move by a viewport rather than by one',
+    run() {
+      const h = makeHarness(200, 400);
+      try {
+        h.key('Home');
+        h.key('PageDown');
+        const after = h.selectedNames()[0]!;
+        assert(after !== 'folder-0', 'it moved');
+        const index = h.entries.findIndex(e => e.name === after);
+        assert(index >= 8, `moved most of a viewport, landed on ${index}`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'control A selects everything, including what is not rendered',
+    run() {
+      const h = makeHarness(1000);
+      try {
+        h.key('a', {ctrl: true});
+        equal(h.list.selectedKeys().size, 1000,
+              'the selection is over indices, not over rendered rows');
+        assert(h.rows().length < 100,
+               `and only a viewport is rendered, not ${h.rows().length}`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'aria-selected follows the selection',
+    run() {
+      const h = makeHarness(20);
+      try {
+        h.key('ArrowDown');
+        const selected = h.rows().filter(
+            row => row.getAttribute('aria-selected') === 'true');
+        equal(selected.length, 1, 'exactly one row is marked selected');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'Enter opens what is focused',
+    run() {
+      const h = makeHarness(10);
+      try {
+        let opened: string|null = null;
+        const host = document.createElement('div');
+        host.style.height = '400px';
+        document.body.appendChild(host);
+        const list = new FileList(host, {
+          rowHeight: 40,
+          onActivate: entry => { opened = entry.name; },
+        });
+        list.setEntries(h.entries, NOW);
+        const viewport = host.querySelector('.kibaos-list') as HTMLElement;
+        viewport.dispatchEvent(
+            new KeyboardEvent('keydown', {key: 'ArrowDown', bubbles: true}));
+        viewport.dispatchEvent(
+            new KeyboardEvent('keydown', {key: 'Enter', bubbles: true}));
+        equal(opened, 'file-1.txt', 'the focused entry was opened');
+        list.destroy();
+        host.remove();
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'scrolling a long list does not build a long list',
+    run() {
+      const h = makeHarness(20_000);
+      try {
+        const before = h.rows().length;
+        for (let step = 0; step < 40; step++) {
+          h.viewport.scrollTop = step * 4_000;
+          h.list.render();
+        }
+        equal(h.rows().length, before,
+              'the pool is the size of the viewport and stays there');
+        assert(before < 40, `and it is small: ${before} rows`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'a folder with files in it does not also say it is empty',
+    run() {
+      const h = makeHarness(12);
+      try {
+        const empty = h.host.querySelector('.kibaos-empty') as HTMLElement;
+        assert(empty, 'there is no empty element to check');
+        // Not `.hidden`, which was true the whole time this was broken. What
+        // matters is whether a person can see it.
+        equal(getComputedStyle(empty).display, 'none',
+              'a folder with twelve files in it also announced it was empty');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'and an empty one still does',
+    run() {
+      const h = makeHarness(0);
+      try {
+        h.list.setEmptyReason('empty');
+        const empty = h.host.querySelector('.kibaos-empty') as HTMLElement;
+        assert(getComputedStyle(empty).display !== 'none',
+               'hiding it when there are files must not hide it when there are none');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'a short directory after a long one leaves no rows behind',
+    run() {
+      const h = makeHarness(2_000);
+      try {
+        const many = h.rows().length;
+        assert(many > 4, `the pool should start bigger than that: ${many}`);
+        // The pool only ever shrinks on this path. Scrolling never takes it,
+        // because the viewport keeps the same height and therefore asks for the
+        // same number of rows every time, so a suite that only scrolls will
+        // happily pass with the shrink deleted and leave a thousand rows from
+        // the previous directory sitting on screen.
+        const parent = h.entries[0]!.parent;
+        const short = ['one.txt', 'two.txt', 'three.txt'].map(name => ({
+          key: asFileKey(`${parent}/${name}`),
+          name,
+          isDirectory: false,
+          parent,
+        }));
+        h.list.setEntries(short, NOW);
+        equal(h.rows().length, 3,
+              'rows from the previous directory are still in the tree');
+        const shown = h.rows().map(row => row.textContent ?? '').join(' ');
+        assert(!shown.includes('file-1'),
+               `a row kept its old contents: ${shown.slice(0, 120)}`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'the empty state replaces the rows and is announced',
+    run() {
+      const h = makeHarness(0);
+      try {
+        h.list.setEmptyReason('filtered');
+        const empty = h.host.querySelector('.kibaos-empty') as HTMLElement;
+        assert(empty && !empty.hidden, 'the empty state is showing');
+        equal(empty.getAttribute('role'), 'status', 'it is announced');
+        assert((empty.textContent ?? '').includes('filter'),
+               `it says which emptiness this is: ${empty.textContent}`);
+        equal(h.rows().length, 0, 'and there are no rows behind it');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'a folder that changes under an unmoved window reports its range',
+    run() {
+      // This is the whole reason a new file gets a size. The window fetches
+      // details for the rows it can see, and it learns which those are from
+      // this report. A file arriving in the folder you are already looking at
+      // scrolls nothing, so if the report is skipped as an unchanged window,
+      // the row sits there blank until you scroll it away and back.
+      const host = stage();
+      const reports: Array<{first: number, count: number}> = [];
+      const list = new FileList(host, {
+        rowHeight: 40,
+        onRangeChange: (first, count) => reports.push({first, count}),
+      });
+      try {
+        list.setEntries(entriesOf(20), NOW);
+        const before = reports.length;
+        assert(before > 0, 'the first render reported no range at all');
+        // Same length and the same scroll position, so first and count are
+        // identical to last time and nothing but an explicit invalidation
+        // makes this report.
+        list.setEntries(entriesOf(20), NOW);
+        assert(
+            reports.length > before,
+            'the range was never reported, so nothing would fetch the details');
+        const last = reports[reports.length - 1]!;
+        equal(last.first, 0, 'reported the wrong first row');
+        assert(last.count > 0, 'reported an empty range');
+      } finally {
+        list.destroy();
+        host.remove();
+      }
+    },
+  },
+  {
+    name: 'a row can be picked up and carries the selection as file system URLs',
+    run() {
+      const h = makeHarness(10);
+      try {
+        const rows = h.rows();
+        assert(rows.every(row => row.draggable), 'every row is draggable');
+        h.list.setSelectedIndices([1, 2]);
+        const data = new Map<string, string>();
+        const event = new Event('dragstart', {bubbles: true, cancelable: true});
+        Object.defineProperty(event, 'dataTransfer', {
+          value: {
+            effectAllowed: 'none',
+            setData: (type: string, value: string) => data.set(type, value),
+          },
+        });
+        rows[1]!.dispatchEvent(event);
+        equal(data.get('fs/tag'), 'filemanager-data', 'tagged for the desktop');
+        equal(data.get('fs/sources'),
+              `${h.entries[1]!.key}\n${h.entries[2]!.key}`,
+              'both selected entries, as their URLs');
+        // Picking up a row that is not selected selects it, and only it.
+        data.clear();
+        const other = new Event('dragstart', {bubbles: true, cancelable: true});
+        Object.defineProperty(other, 'dataTransfer', {
+          value: {
+            effectAllowed: 'none',
+            setData: (type: string, value: string) => data.set(type, value),
+          },
+        });
+        h.rows()[4]!.dispatchEvent(other);
+        equal(data.get('fs/sources'), String(h.entries[4]!.key),
+              'the unselected row alone');
+        equal(h.selectedNames().join(','), h.entries[4]!.name,
+              'and it is now the selection');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'a selection set programmatically reads back as those entries',
+    run() {
+      const h = makeHarness(50);
+      try {
+        h.list.setSelectedIndices([2, 3, 4]);
+        equal(h.selectedNames().length, 3, 'three selected');
+        equal(h.selectedNames()[0], 'file-2.txt', 'and the right three');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+];
+
+export interface DomResult {
+  name: string;
+  ok: boolean;
+  error?: string;
+}
+
+export function runListDomTests(): DomResult[] {
+  const results: DomResult[] = [];
+  for (const testCase of CASES) {
+    try {
+      testCase.run();
+      results.push({name: testCase.name, ok: true});
+    } catch (error) {
+      results.push({
+        name: testCase.name,
+        ok: false,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  return results;
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/dom/shell_test.ts b/ui/file_manager/file_manager/kibaos/tests/dom/shell_test.ts
new file mode 100644
index 0000000000..5223f0181e
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/dom/shell_test.ts
@@ -0,0 +1,832 @@
+/**
+ * The window, driven end to end against the port.
+ *
+ * Every other suite hands a component its data. This one does not: it builds a
+ * backend, hands the shell nothing but the port, and asks what appeared on
+ * screen. That is the seam being load bearing rather than merely declared, and
+ * it is the first test that would notice if the two halves stopped agreeing.
+ */
+import {MockBackend} from '../../port/mock_backend.js';
+import type {FilesBackendPort} from '../../port/port.js';
+import type {FileKey, MetadataField} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import {FilesShell} from '../../ui/shell.js';
+
+const ROOT = asFileKey('mock://myfiles');
+const USB = asFileKey('mock://usb');
+const DRIVE = asFileKey('mock://gdrive');
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+/** Counts what the shell actually asked the backend for. */
+class CountingPort implements FilesBackendPort {
+  metadataCalls = 0;
+  metadataKeys = 0;
+  /** Every key the shell has asked about, in order. */
+  readonly metadataAsked: FileKey[] = [];
+  constructor(private readonly inner: FilesBackendPort) {}
+  list(key: FileKey, options?: Parameters<FilesBackendPort['list']>[1]) {
+    return this.inner.list(key, options);
+  }
+  metadata(keys: readonly FileKey[], fields: readonly MetadataField[]) {
+    this.metadataCalls++;
+    this.metadataKeys += keys.length;
+    this.metadataAsked.push(...keys);
+    return this.inner.metadata(keys, fields);
+  }
+  watch(key: FileKey, signal?: AbortSignal) {
+    return this.inner.watch(key, signal);
+  }
+  volumes() {
+    return this.inner.volumes();
+  }
+  search(q: string, scope: FileKey, o?: Parameters<FilesBackendPort['search']>[2]) {
+    return this.inner.search(q, scope, o);
+  }
+  tasks(keys: readonly FileKey[]) {
+    return this.inner.tasks(keys);
+  }
+  executeTask(id: string, keys: readonly FileKey[]) {
+    return this.inner.executeTask(id, keys);
+  }
+  startIo(request: Parameters<FilesBackendPort['startIo']>[0]) {
+    return this.inner.startIo(request);
+  }
+  subscribeIo(signal?: AbortSignal) {
+    return this.inner.subscribeIo(signal);
+  }
+  cancelIo(id: Parameters<FilesBackendPort['cancelIo']>[0]) {
+    return this.inner.cancelIo(id);
+  }
+  dialogMode() {
+    return this.inner.dialogMode();
+  }
+  confirmDialog(keys: readonly FileKey[]) {
+    return this.inner.confirmDialog(keys);
+  }
+  cancelDialog() {
+    return this.inner.cancelDialog();
+  }
+}
+
+function backendWith(fileCount = 6): MockBackend {
+  const backend = new MockBackend();
+  // Recent first on purpose: the shell must not land on it just because it is
+  // the first thing the backend happened to return.
+  backend.addVolume({
+    id: 'recent',
+    root: asFileKey('mock://recent'),
+    label: 'Recent',
+    kind: 'recent',
+    removable: false,
+    readOnly: false,
+    capacity: null,
+  });
+  backend.addVolume({
+    id: 'system',
+    root: ROOT,
+    label: 'Home',
+    kind: 'system',
+    removable: false,
+    readOnly: false,
+    capacity: {total: 32 * 1024 ** 3, free: 8 * 1024 ** 3},
+  });
+  backend.addVolume({
+    id: 'usb',
+    root: USB,
+    label: 'CRUZER',
+    kind: 'removable',
+    removable: true,
+    readOnly: false,
+    capacity: {total: 16 * 1024 ** 3, free: 128 * 1024 ** 2},
+  });
+  backend.addVolume({
+    id: 'gdrive',
+    root: DRIVE,
+    label: 'Google Drive',
+    kind: 'drive',
+    removable: false,
+    readOnly: false,
+    capacity: null,
+  });
+  const documents = backend.add(ROOT, 'Documents', true);
+  backend.add(ROOT, 'Photos', true);
+  backend.add(documents, 'Work', true);
+  backend.add(documents, 'Play', true);
+  backend.add(documents, 'notes.txt', false, {size: 900});
+  for (let i = 0; i < fileCount; i++) {
+    backend.add(ROOT, `home-${i}.txt`, false, {size: (i + 1) * 4096});
+  }
+  backend.add(USB, 'holiday.jpg', false, {size: 2 * 1024 ** 2});
+  return backend;
+}
+
+interface Harness {
+  shell: FilesShell;
+  host: HTMLElement;
+  port: CountingPort;
+  names(): string[];
+  crumbs(): string[];
+  tool(kind: string): HTMLButtonElement;
+  openRow(name: string): Promise<void>;
+  status(): string;
+  freeSpace(): string|null;
+  clickRow(name: string): void;
+  places(): string[];
+  headings(): string[];
+  currentPlace(): string|null;
+  notice(): string|null;
+  destroy(): void;
+}
+
+function makeHarness(backend: MockBackend = backendWith()): Harness {
+  const host = document.createElement('div');
+  host.style.height = '420px';
+  host.style.width = '900px';
+  document.body.appendChild(host);
+  const port = new CountingPort(backend);
+  const shell = new FilesShell(host, port, {rowHeight: 40});
+  return {
+    shell,
+    host,
+    port,
+    names: () => [...host.querySelectorAll<HTMLElement>('.kibaos-row')]
+                     .map(row => row.querySelector('.kibaos-name')?.textContent ?? ''),
+    places: () => [...host.querySelectorAll<HTMLElement>('.kibaos-place-label')]
+                      .map(node => node.textContent ?? ''),
+    headings: () =>
+        [...host.querySelectorAll<HTMLElement>('.kibaos-place-heading')]
+            .map(node => node.textContent ?? ''),
+    currentPlace: () => {
+      const current = host.querySelector('.kibaos-place[aria-current="page"]');
+      return current?.querySelector('.kibaos-place-label')?.textContent ?? null;
+    },
+    crumbs: () => [...host.querySelectorAll<HTMLElement>('.kibaos-crumb')]
+                      .map(node => node.textContent ?? ''),
+    tool: (kind: string) =>
+        host.querySelector<HTMLButtonElement>(`.kibaos-tool[data-tool="${kind}"]`)!,
+    openRow: async (name: string) => {
+      const row = [...host.querySelectorAll<HTMLElement>('.kibaos-row')].find(
+          candidate => candidate.querySelector('.kibaos-name')?.textContent ===
+              name);
+      if (!row) {
+        throw new AssertionError(`${name} is not on screen`);
+      }
+      row.dispatchEvent(new MouseEvent('dblclick', {bubbles: true}));
+    },
+    status: () =>
+        host.querySelector('.kibaos-status-summary')?.textContent ?? '',
+    freeSpace: () => {
+      const space = host.querySelector<HTMLElement>('.kibaos-status-space');
+      return space && !space.hidden ?
+          space.querySelector('.kibaos-status-free')?.textContent ?? '' :
+          null;
+    },
+    clickRow: (name: string) => {
+      const row = [...host.querySelectorAll<HTMLElement>('.kibaos-row')].find(
+          candidate => candidate.querySelector('.kibaos-name')?.textContent ===
+              name);
+      if (!row) {
+        throw new AssertionError(`${name} is not on screen`);
+      }
+      row.dispatchEvent(new MouseEvent('click', {bubbles: true}));
+    },
+    notice: () => {
+      const notice = host.querySelector<HTMLElement>('.kibaos-shell-notice');
+      return notice && !notice.hidden ? notice.textContent : null;
+    },
+    destroy: () => {
+      shell.destroy();
+      host.remove();
+    },
+  };
+}
+
+/** Lets the microtask queue and any zero latency awaits drain. */
+async function settle(times = 6): Promise<void> {
+  for (let i = 0; i < times; i++) {
+    await new Promise(resolve => setTimeout(resolve, 0));
+  }
+}
+
+interface DomResult {
+  name: string;
+  ok: boolean;
+  error?: string;
+}
+
+const CASES: Array<{name: string, run: () => Promise<void>}> = [
+  {
+    name: 'a file that appears in the folder you are looking at gets its details',
+    run: async () => {
+      // The window fetches metadata for the rows it can see, driven by the list
+      // telling it the visible range changed. A file arriving in a folder you
+      // are already looking at does not change that range, so nothing asked for
+      // its size, and the row sat there blank until you scrolled it out of
+      // sight and back. The shell remembers the range for exactly this.
+      const backend = backendWith();
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle();
+      const arrived = asFileKey('mock://myfiles/arrived.txt');
+      assert(!h.port.metadataAsked.includes(arrived),
+             'the file was asked about before it existed');
+      backend.add(asFileKey('mock://myfiles'), 'arrived.txt', false,
+                  {size: 4096});
+      await settle();
+      assert(h.names().includes('arrived.txt'), 'the new row never appeared');
+      // The key, not the call count. Any metadata call at all satisfies a
+      // count, which is how this passed for an hour while proving nothing.
+      assert(h.port.metadataAsked.includes(arrived),
+             'nothing asked for the details of the row that just appeared');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the window asks the backend what places exist',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      const places = h.places();
+      for (const expected of ['Recent', 'Home', 'CRUZER', 'Google Drive']) {
+        assert(places.includes(expected),
+               `${expected} is missing from ${JSON.stringify(places)}`);
+      }
+      h.destroy();
+    },
+  },
+  {
+    name: 'somebody elses drive is not filed as part of this computer',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      const headings = h.headings();
+      assert(headings.includes('Elsewhere'),
+             `Google Drive has no home of its own: ${JSON.stringify(headings)}`);
+      const groups = [...h.host.querySelectorAll('.kibaos-place-group')];
+      const computer = groups.find(
+          group => group.querySelector('.kibaos-place-heading')?.textContent ===
+              'This computer')!;
+      const inside = [...computer.querySelectorAll('.kibaos-place-label')]
+                         .map(node => node.textContent);
+      equal(inside.join(','), 'Home',
+            'this computer should hold only what is actually in it');
+      h.destroy();
+    },
+  },
+  {
+    name: 'it opens on a drive rather than on Recent',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      // Recent is the first volume the backend returns, and landing there
+      // shows a list assembled from everywhere before you have asked for
+      // anything.
+      equal(h.currentPlace(), 'Home', 'the window opened somewhere else');
+      assert(h.names().some(name => name.startsWith('home-')),
+             `the listing is not Home: ${JSON.stringify(h.names().slice(0, 4))}`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'choosing a place shows what is in it',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      const usb = [...h.host.querySelectorAll<HTMLElement>('.kibaos-place')]
+                      .find(button =>
+                                button.querySelector('.kibaos-place-label')
+                                    ?.textContent === 'CRUZER')!;
+      usb.click();
+      await settle();
+      equal(h.currentPlace(), 'CRUZER', 'the marker did not move');
+      equal(h.names().join(','), 'holiday.jpg',
+            'the list still shows the previous drive');
+      h.destroy();
+    },
+  },
+  {
+    name: 'opening a folder takes the marker off the drive you left',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      const row = [...h.host.querySelectorAll<HTMLElement>('.kibaos-row')].find(
+          candidate => (candidate.textContent ?? '').includes('Documents'))!;
+      assert(row, 'Documents is not on screen');
+      row.dispatchEvent(new MouseEvent('dblclick', {bubbles: true}));
+      await settle();
+      equal(h.currentPlace(), null,
+            'the sidebar still claims you are at the drive root');
+      h.destroy();
+    },
+  },
+  {
+    name: 'there is nowhere to go back to when the window opens',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      equal(h.tool('back').disabled, true, 'back');
+      equal(h.tool('forward').disabled, true, 'forward');
+      equal(h.tool('up').disabled, true, 'up, at the root of a drive');
+      h.destroy();
+    },
+  },
+  {
+    name: 'back returns you to where you were',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      equal(h.crumbs().join('/'), 'Home/Documents', 'the trail did not grow');
+      equal(h.tool('back').disabled, false, 'back should be available now');
+      h.tool('back').click();
+      await settle();
+      equal(h.crumbs().join('/'), 'Home', 'back did not return');
+      assert(h.names().some(name => name.startsWith('home-')),
+             'the listing did not come back with it');
+      h.destroy();
+    },
+  },
+  {
+    name: 'forward is only offered after going back',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      equal(h.tool('forward').disabled, true, 'nothing is ahead yet');
+      h.tool('back').click();
+      await settle();
+      equal(h.tool('forward').disabled, false, 'forward should be available');
+      h.tool('forward').click();
+      await settle();
+      equal(h.crumbs().join('/'), 'Home/Documents', 'forward did not go');
+      h.destroy();
+    },
+  },
+  {
+    name: 'going somewhere new discards what was ahead',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
