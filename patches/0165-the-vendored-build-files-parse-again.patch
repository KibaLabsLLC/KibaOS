+                       title: task.title,
+                       iconUrl: task.iconUrl,
+                       // Optional on the far side, so the absence of the flag
+                       // is false rather than undefined leaking into the UI.
+                       isDefault: task.isDefault === true,
+                       isDlpBlocked: task.isDlpBlocked === true,
+                     }));
+  }
+
+  async executeTask(taskId: string, keys: readonly FileKey[]): Promise<void> {
+    const entries = await this.resolveAll(keys);
+    let result: string;
+    try {
+      result = await this.platform.executeTask(decodeTask(taskId), entries);
+    } catch (error) {
+      throw translateError(error, 'That app');
+    }
+    // The API answers with a result string rather than by rejecting, so a
+    // failure here is silent unless it is read.
+    if (result === 'failed') {
+      throw new FilesError('io', 'That could not be opened.');
+    }
+    if (result === 'empty') {
+      throw new FilesError('unsupported', 'Nothing can open that.');
+    }
+  }
+
+  private toIoProgress(status: PlatformIoProgress): IoProgress {
+    const state = IO_STATES[status.state] ?? 'running';
