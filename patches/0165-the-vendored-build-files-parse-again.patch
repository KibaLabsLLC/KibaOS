+  }
+
+  onDirectoryChanged(listener: (event: PlatformWatchEvent) => void): () => void {
+    // Wrapped rather than passed straight through, because this is the line
+    // where ChromeOS's vocabulary becomes ours. Its eventType is a member of a
+    // nominal string enum whose values are exactly the union in `platform.ts`,
+    // copied from the same declaration, so the narrowing is a rename and not a
+    // guess. If that enum ever grows a third value this is the one place that
