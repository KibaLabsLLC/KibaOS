+
+/** A listener slot on a `chrome` event. */
+interface ChromeEvent<T> {
+  addListener(listener: (value: T) => void): void;
+  removeListener(listener: (value: T) => void): void;
+}
+
+/**
+ * What ChromeOS hands these listeners, before the edge narrows it.
+ *
+ * `eventType`, `type` and `state` are `string` here rather than the unions
+ * `platform.ts` uses, and that is not laziness. Each of them is a member of a
+ * TypeScript string enum on the ChromeOS side, and a string enum is nominal:
+ * no union of string literals is assignable to one in either direction, so a
+ * description naming the literals cannot be satisfied by the real API at all.
+ * `string` is the largest true thing this file can say. The exact unions live
+ * one layer in, on `Platform`, where they are ours to enforce.
+ */
+interface RawWatchEvent {
+  entry: PlatformEntry;
+  eventType: string;
+}
+
+interface RawIoProgress {
+  taskId: number;
+  type: string;
+  state: string;
+  bytesTransferred: number;
+  totalBytes: number;
+  sourceName: string;
+  itemCount: number;
+  numRemainingItems: number;
+  errorName?: string;
+}
+
+/**
+ * The slice of `chrome.fileManagerPrivate` this touches, and no more.
+ *
+ * Spelled as the bindings spell it, which is not how our interface spells it:
+ * the io methods are `startIOTask` and `cancelIOTask` with a capital pair, and
+ * `getFileTasks` and `selectFiles` each take an argument our port has no reason
+ * to know about.
+ */
+export interface FileManagerPrivateSlice {
+  getSizeStats(
+      volumeId: string,
+      callback: (stats?: {totalSize: number, remainingSize: number}) => void):
+      void;
+  addFileWatch(entry: PlatformEntry, callback: (success?: boolean) => void): void;
+  removeFileWatch(entry: PlatformEntry, callback: (success?: boolean) => void):
+      void;
+  onDirectoryChanged: ChromeEvent<RawWatchEvent>;
+  searchFiles(
+      params: {
+        /** Absent, never null. The bindings declare it optional. */
+        rootDir?: PlatformEntry,
+        query: string,
+        types: string,
+        maxResults: number,
+      },
+      callback: (entries: PlatformEntry[]) => void): void;
+  getFileTasks(
+      entries: readonly PlatformEntry[], dlpSourceUrls: readonly string[],
+      callback: (tasks: PlatformResultingTasks) => void): void;
+  executeTask(
+      descriptor: PlatformTaskDescriptor, entries: readonly PlatformEntry[],
+      callback: (result: string) => void): void;
+  startIOTask(
+      // `string`, for the nominal enum reason above.
+      type: string, entries: readonly PlatformEntry[],
+      params: {destinationFolder?: PlatformEntry, showNotification?: boolean},
+      callback: (taskId: number) => void): void;
+  cancelIOTask(taskId: number): void;
+  onIOTaskProgressStatus: ChromeEvent<RawIoProgress>;
