+const DIALOG_KINDS: Record<string, DialogKind> = {
+  'open-file': 'open-file',
+  'open-multi-file': 'open-multi',
+  'folder': 'open-folder',
+  'upload-folder': 'open-upload',
+  'saveas-file': 'save-as',
