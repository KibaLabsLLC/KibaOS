+      await h.openRow('Documents');
+      await settle();
+      await h.openRow('Work');
+      await settle();
+      equal(h.crumbs().join('/'), 'Home/Documents/Work', 'three deep');
+      const home = [...h.host.querySelectorAll<HTMLElement>('.kibaos-crumb')]
+                       .find(c => c.textContent === 'Home')!;
+      home.click();
+      await settle();
