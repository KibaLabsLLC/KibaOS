+<!doctype html>
+<meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy"
+      content="require-trusted-types-for 'script'">
+<title>KibaOS Files harness</title>
+<link rel="stylesheet" href="../../ui/tokens.css">
+<style>
+  html, body { margin: 0; background: var(--kibaos-ground); }
+  body { font: 13px system-ui, sans-serif; }
+  #stage { padding: 8px 0; }
+  .kibaos-panel {
+    background: var(--kibaos-panel);
+    border: 1px solid var(--kibaos-line);
+    border-radius: var(--kibaos-radius-panel);
+    margin: 8px;
+    padding: 4px 0;
+  }
+</style>
+<div id="stage"></div>
+<script type="module">
+  import {STORIES} from './stories.js';
+  // Published so the runner can ask the module what the stories are instead of
+  // parsing this file's source for them. Parsing missed every story built by a
+  // factory rather than written out as a literal, which is exactly the kind of
+  // gap a second implementation of the same list produces.
+  window.kibaosStories = STORIES.map(
+      s => ({name: s.name, width: s.width, height: s.height}));
+  const name = new URLSearchParams(location.search).get('story');
+  const story = STORIES.find(s => s.name === name);
+  const stage = document.getElementById('stage');
+  (async () => {
+    if (!name) {
+      document.documentElement.classList.add('ready');
+      return;
+    }
+    if (!story) {
+      stage.textContent = 'No story named ' + name;
+    } else {
+      if (story.theme) {
+        document.documentElement.dataset.kibaosTheme = story.theme;
+      }
+      if (story.density) {
+        document.documentElement.dataset.kibaosDensity = story.density;
+      }
+      // Awaited: a story that drives the port is not on screen when render
+      // returns, and shooting it then catches an empty window.
+      await story.render(stage);
+    }
+    // Fonts settle after first paint, and a golden taken before they do differs
+    // from one taken after by a pixel here and there on every glyph.
+    await document.fonts.ready;
+    requestAnimationFrame(() => document.documentElement.classList.add('ready'));
+  })();
+</script>
diff --git a/ui/file_manager/file_manager/kibaos/tests/harness/live_shell.js b/ui/file_manager/file_manager/kibaos/tests/harness/live_shell.js
new file mode 100644
index 0000000000..e0dc696f08
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/harness/live_shell.js
@@ -0,0 +1,90 @@
+/**
+ * Mounts the KibaOS shell in a live Files window, over the real backend.
+ *
+ * Not a test. This is the thing you look at. It builds `ChromeOsPlatform` from
+ * the running app's own collaborators, wraps it in `ChromeOsBackend`, and hands
+ * that to `FilesShell`, so what appears on screen is the redesign driven by the
+ * actual filesystem rather than a mock and rather than a screenshot.
+ *
+ * It overlays rather than replacing, so nothing about the existing app is torn
+ * down: remove `#kibaos-live` from the page, or close the window, and the
+ * stock Files app is exactly as it was.
+ *
+ * Assembled and sent by `live_shell.py`. Do not run directly.
+ */
+(() => {
+const kibaosModules = {};
+const kibaosExports = {};
+function define(name, deps, factory) {
+  kibaosModules[name] = {deps: deps, factory: factory};
+}
+function requireModule(name) {
+  if (Object.prototype.hasOwnProperty.call(kibaosExports, name)) {
+    return kibaosExports[name];
+  }
+  const module = kibaosModules[name];
+  if (!module) {
+    throw new Error('no such module in the bundle: ' + name);
+  }
+  const exported = (kibaosExports[name] = {});
+  const args = module.deps.map(function(dep) {
+    if (dep === 'require') return requireModule;
+    if (dep === 'exports') return exported;
+    return requireModule(dep);
+  });
+  module.factory.apply(null, args);
+  return exported;
+}
+
+// @BUNDLE@
+
+return (async () => {
+  const {ChromeOsBackend} = requireModule('adapter/chromeos_backend');
+  const {ChromeOsPlatform} = requireModule('adapter/chromeos_platform');
+  const {FilesShell} = requireModule('ui/shell');
+
+  const app = window.fileManager;
+  if (!app || !app.volumeManager || !app.metadataModel_) {
+    return JSON.stringify({error: 'the Files app is not open in this renderer'});
+  }
+
+  const platform = new ChromeOsPlatform(
+      chrome.fileManagerPrivate, chrome.runtime, app.volumeManager,
+      app.metadataModel_,
+      (url, ok, fail) => webkitResolveLocalFileSystemURL(url, ok, fail),
+      null);
+
+  let style = document.getElementById('kibaos-tokens');
+  if (!style) {
+    style = document.createElement('style');
+    style.id = 'kibaos-tokens';
+    document.head.appendChild(style);
+  }
+  style.textContent = "@TOKENS@";
+
+  const existing = document.getElementById('kibaos-live');
+  if (existing) {
+    existing.remove();
+  }
+  const host = document.createElement('div');
+  host.id = 'kibaos-live';
+  host.style.cssText =
+      'position:fixed;inset:0;z-index:2147483647;overflow:hidden;';
+  document.body.appendChild(host);
+
+  const shell = new FilesShell(host, new ChromeOsBackend(platform));
+  await shell.start();
+  await new Promise(done => setTimeout(done, 1200));
+
+  const text = (selector) =>
+      [...host.querySelectorAll(selector)].map(node => node.textContent.trim());
+  return JSON.stringify({
+    mounted: true,
+    places: text('.kibaos-place-label'),
+    headings: text('.kibaos-place-heading'),
+    rows: text('.kibaos-name').slice(0, 12),
+    rowCount: host.querySelectorAll('.kibaos-row').length,
+    status: (host.querySelector('.kibaos-status-summary') || {}).textContent,
+  }, null, 1);
+})();
+})()
diff --git a/ui/file_manager/file_manager/kibaos/tests/harness/live_shell.py b/ui/file_manager/file_manager/kibaos/tests/harness/live_shell.py
new file mode 100644
index 0000000000..5178baf7b8
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/harness/live_shell.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Puts the KibaOS shell on screen in a live Files window, over the real backend.
+
+Not a test, and not a screenshot. This compiles the shell, the adapter and the
+ChromeOS wiring into one bundle, sends it into a running Files renderer, and
+mounts it as an overlay driven by the actual filesystem.
+
+  python3 live_shell.py
+
+It adds `#kibaos-live` and a `#kibaos-tokens` style to the page and touches
+nothing else, so removing that element, or closing the window, leaves the stock
+app exactly as it was.
+"""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+KIBAOS = os.path.dirname(os.path.dirname(HERE))
+SRC = os.path.abspath(os.path.join(KIBAOS, "..", "..", "..", ".."))
+NODE = os.path.join(SRC, "third_party/node/linux/node-linux-x64/bin/node")
+TSC = os.path.join(SRC, "third_party/node/node_modules/typescript/bin/tsc")
+LAB = os.environ.get("KIBAOS_LAB", "/mnt/build/kibaos-work/lab")
+
+# ui/shell.ts drags in the whole window: sidebar, toolbar, path bar, list, rows,
+# status bar, copy and format. Naming it is enough.
+MODULES = [
+    "port/types.ts",
+    "port/port.ts",
+    "adapter/chromeos_backend.ts",
+    "adapter/chromeos_platform.ts",
+    "ui/shell.ts",
+]
+
+
+def build_bundle(out_path):
+    command = [
+        NODE, TSC, "--strict", "--skipLibCheck", "--target", "es2022",
+        "--module", "amd", "--outFile", out_path, "--lib", "es2022,dom",
+        "--ignoreDeprecations", "6.0",
+    ] + [os.path.join(KIBAOS, module) for module in MODULES]
+    finished = subprocess.run(command, capture_output=True, text=True)
+    if not os.path.exists(out_path):
+        sys.stdout.write(finished.stdout + finished.stderr)
+        raise SystemExit("the bundle did not compile")
+    return open(out_path).read()
+
+
+def main():
+    for needed in (NODE, TSC, LAB):
+        if not os.path.exists(needed):
+            raise SystemExit("not found: %s" % needed)
+
+    with tempfile.TemporaryDirectory() as scratch:
+        bundle = build_bundle(os.path.join(scratch, "bundle.js"))
+    harness = open(os.path.join(HERE, "live_shell.js")).read()
+    tokens = open(os.path.join(KIBAOS, "ui/tokens.css")).read()
+
+    for marker in ("// @BUNDLE@", '"@TOKENS@"'):
+        if harness.count(marker) != 1:
+            raise SystemExit("the harness has no single %s to splice" % marker)
+    # json.dumps rather than a naive quote: the stylesheet is full of braces,
+    # quotes and newlines, and one unescaped character turns the whole payload
+    # into a syntax error a long way from its cause.
+    payload = harness.replace("// @BUNDLE@", bundle)
+    payload = payload.replace('"@TOKENS@"', json.dumps(tokens))
+
+    print("sending %d bytes to the renderer" % len(payload))
+    environment = dict(os.environ, KIBAOS_CDP_TIMEOUT="120")
+    # Through a file, not an argument. A bundled application is well past the
+    # 128KB Linux allows in a single argv entry, and the failure for that is an
+    # OSError from posix_spawn that says nothing about size.
+    with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as handle:
+        handle.write(payload)
+        payload_path = handle.name
+    try:
+        finished = subprocess.run([LAB, "eval", "@" + payload_path],
+                                  capture_output=True, text=True,
+                                  env=environment)
+    finally:
+        os.unlink(payload_path)
+    sys.stderr.write(finished.stderr)
+    print(finished.stdout.strip())
+    return finished.returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
