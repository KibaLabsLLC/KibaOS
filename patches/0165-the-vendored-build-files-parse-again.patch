+function decodeTask(id: string): PlatformTaskDescriptor {
+  const [appId = '', taskType = '', ...rest] = id.split('|');
+  // Split into three, not into however many pipes there are: an action id is
+  // an arbitrary string and is allowed to contain one.
+  return {appId, taskType, actionId: rest.join('|')};
