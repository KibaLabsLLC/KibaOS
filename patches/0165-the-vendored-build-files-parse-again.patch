+      // types is as required as maxResults is: omitting either is refused by
+      // the bindings before the call is made.
+      found = await this.platform.searchFiles(
+          {rootDir: root, query, types: 'ALL', maxResults});
+    } catch (error) {
+      throw translateError(error, 'That search');
+    }
+    const entries = found
+                        .filter(
+                            entry => options.showHidden ||
+                                !entry.name.startsWith('.'))
+                        .map(entry => this.toDto(entry, scope));
+    yield {revision: this.revisionOf(scope), entries, done: true};
+  }
+
+  async tasks(keys: readonly FileKey[]): Promise<readonly TaskDescriptor[]> {
+    const entries = await this.resolveAll(keys);
