+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      equal(h.tool('up').disabled, false, 'up should be available');
+      h.tool('up').click();
+      await settle();
+      equal(h.crumbs().join('/'), 'Home', 'up did not go up');
+      equal(h.tool('up').disabled, true, 'and there is nothing above a drive');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the crumb you are standing on is not a link to elsewhere',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
