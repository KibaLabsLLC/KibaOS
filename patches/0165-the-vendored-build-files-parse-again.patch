+<!doctype html>
+<meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy"
+      content="require-trusted-types-for 'script'">
+<title>KibaOS Files DOM tests</title>
+<link rel="stylesheet" href="../../ui/tokens.css">
+<style>html, body { margin: 0; background: var(--kibaos-ground); }</style>
+<script type="module">
+  import {runListDomTests} from '../dom/list_test.js';
+  import {runSidebarDomTests} from '../dom/sidebar_test.js';
+  import {runShellDomTests} from '../dom/shell_test.js';
+  // Named here rather than in each suite so a suite that throws on import is
+  // still reported as a failure with a name, instead of the page simply never
+  // publishing a result and the runner timing out with nothing to say.
+  const suites = [
+    ['list', runListDomTests],
+    ['sidebar', runSidebarDomTests],
+    ['shell', runShellDomTests],
+  ];
+  (async () => {
+    const results = [];
+    for (const [suite, run] of suites) {
+      window.kibaosDomProgress = suite;
+      try {
+        for (const result of await run()) {
+          results.push(Object.assign({}, result, {name: suite + ': ' + result.name}));
+        }
+      } catch (error) {
+        results.push({
+          name: suite + ': the suite itself',
+          ok: false,
+          error: String(error && error.stack || error),
+        });
+      }
+    }
+    window.kibaosDomResults = results;
+  })();
+</script>
