+  copy: 'copy',
+  move: 'move',
+  trash: 'trash',
+  restore: 'restore',
+  restore_to_destination: 'restore',
+  delete: 'delete',
+  empty_trash: 'delete',
+  zip: 'compress',
+  extract: 'extract',
+};
+
