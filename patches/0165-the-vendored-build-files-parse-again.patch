+  for (auto& observer : gpu_usage_observers_) {
+    std::vector<mojom::GpuInfoPtr> cloned;
+    cloned.reserve(gpu_info.size());
+    for (const auto& gpu : gpu_info) {
+      cloned.push_back(gpu.Clone());
+    }
+    observer->OnGpuUsageUpdated(std::move(cloned));
+  }
+}
+
+void SystemDataProvider::NotifySensorInfoObservers(
+    const std::vector<mojom::SensorInfoPtr>& sensors) {
+  for (auto& observer : sensor_info_observers_) {
+    std::vector<mojom::SensorInfoPtr> cloned;
+    cloned.reserve(sensors.size());
+    for (const auto& sensor : sensors) {
+      cloned.push_back(sensor.Clone());
+    }
+    observer->OnSensorInfoUpdated(std::move(cloned));
+  }
+}
