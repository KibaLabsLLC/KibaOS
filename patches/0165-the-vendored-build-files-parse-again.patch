+      taskId: TaskId,
+      kind: IoKind,
+      state: IoState,
+      processed: number,
+      total: number,
+      currentName?: string,
+      error?: FilesError,
+    } = {
+      taskId: String(status.taskId) as TaskId,
+      kind: IO_KINDS[status.type] ?? 'copy',
+      state,
+      processed: status.bytesTransferred,
+      total: status.totalBytes,
+      currentName: status.sourceName,
+    };
+    if (status.state === 'need_password') {
+      progress.error = new FilesError(
+          'unsupported', 'That archive needs a password.');
+    } else if (state === 'failed') {
+      progress.error = translateError(
+          {name: status.errorName ?? ''}, 'That operation');
+    }
+    return progress;
+  }
+
+  async startIo(request: IoRequest): Promise<TaskId> {
+    const entries = await this.resolveAll(request.sources);
+    let destination: PlatformEntry|undefined;
+    if (request.destination) {
+      destination = await this.resolveDirectory(request.destination);
+    }
+    let taskId: number;
+    try {
+      taskId = await this.platform.startIoTask(
+          IO_TYPES[request.kind], entries, {destinationFolder: destination});
+    } catch (error) {
+      throw translateError(error, 'That operation');
+    }
+    return String(taskId) as TaskId;
+  }
+
+  async * subscribeIo(signal?: AbortSignal): AsyncIterable<IoProgress> {
+    const stream = new Stream<IoProgress>();
+    // Registered before any await, for the same reason watch is.
+    const off = this.platform.onIoProgress(status => {
+      stream.push(this.toIoProgress(status));
+    });
+    const stop = () => {
+      off();
+      stream.close();
+    };
+    if (signal?.aborted) {
+      stop();
+      return;
+    }
+    signal?.addEventListener('abort', stop, {once: true});
+    try {
+      yield* stream;
+    } finally {
+      stop();
+    }
+  }
+
+  async cancelIo(taskId: TaskId): Promise<void> {
+    const numeric = Number(taskId);
+    if (!Number.isFinite(numeric)) {
+      throw new FilesError('not-found', 'There is no such operation.');
+    }
+    this.platform.cancelIoTask(numeric);
+  }
+
+  async dialogMode(): Promise<DialogMode|null> {
+    const launch = await this.platform.getLaunchDialog();
+    if (!launch) {
+      return null;
+    }
+    const kind = DIALOG_KINDS[launch.type];
+    if (!kind) {
+      // An unrecognised dialog type is not a picker we know how to be. Saying
+      // so beats guessing "open-file" and handing a caller the wrong contract.
+      throw new FilesError(
+          'unsupported', `${launch.type} is not a dialog we can be.`);
+    }
+    return {
+      kind,
+      typeList: launch.typeList ?? [],
+      // The launch parameters carry allowedPaths directly. nativePath means
+      // the caller needs a real path, so Drive and provider volumes cannot be
+      // offered.
+      allowedPaths: launch.allowedPaths === 'nativePath' ? 'native' : 'any',
+      defaultName: launch.targetName,
+    };
+  }
+
+  async confirmDialog(keys: readonly FileKey[]): Promise<void> {
+    // Urls, despite the parameter being named for paths: Chromium's own dialog
+    // controller passes entry.toURL() here, so a key is already the right
+    // thing. The boolean beside it is not optional, and is the same reduction
+    // of allowedPaths that controller performs.
+    const launch = await this.platform.getLaunchDialog();
+    await this.platform.selectFiles(
+        keys.map(key => String(key)), launch?.allowedPaths === 'nativePath');
+  }
+
+  async cancelDialog(): Promise<void> {
+    this.platform.cancelDialog();
+  }
+}
