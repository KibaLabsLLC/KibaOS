+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {getSizeStats} from '../../common/js/api.js';
+import {bytesToString} from '../../common/js/translations.js';
+import {RootType, VolumeType} from '../../common/js/volume_manager_types.js';
+import type {Volume} from '../../state/state.js';
+import {getStore} from '../../state/store.js';
+import type {Store} from '../../state/store.js';
+
+import type {DirectoryModel} from './directory_model.js';
+
+/**
+ * KibaOS: the panel that turns Computer into a view of the machine.
+ *
+ * Computer opened onto seven curated entries, Downloads and Filesystem Root
+ * and Users and the rest, which is a list of places rather than a picture of
+ * the hardware. Nothing on the screen told you what disks the machine has, how
+ * big they are, or how full. Every other desktop answers that in the same
+ * place.
+ *
+ * The data is already in the frontend. The store carries a Volume for every
+ * mounted volume with its label, device type, filesystem and read only flag,
+ * and getSizeStats gives the capacity. So this is a rendering job and nothing
+ * more: no new plumbing, no new host call.
+ */
+export class KibaOsDevicesController {
+  private store_: Store;
+  private panel_: HTMLElement|null = null;
+  private list_: HTMLElement|null = null;
+
+  /**
+   * Guards against a slow capacity query painting a panel that has since been
+   * rebuilt for another folder. Each render takes the next number.
+   */
+  private render_ = 0;
+
+  constructor(private directoryModel_: DirectoryModel) {
+    this.store_ = getStore();
+    this.directoryModel_.addEventListener(
+        'directory-changed', this.update_.bind(this));
+    this.directoryModel_.addEventListener(
+        'cur-dir-scan-completed', this.update_.bind(this));
+  }
+
+  /**
+   * The panel lives in the same document as the file picker dialogs, which
+   * have no Computer root and no panel, so this tolerates absence rather than
+   * asserting on it.
+   */
+  private elements_(): boolean {
+    if (!this.panel_) {
+      this.panel_ = document.querySelector<HTMLElement>('#kibaos-devices');
+      this.list_ = document.querySelector<HTMLElement>('#kibaos-devices-list');
+    }
+    return !!this.panel_ && !!this.list_;
+  }
+
+  private update_() {
+    if (!this.elements_()) {
+      return;
+    }
+    const onComputer =
+        this.directoryModel_.getCurrentRootType() === RootType.LOCAL_ROOT;
+    this.panel_!.hidden = !onComputer;
+    if (!onComputer) {
+      // Emptied rather than left in place. A stale panel behind hidden is a
+      // panel that flashes the previous machine state on the way back in.
+      this.list_!.textContent = '';
+      return;
+    }
+    this.render_++;
+    this.draw_(this.render_);
+  }
+
+  /**
+   * Volumes worth showing as hardware.
+   *
+   * Downloads and the Linux container are places, not disks, and the sidebar
+   * already lists them. Showing them here again would make the panel a second
+   * copy of the sidebar rather than an answer to a different question.
+   */
+  private isDevice_(volume: Volume): boolean {
+    switch (volume.volumeType) {
+      case VolumeType.REMOVABLE:
+      case VolumeType.ARCHIVE:
+      case VolumeType.MTP:
+      case VolumeType.SMB:
+      case VolumeType.LOCAL_ROOT:
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  private iconFor_(volume: Volume): string {
+    if (volume.volumeType === VolumeType.LOCAL_ROOT) {
+      return 'computer';
+    }
+    if (volume.volumeType === VolumeType.ARCHIVE) {
+      return 'archive';
+    }
+    if (volume.volumeType === VolumeType.SMB) {
+      return 'smb';
+    }
+    if (volume.volumeType === VolumeType.MTP) {
+      return 'mobile';
+    }
+    switch (volume.deviceType) {
+      case 'usb':
+        return 'usb';
+      case 'sd':
+        return 'sd';
+      case 'optical':
+        return 'optical';
+      case 'mobile':
+        return 'mobile';
+      default:
+        return 'hdd';
+    }
+  }
+
+  /**
+   * What the row says under its name.
+   *
+   * Only facts the store actually holds. A filesystem it does not know is left
+   * out rather than guessed at, because a wrong filesystem next to a Format
+   * command is worse than no filesystem at all.
+   */
+  private detailFor_(volume: Volume): string {
+    const parts: string[] = [];
+    if (volume.diskFileSystemType) {
+      parts.push(volume.diskFileSystemType);
+    }
+    if (volume.isReadOnly) {
+      parts.push('Read only');
+    }
+    return parts.join('  ·  ');
+  }
+
+  private draw_(render: number) {
+    const list = this.list_!;
+    list.textContent = '';
+
+    const volumes = Object.values(this.store_.getState().volumes ?? {})
+                        .filter(volume => this.isDevice_(volume));
+    if (!volumes.length) {
+      return;
+    }
+
+    for (const volume of volumes) {
+      const row = document.createElement('div');
+      row.className = 'kibaos-device';
+
+      const icon = document.createElement('span');
+      icon.setAttribute('kibaos-device-icon', this.iconFor_(volume));
+      row.appendChild(icon);
+
+      const text = document.createElement('div');
+      text.className = 'kibaos-device-text';
+
+      const name = document.createElement('div');
+      name.className = 'kibaos-device-name';
+      name.textContent = volume.label || volume.volumeId;
+      text.appendChild(name);
+
+      const detail = document.createElement('div');
+      detail.className = 'kibaos-device-detail';
+      detail.textContent = this.detailFor_(volume);
+      text.appendChild(detail);
+      row.appendChild(text);
+
+      const meter = document.createElement('div');
+      meter.className = 'kibaos-device-meter';
+      const bar = document.createElement('div');
+      bar.className = 'kibaos-device-bar';
+      const fill = document.createElement('div');
+      fill.className = 'kibaos-device-fill';
+      bar.appendChild(fill);
+      const figure = document.createElement('div');
+      figure.className = 'kibaos-device-figure';
+      meter.appendChild(bar);
+      meter.appendChild(figure);
+      row.appendChild(meter);
+
+      list.appendChild(row);
+      this.fill_(render, volume, fill, figure, meter);
+    }
+  }
+
+  /**
+   * Asks for one volume's capacity and fills its bar.
+   *
+   * A volume that cannot answer keeps its row and loses its bar. The row is
+   * still the useful part: the machine has that disk whether or not its size
+   * can be read, and dropping the row would make hardware disappear because a
+   * stat call failed.
+   */
+  private async fill_(
+      render: number, volume: Volume, fill: HTMLElement, figure: HTMLElement,
+      meter: HTMLElement) {
+    let stats;
+    try {
+      stats = await getSizeStats(volume.volumeId);
+    } catch (error) {
+      stats = undefined;
+    }
+    if (render !== this.render_) {
+      return;
+    }
+    if (!stats || !stats.totalSize) {
+      meter.hidden = true;
+      return;
+    }
+    const used = Math.max(0, stats.totalSize - stats.remainingSize);
+    const ratio = Math.min(1, Math.max(0, used / stats.totalSize));
+    fill.style.width = `${(ratio * 100).toFixed(1)}%`;
+    // Rounding a nearly full disk down to 99% would be a comforting lie, so
+    // the bar carries the proportion and the text carries the numbers.
+    figure.textContent =
+        `${bytesToString(used)} of ${bytesToString(stats.totalSize)}`;
+    meter.classList.toggle('kibaos-device-low', ratio >= 0.9);
+  }
+}
diff --git a/ui/file_manager/file_manager/foreground/js/kibaos_folder_size.ts b/ui/file_manager/file_manager/foreground/js/kibaos_folder_size.ts
new file mode 100644
index 0000000000..a90fe28f2e
--- /dev/null
+++ b/ui/file_manager/file_manager/foreground/js/kibaos_folder_size.ts
@@ -0,0 +1,141 @@
+// Copyright 2026 The KibaOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {isNativeEntry, unwrapEntry} from '../../common/js/entry_utils.js';
+import type {FilesAppEntry} from '../../common/js/files_app_entry_types.js';
+
+/**
+ * KibaOS: how big is that folder, actually.
+ *
+ * Every file manager on a desktop can answer this and Files cannot. The Size
+ * column shows a dash for every directory, because a directory has no size of
+ * its own and finding out means walking the whole tree underneath it. Files
+ * already owns that walk: `chrome.fileManagerPrivate.getDirectorySize` runs it
+ * in the browser process, and the details panel calls it whenever a folder is
+ * selected. Nothing surfaces it in the list, which is where somebody clearing
+ * a disk is actually looking.
+ *
+ * So this is on demand and never automatic. Measuring is expensive in a way
+ * that is invisible until the tree is large, and a list that silently measured
+ * every folder it drew would spend a spinning disk on numbers nobody asked
+ * for. The answer arrives because somebody asked for it, and is remembered
+ * afterwards so asking twice is free.
+ */
+
+/**
+ * Remembered measurements, keyed by entry URL.
+ *
+ * Capped, because this is never cleared while the window lives and a long
+ * session that walks a large tree would otherwise hold a number for every
+ * folder it ever visited. Sixty four folders is far more than anybody measures
+ * by hand in one sitting.
+ */
+const KIBAOS_FOLDER_SIZE_LIMIT = 64;
+
+const folderSizes = new Map<string, number>();
+
+/**
+ * URLs currently being measured, so a second invocation on the same folder
+ * joins the first walk instead of starting another one. Without this, holding
+ * the menu item down would queue a walk per keypress and each one would read
+ * the whole tree again.
+ */
+const inFlight = new Map<string, Promise<number|undefined>>();
+
+/**
+ * Whether Files can measure this entry at all.
+ *
+ * A directory is not enough. `getDirectorySize` takes a real filesystem
+ * directory, so the fake roots that Files synthesises, and any entry belonging
+ * to a provider rather than to a disk, have to be turned away here rather than
+ * fail in the callback where there is nothing useful to say about them.
+ */
+export function kibaOsCanMeasureSize(entry: Entry|FilesAppEntry): boolean {
+  if (!entry || !entry.isDirectory) {
+    return false;
+  }
+  return isNativeEntry(unwrapEntry(entry) as Entry | FilesAppEntry);
+}
+
+/**
+ * The measurement for this folder if one has been taken, otherwise undefined.
+ *
+ * Undefined and not -1: -1 is what the metadata carries for a directory that
+ * has no size, and the two mean different things. Undefined here means nobody
+ * has asked yet.
+ */
+export function kibaOsMeasuredFolderSize(entry: Entry|FilesAppEntry): number
+    |undefined {
+  if (!entry || !entry.isDirectory) {
+    return undefined;
+  }
+  return folderSizes.get(entry.toURL());
+}
+
+/**
+ * Records a measurement, evicting the least recently recorded one when full.
+ *
+ * The delete before the set is what makes the eviction a real LRU. A Map keeps
+ * insertion order, so setting a key that is already present leaves it where it
+ * first went in; deleting first moves it to the end, and the oldest key is
+ * then genuinely the one at the front.
+ */
+function remember(url: string, size: number) {
+  folderSizes.delete(url);
+  folderSizes.set(url, size);
+  while (folderSizes.size > KIBAOS_FOLDER_SIZE_LIMIT) {
+    const oldest = folderSizes.keys().next();
+    if (oldest.done) {
+      break;
+    }
+    folderSizes.delete(oldest.value);
+  }
+}
+
+/**
+ * Walks the folder and returns its total size in bytes, or undefined if the
+ * walk could not be done.
+ *
+ * `chrome.runtime.lastError` has to be read inside the callback. The extension
+ * bindings clear it as soon as the callback returns, and a failed call still
+ * invokes the callback, with a size that is undefined or stale rather than
+ * with an exception. Checking it is the only way to tell a folder of zero
+ * bytes from a folder that could not be read.
+ */
+export function kibaOsMeasureFolderSize(entry: Entry|FilesAppEntry):
+    Promise<number|undefined> {
+  if (!kibaOsCanMeasureSize(entry)) {
+    return Promise.resolve(undefined);
+  }
+  const url = entry.toURL();
+  const existing = inFlight.get(url);
+  if (existing) {
+    return existing;
+  }
+  const directoryEntry = unwrapEntry(entry) as DirectoryEntry;
+  const walk = new Promise<number|undefined>(resolve => {
+    chrome.fileManagerPrivate.getDirectorySize(directoryEntry, size => {
+      if (chrome.runtime.lastError || typeof size !== 'number' ||
+          !isFinite(size) || size < 0) {
+        resolve(undefined);
+        return;
+      }
+      remember(url, size);
+      resolve(size);
+    });
+  }).finally(() => {
+    inFlight.delete(url);
+  });
+  inFlight.set(url, walk);
+  return walk;
+}
+
+/**
+ * Forgets every measurement. Exists for tests, which would otherwise carry one
+ * case's numbers into the next.
+ */
+export function kibaOsForgetFolderSizes() {
+  folderSizes.clear();
+  inFlight.clear();
+}
