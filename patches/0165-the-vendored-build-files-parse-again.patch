+      assert(!options.includes('notes.txt'),
+             'a file is not somewhere you can go');
+      equal(chevron.getAttribute('aria-expanded'), 'true', 'not announced open');
+      h.destroy();
+    },
+  },
+  {
+    name: 'choosing a sibling steps sideways rather than deeper',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      await h.openRow('Work');
+      await settle();
+      h.host.querySelector<HTMLElement>('.kibaos-chevron[data-chevron="1"]')!
+          .click();
+      await settle();
+      const play = [...h.host.querySelectorAll<HTMLElement>('.kibaos-path-option')]
+                       .find(node => node.textContent === 'Play')!;
+      play.click();
+      await settle();
+      equal(h.crumbs().join('/'), 'Home/Documents/Play',
+            'a sibling became a child');
+      h.destroy();
+    },
+  },
+  {
+    name: 'escape closes the popover and gives focus back',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      const chevron = h.host.querySelector<HTMLElement>(
+          '.kibaos-chevron[data-chevron="0"]')!;
+      chevron.click();
+      await settle();
+      assert(h.host.querySelector('.kibaos-path-popover'), 'it did not open');
+      chevron.dispatchEvent(new KeyboardEvent(
+          'keydown', {key: 'Escape', bubbles: true, cancelable: true}));
+      await settle();
+      equal(h.host.querySelector('.kibaos-path-popover'), null,
+            'escape left it open');
+      equal(document.activeElement, chevron,
+            'focus was dropped on the document instead of the chevron');
+      h.destroy();
+    },
+  },
+  {
+    name: 'a chevron says which folder it is about to list',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      const chevrons =
+          [...h.host.querySelectorAll<HTMLElement>('.kibaos-chevron')]
+              .map(node => node.getAttribute('aria-label'));
+      assert(chevrons.includes('What else is in Home'),
+             `chevrons are unnamed or identical: ${JSON.stringify(chevrons)}`);
+      assert(chevrons.includes('What else is in Documents'),
+             `the deepest level has no chevron: ${JSON.stringify(chevrons)}`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'the popover is actually on screen and not clipped away',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      h.host.querySelector<HTMLElement>('.kibaos-chevron[data-chevron="0"]')!
+          .click();
+      await settle();
+      const option =
+          h.host.querySelector<HTMLElement>('.kibaos-path-option')!;
+      assert(option, 'no options were rendered');
+      const box = option.getBoundingClientRect();
+      assert(box.width > 0 && box.height > 0, 'the option has no size');
+      // A rect is reported whether or not an ancestor clips it, so the rect
+      // alone proves nothing. Hit testing is what a person actually does, and
+      // it is what an overflow:hidden ancestor breaks: the popover lived inside
+      // the path bar, which clips, and was sliced off at the height of the
+      // toolbar while still reporting its full size.
+      const hit = document.elementFromPoint(
+          Math.round(box.left + box.width / 2),
+          Math.round(box.top + box.height / 2));
+      assert(hit === option || option.contains(hit),
+             `something else is at the option's own centre: ${
+                 hit ? (hit as HTMLElement).className : 'nothing'}`);
+      // Visible is not the same as in the right place. The offsets are
+      // computed in script against the toolbar's box, so if the toolbar stops
+      // being the containing block the popover is still perfectly hittable and
+      // simply lands somewhere else entirely.
+      const popover = h.host.querySelector<HTMLElement>('.kibaos-path-popover')!;
+      const chevron = h.host.querySelector<HTMLElement>(
+          '.kibaos-chevron[data-chevron="0"]')!;
+      const bar = h.host.querySelector<HTMLElement>('.kibaos-toolbar')!;
+      const popoverBox = popover.getBoundingClientRect();
+      const chevronBox = chevron.getBoundingClientRect();
+      assert(Math.abs(popoverBox.left - chevronBox.left) <= 2,
+             `the popover opened ${
+                 Math.round(popoverBox.left - chevronBox.left)}px away from its chevron`);
+      assert(popoverBox.top >= bar.getBoundingClientRect().bottom - 1,
+             'the popover opened over the toolbar rather than below it');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the glyph buttons have names, not just pictures',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      for (const kind of ['back', 'forward', 'up']) {
+        const label = h.tool(kind).getAttribute('aria-label') ?? '';
+        assert(label.trim().length > 0,
+               `the ${kind} button is announced as "button" and nothing else`);
+      }
+      h.destroy();
+    },
+  },
+  {
+    name: 'a folder with nothing beside it says so rather than opening empty',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      await h.openRow('Work');
+      await settle();
+      // Work has no subfolders, so its own chevron has nothing to offer.
+      h.host.querySelector<HTMLElement>('.kibaos-chevron[data-chevron="2"]')!
+          .click();
+      await settle();
+      const message =
+          h.host.querySelector('.kibaos-path-popover-empty')?.textContent ?? '';
+      assert(message.length > 0, 'an empty popover opened with nothing in it');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the status bar says what is in the folder',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      const text = h.status();
+      // Two folders (Documents, Photos) and six files.
+      assert(/folders/.test(text) && /files/.test(text),
+             `the summary does not describe the folder: "${text}"`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'it shows how much room is left on the drive you are on',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      equal(h.freeSpace(), '8.0 GB free', 'the free space is wrong or absent');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the drive does not change just because you opened a folder',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      await h.openRow('Documents');
+      await settle(10);
+      equal(h.freeSpace(), '8.0 GB free',
+            'going one folder down lost track of which drive you are on');
+      h.destroy();
+    },
+  },
+  {
+    name: 'selecting something replaces the count with the selection',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      h.clickRow('home-0.txt');
+      await settle();
+      const text = h.status();
+      assert(/1 item selected/.test(text),
+             `the selection is not reported: "${text}"`);
+      assert(!/1 items selected/.test(text), 'the plural rule broke at one');
+      h.destroy();
+    },
+  },
+  {
+    name: 'a total is given only when every size is actually known',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      // A small folder fits in one window, so every size has arrived and the
+      // total is real.
+      assert(/\d+(\.\d+)? (bytes|KB|MB|GB)/.test(h.status()),
+             `a small folder should total up: "${h.status()}"`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'a huge directory is not given a total assembled from one screen',
+    run: async () => {
+      const backend = backendWith(0);
+      for (let i = 0; i < 20_000; i++) {
+        backend.add(ROOT, `bulk-${i}.txt`, false, {size: 1024});
+      }
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle(12);
+      const text = h.status();
+      // Sizes exist for the forty rows on screen and for nothing else. A total
+      // built from those grows as you scroll and is wrong until the very end,
+      // which is worse than no total because it looks like an answer.
+      assert(!/(bytes|KB|MB|GB)/.test(text),
+             `it totalled up one screen and called it the folder: "${text}"`);
+      assert(/20,?000 files|20000 files/.test(text),
+             `and it should still say how many there are: "${text}"`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'the free space bar is not read out as well as the words',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      const track = h.host.querySelector('.kibaos-status-track')!;
+      equal(track.getAttribute('aria-hidden'), 'true',
+            'the bar repeats what the sentence already said');
+      h.destroy();
+    },
+  },
+  {
+    name: 'somewhere with no notion of free space shows none',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      const recent = [...h.host.querySelectorAll<HTMLElement>('.kibaos-place')]
+                         .find(button =>
+                                   button.querySelector('.kibaos-place-label')
+                                       ?.textContent === 'Recent')!;
+      recent.click();
+      await settle(10);
+      equal(h.freeSpace(), null,
+            'Recent is not a drive and has no free space to report');
+      h.destroy();
+    },
+  },
+  {
+    name: 'a huge directory does not stat every entry to fill one screen',
+    run: async () => {
+      const backend = backendWith(0);
+      for (let i = 0; i < 20_000; i++) {
+        backend.add(ROOT, `bulk-${i}.txt`, false, {size: 1024});
+      }
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle(10);
+      assert(h.port.metadataKeys > 0, 'no metadata was fetched at all');
+      assert(h.port.metadataKeys < 200,
+             `asked for ${h.port.metadataKeys} of 20,000 records to fill one screen`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'sizes appear on the rows once they arrive',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      const text = [...h.host.querySelectorAll<HTMLElement>('.kibaos-row')]
+                       .map(row => row.textContent ?? '')
+                       .join(' ');
+      assert(/\d\s?(bytes|KB|MB|GB)/.test(text),
+             `no size reached the rows: ${text.slice(0, 160)}`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'a folder that cannot be read does not claim to be empty',
+    run: async () => {
+      const backend = backendWith();
+      backend.setFailure(
+          ROOT, new FilesError('permission-denied', 'nope'));
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle();
+      const title =
+          h.host.querySelector('.kibaos-empty-title')?.textContent ?? '';
+      assert(title.length > 0, 'nothing was said at all');
+      assert(!/empty/i.test(title),
+             `a refused folder was reported as empty: ${title}`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'places that cannot be read say so instead of a blank frame',
+    run: async () => {
+      const backend = backendWith();
+      backend.volumes = () => Promise.reject(new FilesError('io', 'no'));
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle();
+      const notice = h.notice();
+      assert(notice && notice.length > 0,
+             'the window came up blank with no explanation');
+      equal(h.places().length, 0, 'places appeared from somewhere');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the notice is announced without interrupting',
+    run: async () => {
+      const backend = backendWith();
+      backend.volumes = () => Promise.reject(new FilesError('io', 'no'));
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle();
+      const notice = h.host.querySelector('.kibaos-shell-notice')!;
+      equal(notice.getAttribute('role'), 'status',
+            'a notice this mild should not be an alert');
+      h.destroy();
+    },
+  },
+];
+
+export async function runShellDomTests(): Promise<DomResult[]> {
+  const results: DomResult[] = [];
+  for (const testCase of CASES) {
+    try {
+      await testCase.run();
+      results.push({name: testCase.name, ok: true});
+    } catch (error) {
+      results.push({
+        name: testCase.name,
+        ok: false,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  return results;
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/dom/sidebar_test.ts b/ui/file_manager/file_manager/kibaos/tests/dom/sidebar_test.ts
