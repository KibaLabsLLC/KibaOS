+/**
+ * A ChromeOS shaped fake, for running the contract against the real adapter.
+ *
+ * The point of this file is to be awkward in the same ways the real thing is,
+ * not convenient. So `createReader` hands back a few entries at a time and only
+ * signals the end with an empty array, `getMetadata` answers positionally and
+ * only for the names it was asked for, failures arrive as objects with
+ * DOMException names rather than as our own error type, and a change event says
+ * only that a directory changed.
+ *
+ * That last one used to be optional here, on the belief that ChromeOS was
+ * merely allowed to be vague. Probing a live renderer on 2026-09-03 showed it
+ * is always vague: there is no list of changed files on any event, so the fake
+ * no longer offers a mode that produces one.
+ *
+ * It proves the adapter translates correctly. It cannot prove this description
+ * of ChromeOS is right, and only the hardware can do that.
+ */
+import type {Platform, PlatformDirectoryReader, PlatformEntry, PlatformFileTask, PlatformIoProgress, PlatformIoType, PlatformLaunchDialog, PlatformMetadata, PlatformResultingTasks, PlatformTaskDescriptor, PlatformVolume, PlatformWatchEvent} from '../../adapter/platform.js';
+
+class FakeEntry implements PlatformEntry {
+  constructor(
+      readonly name: string, readonly isDirectory: boolean,
+      private readonly url: string) {}
+  toURL(): string {
+    return this.url;
+  }
+}
+
+interface Node {
+  entry: FakeEntry;
+  parent: string|null;
+  children: string[];
+  metadata: PlatformMetadata;
+}
+
+/** Thrown the way the platform throws: a name, not a type of ours. */
+function domError(name: string): Error {
+  const error = new Error(name);
+  error.name = name;
+  return error;
+}
+
+export interface FakeOptions {
+  /** Entries per readEntries call. Small on purpose, so paging is exercised. */
+  readonly chunk?: number;
+}
+
+export class FakePlatform implements Platform {
+  private readonly nodes = new Map<string, Node>();
+  private readonly volumeList: PlatformVolume[] = [];
+  private readonly sizes = new Map<string, {totalSize: number, remainingSize: number}>();
+  private readonly listeners = new Set<(event: PlatformWatchEvent) => void>();
+  /**
+   * Two kinds of failure, because they are two different things. A file can
+   * exist, resolve and read perfectly well and still refuse to be moved.
+   * Conflating them made an io failure arrive as a rejection from startIo
+   * rather than as a failed progress report, which is not how the API behaves.
+   */
+  private readonly resolveFailures = new Map<string, string>();
+  private readonly operationFailures = new Map<string, string>();
+  readonly watched = new Set<string>();
+  /** Every name list getMetadata was asked for, so a test can check batching. */
+  readonly metadataCalls: Array<readonly string[]> = [];
+  private readonly ioListeners = new Set<(progress: PlatformIoProgress) => void>();
+  private readonly cancelled = new Set<number>();
+  private nextTask = 1;
+  /** What executeTask was last asked to run, so a test can check the decode. */
+  ran: {descriptor: PlatformTaskDescriptor, count: number}|null = null;
+  /** Set to answer getLaunchDialog with something other than null. */
+  launchDialog: PlatformLaunchDialog|null = null;
+  /** What the last getFileTasks was told, so the contract can check it. */
+  dlpSourceUrls: string[] = [];
+  /** What the last selectFiles was told about needing a real path. */
+  selectedLocalPathOnly: boolean|null = null;
+  readonly selected: string[] = [];
+  dialogCancelled = false;
+  /** Set to make executeTask answer with a failure rather than reject. */
+  taskResult = 'opened';
+
+  constructor(private readonly options: FakeOptions = {}) {}
+
+  addVolume(volume: {
+    volumeId: string,
+    volumeType: string,
+    label: string,
+    url: string,
+    isReadOnly?: boolean,
+    sizeStats?: {totalSize: number, remainingSize: number},
+  }): this {
+    const root = new FakeEntry(volume.label, true, volume.url);
+    this.nodes.set(volume.url, {entry: root, parent: null, children: [], metadata: {}});
+    this.volumeList.push({
+      volumeId: volume.volumeId,
+      volumeType: volume.volumeType,
+      label: volume.label,
+      isReadOnly: volume.isReadOnly ?? false,
+      root,
+    });
+    if (volume.sizeStats) {
+      this.sizes.set(volume.volumeId, volume.sizeStats);
+    }
+    return this;
+  }
+
+  add(parentUrl: string, name: string, isDirectory: boolean,
+      metadata: PlatformMetadata = {}): string {
+    const parent = this.nodes.get(parentUrl);
+    if (!parent) {
+      throw new Error(`no such parent ${parentUrl}`);
+    }
+    const url = `${parentUrl.replace(/\/$/, '')}/${name}`;
+    this.nodes.set(
+        url,
+        {entry: new FakeEntry(name, isDirectory, url), parent: parentUrl,
+         children: [], metadata});
+    parent.children.push(url);
+    this.notify(parentUrl);
+    return url;
+  }
+
+  remove(url: string): void {
+    const node = this.nodes.get(url);
+    if (!node) {
+      return;
+    }
+    this.nodes.delete(url);
+    if (node.parent) {
+      const parent = this.nodes.get(node.parent);
+      if (parent) {
+        parent.children = parent.children.filter(child => child !== url);
+      }
+      this.notify(node.parent);
+    }
+  }
+
+  /** Makes resolving or reading this url fail, by DOMException name. */
+  failResolve(url: string, domExceptionName: string): void {
+    this.resolveFailures.set(url, domExceptionName);
+  }
+
+  /** Makes operations on this url fail, while it still resolves and reads. */
+  failOperation(url: string, domExceptionName: string): void {
+    this.operationFailures.set(url, domExceptionName);
+  }
+
+  /**
+   * An add and a delete are indistinguishable here, because they are on the
+   * real thing: both arrive as the same two keys naming the directory.
+   */
+  private notify(directoryUrl: string): void {
+    const directory = this.nodes.get(directoryUrl);
+    if (!directory) {
+      return;
+    }
+    const event: PlatformWatchEvent = {
+      entry: directory.entry,
+      eventType: 'changed',
+    };
+    for (const listener of [...this.listeners]) {
+      listener(event);
+    }
+  }
+
+  async resolve(url: string): Promise<PlatformEntry> {
+    const failure = this.resolveFailures.get(url);
+    if (failure) {
+      throw domError(failure);
+    }
+    const node = this.nodes.get(url);
+    if (!node) {
+      throw domError('NotFoundError');
+    }
+    return node.entry;
+  }
+
+  createReader(directory: PlatformEntry): PlatformDirectoryReader {
+    const url = directory.toURL();
+    const chunk = this.options.chunk ?? 3;
+    let offset = 0;
+    let exhausted = false;
+    return {
+      readEntries: async () => {
+        const failure = this.resolveFailures.get(url);
+        if (failure) {
+          throw domError(failure);
+        }
+        if (exhausted) {
+          return [];
+        }
+        const node = this.nodes.get(url);
+        if (!node) {
+          throw domError('NotFoundError');
+        }
+        const slice = node.children.slice(offset, offset + chunk);
+        offset += slice.length;
+        if (!slice.length) {
+          exhausted = true;
+          return [];
+        }
+        return slice.map(child => this.nodes.get(child)!.entry);
+      },
+    };
+  }
+
+  async getMetadata(
+      entries: readonly PlatformEntry[],
+      names: readonly string[]): Promise<readonly PlatformMetadata[]> {
+    this.metadataCalls.push(names.slice());
+    // Positionally, and carrying whatever it happens to have cached.
+    //
+    // Deliberately more than was asked for. MetadataModel is a cache in front
+    // of several providers, so a MetadataItem can arrive holding fields nobody
+    // requested on this call. A fake that returns exactly the requested names
+    // makes the adapter's own filter look load bearing when it is not, and a
+    // mutation removing that filter escaped for precisely that reason.
+    return entries.map(
+        entry => (this.nodes.get(entry.toURL())?.metadata ?? {}));
+  }
+
+  async listVolumes(): Promise<readonly PlatformVolume[]> {
+    return this.volumeList.slice();
+  }
+
+  async getSizeStats(volumeId: string):
+      Promise<{totalSize: number, remainingSize: number}|null> {
+    return this.sizes.get(volumeId) ?? null;
+  }
+
+  async addFileWatch(entry: PlatformEntry): Promise<void> {
+    this.watched.add(entry.toURL());
+  }
+
+  async removeFileWatch(entry: PlatformEntry): Promise<void> {
+    this.watched.delete(entry.toURL());
+  }
+
+  onDirectoryChanged(listener: (event: PlatformWatchEvent) => void): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  async searchFiles(params: {
+    /**
+     * Where to search. Absent means everywhere.
+     *
+     * Absent, never null. The bindings declare it optional and a null is not
+     * the same thing as an omission to them. Nothing ever passed one, so this
+     * was a wrong description rather than a live defect, and it was invisible
+     * until `kibaos/` was compiled against the app's own definitions.
+     */
+    rootDir?: PlatformEntry,
+    query: string,
+    types: 'ALL'|'EXCLUDE_DIRECTORIES'|'OFFLINE'|'SHARED_WITH_ME',
+    maxResults: number,
+  }): Promise<readonly PlatformEntry[]> {
+    // The bindings refuse the call outright when either is missing, so refusing
+    // it here too is the difference between the contract catching that and the
+    // hardware catching it.
+    if (params.maxResults === undefined || params.types === undefined) {
+      throw domError('TypeError');
+    }
+    const start = params.rootDir?.toURL();
+    const needle = params.query.toLowerCase();
+    const found: PlatformEntry[] = [];
+    const walk = (url: string) => {
+      const node = this.nodes.get(url);
+      if (!node || found.length >= params.maxResults) {
+        return;
+      }
+      if (url !== start && node.entry.name.toLowerCase().includes(needle)) {
+        found.push(node.entry);
+      }
+      for (const child of node.children) {
+        walk(child);
+      }
+    };
+    if (start) {
+      walk(start);
+    }
+    // Capped, the way the real one is: maxResults is not optional there.
+    return found.slice(0, params.maxResults);
+  }
+
+  async getFileTasks(
+      entries: readonly PlatformEntry[],
+      dlpSourceUrls: readonly string[]): Promise<PlatformResultingTasks> {
+    // Two arguments, not one. Called with one the real bindings answer "No
+    // matching signature", so this refuses it rather than defaulting.
+    if (dlpSourceUrls === undefined) {
+      throw domError('TypeError');
+    }
+    this.dlpSourceUrls = [...dlpSourceUrls];
+    if (!entries.length) {
+      return {tasks: []};
+    }
+    const tasks: PlatformFileTask[] = [
+      {
+        descriptor: {appId: 'text-app', taskType: 'app', actionId: 'open'},
+        title: 'Text',
+        isDefault: true,
+      },
+      {
+        // A pipe inside the action id on purpose. The id is encoded by joining
+        // the triple with pipes, so a naive split loses everything after it.
+        descriptor: {appId: 'viewer', taskType: 'web', actionId: 'view|raw'},
+        title: 'Viewer',
+      },
+    ];
+    // Wrapped, the way the real one wraps it.
+    return {tasks};
+  }
+
+  async executeTask(
+      descriptor: PlatformTaskDescriptor,
+      entries: readonly PlatformEntry[]): Promise<string> {
+    // A descriptor naming an app that was never offered is not something the
+    // platform quietly runs. Accepting anything made the fake kinder than the
+    // real thing, which is the direction that hides a bad task id rather than
+    // finding it.
+    if (descriptor.appId !== 'text-app' && descriptor.appId !== 'viewer') {
+      throw domError('NotFoundError');
+    }
+    this.ran = {descriptor, count: entries.length};
+    return this.taskResult;
+  }
+
+  private emitIo(progress: PlatformIoProgress): void {
+    for (const listener of [...this.ioListeners]) {
+      listener(progress);
+    }
+  }
+
+  async startIoTask(
+      type: PlatformIoType, entries: readonly PlatformEntry[],
+      _params: {destinationFolder?: PlatformEntry}): Promise<number> {
+    const taskId = this.nextTask++;
+    const total = Math.max(1, entries.length) * 1000;
+    const failure =
+        entries.map(entry => this.operationFailures.get(entry.toURL()))
+            .find(Boolean);
+    const base = {
+      taskId,
+      type,
+      totalBytes: total,
+      sourceName: entries[0]?.name ?? '',
+      itemCount: entries.length,
+    };
+    this.emitIo({
+      ...base,
+      state: 'queued',
+      bytesTransferred: 0,
+      numRemainingItems: entries.length,
+    });
+    const tick = () => new Promise(resolve => setTimeout(resolve, 0));
+    void (async () => {
+      await tick();
+      if (this.cancelled.has(taskId)) {
+        this.emitIo({...base, state: 'cancelled', bytesTransferred: 0,
+                     numRemainingItems: entries.length});
+        return;
+      }
+      this.emitIo({...base, state: 'in_progress', bytesTransferred: total / 2,
+                   numRemainingItems: Math.max(0, entries.length - 1)});
+      await tick();
+      if (this.cancelled.has(taskId)) {
+        this.emitIo({...base, state: 'cancelled', bytesTransferred: total / 2,
+                     numRemainingItems: 1});
+        return;
+      }
+      if (failure) {
+        // An error arrives as a name on the status, not as a rejection.
+        this.emitIo({...base, state: 'error', bytesTransferred: total / 2,
+                     numRemainingItems: 1, errorName: failure});
+        return;
+      }
+      this.emitIo({...base, state: 'success', bytesTransferred: total,
+                   numRemainingItems: 0});
+    })();
+    return taskId;
+  }
+
+  /** Emits a status verbatim, for states a normal run never produces. */
+  emitRawIo(progress: PlatformIoProgress): void {
+    this.emitIo(progress);
+  }
+
+  cancelIoTask(taskId: number): void {
+    this.cancelled.add(taskId);
+  }
+
+  onIoProgress(listener: (progress: PlatformIoProgress) => void): () => void {
+    this.ioListeners.add(listener);
+    return () => this.ioListeners.delete(listener);
+  }
+
+  async getLaunchDialog(): Promise<PlatformLaunchDialog|null> {
+    return this.launchDialog;
+  }
+
+  async selectFiles(paths: readonly string[], shouldReturnLocalPath: boolean):
+      Promise<void> {
+    if (shouldReturnLocalPath === undefined) {
+      throw domError('TypeError');
+    }
+    this.selected.push(...paths);
+    this.selectedLocalPathOnly = shouldReturnLocalPath;
+  }
+
+  cancelDialog(): void {
+    this.dialogCancelled = true;
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/adapter/run_adapter.ts b/ui/file_manager/file_manager/kibaos/tests/adapter/run_adapter.ts
