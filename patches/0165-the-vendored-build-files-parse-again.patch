@@ -0,0 +1,18 @@
+/**
+ * What the suite is in the middle of.
+ *
+ * Only read by the watchdog. A hanging test cannot report its own failure,
+ * because it never finishes, so without this the only thing anybody learns is
+ * that something somewhere stopped. That is enough to fail a run and not enough
+ * to fix one, and it is also not enough for the mutation gate to attribute the
+ * hang to the test that was supposed to catch it.
+ */
+let inFlight = 'nothing yet';
+
+export function beginCheck(label: string): void {
+  inFlight = label;
+}
+
+export function currentCheck(): string {
+  return inFlight;
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/run.sh b/ui/file_manager/file_manager/kibaos/tests/run.sh
new file mode 100755
index 0000000000..1002a0c85f
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/run.sh
@@ -0,0 +1,47 @@
+#!/bin/bash
+# The local loop. No ChromeOS session, no pak, no Dell.
+#
+# One tool: tsc checks and emits. esbuild would be faster but this tree ships it
+# without its platform binary, and at this size the difference is a second. The
+# imports carry .js specifiers, so node runs the emitted tree directly with no
+# bundler in the way.
+set -uo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+KIBAOS="$(dirname "$HERE")"
+SRC="$(cd "$KIBAOS/../../../.." && pwd)"
+NODE="$SRC/third_party/node/linux/node-linux-x64/bin/node"
+TSC="$SRC/third_party/node/node_modules/typescript/bin/tsc"
+OUT="$(mktemp -d)"
+trap 'rm -rf "$OUT"' EXIT
+
+fail() { printf 'kibaos port contract: %s\n' "$*" >&2; exit 1; }
+[ -x "$NODE" ] || fail "node not found at $NODE"
+[ -f "$TSC" ] || fail "tsc not found at $TSC"
+
+# skipLibCheck applies to the shipped .d.ts files only: lib.dom.d.ts refers to
+# TrustedHTML, which needs a package this tree does not put on our path. Our own
+# sources are still checked in full, and --strict stays on.
+# The generated module and the stylesheet it came from cannot be allowed to
+# drift, and this is the loop that runs every time.
+"$KIBAOS"/tools/gen_tokens.py --check || fail "ui/tokens_css.ts is stale"
+
+echo "==> check and emit"
+# noUnusedLocals and noUnusedParameters because the Files app's own tsconfig
+# sets them, and the first time this code was compiled by the real build it
+# failed on two declarations this invocation was happy to ignore. A local loop
+# that is laxer than the build it feeds is a local loop that hands you a
+# surprise at the worst moment.
+"$NODE" "$TSC" --strict --skipLibCheck --noUnusedLocals --noUnusedParameters \
+  --target es2022 --module es2022 \
+  --moduleResolution bundler --lib es2022,dom \
+  --rootDir "$KIBAOS" --outDir "$OUT" \
+  "$KIBAOS"/port/*.ts "$KIBAOS"/session/*.ts "$KIBAOS"/ui/*.ts "$KIBAOS"/adapter/*.ts \
+  "$KIBAOS"/app/*.ts \
+  "$KIBAOS"/tests/contract/*.ts "$KIBAOS"/tests/session/*.ts \
+  "$KIBAOS"/tests/ui/*.ts "$KIBAOS"/tests/adapter/*.ts \
+  || fail "the types do not check"
+
+printf '{"type":"module"}' > "$OUT/package.json"
+echo "==> run"
+"$NODE" "$OUT/tests/contract/run_mock.js" || fail "the contract did not pass"
+echo "kibaos port contract: PASS"
diff --git a/ui/file_manager/file_manager/kibaos/tests/session/session_test.ts b/ui/file_manager/file_manager/kibaos/tests/session/session_test.ts
new file mode 100644
index 0000000000..1ad1af4525
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/session/session_test.ts
@@ -0,0 +1,194 @@
+/** Tests for the per pane browsing context. */
+import type {MockOptions} from '../../port/mock_backend.js';
+import {MockBackend} from '../../port/mock_backend.js';
+import type {FileKey} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import {NavigationSession} from '../../session/navigation_session.js';
+
+const ROOT = asFileKey('mock://myfiles');
+
+function backendWithRoot(options: MockOptions = {}): MockBackend {
+  const backend = new MockBackend(options);
+  backend.addVolume({
+    id: 'system',
+    root: ROOT,
+    label: 'My files',
+    kind: 'system',
+    removable: false,
+    readOnly: false,
+    capacity: {total: 512e9, free: 8.7e9},
+  });
+  return backend;
+}
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(`${message}: expected ${expected}, got ${actual}`);
+  }
+}
+
+interface Case {
+  name: string;
+  run(): Promise<void>;
+}
+
+const CASES: Case[] = [
+  {
+    name: 'navigating populates the pane and clears loading',
+    async run() {
+      const backend = backendWithRoot();
+      backend.add(ROOT, 'one.txt', false);
+      backend.add(ROOT, 'two.txt', false);
+      const session = new NavigationSession('pane-a', backend);
+      await session.navigate(ROOT);
+      const state = session.snapshot();
+      equal(state.entries.length, 2, 'entry count');
+      equal(state.loading, false, 'loading finished');
+      equal(state.error, null, 'no error');
+      session.dispose();
+    },
+  },
+  {
+    name: 'a change that lands during the listing is not lost',
+    async run() {
+      // The whole reason watching starts before listing.
+      //
+      // The entry has to appear after the listing has snapshotted the
+      // directory, or the listing simply contains it and the assertion is
+      // answered by the wrong thing. One entry per page plus latency gives a
+      // real window: the addition lands between pages, so it cannot be in the
+      // listing and only the buffered replay can deliver it.
+      const backend = backendWithRoot({pageSize: 1, latencyMs: 5});
+      for (let i = 0; i < 3; i++) {
+        backend.add(ROOT, `pre${i}.txt`, false);
+      }
+      const session = new NavigationSession('pane-a', backend);
+      let injected = false;
+      const stop = session.subscribe(state => {
+        if (!injected && state.entries.length === 1) {
+          injected = true;
+          backend.add(ROOT, 'during.txt', false);
+        }
+      });
+      await session.navigate(ROOT);
+      stop();
+      assert(injected, 'the test never reached the window it meant to test');
+      const names = session.snapshot().entries.map(e => e.name);
+      assert(
+          names.includes('during.txt'),
+          `the entry added mid listing is missing: ${names.join(', ')}`);
+      session.dispose();
+    },
+  },
+  {
+    name: 'navigating again abandons the first listing',
+    async run() {
+      const backend = backendWithRoot();
+      const other = backend.add(ROOT, 'other', true) as FileKey;
+      backend.add(ROOT, 'root-file.txt', false);
+      backend.add(other, 'inner.txt', false);
+      backend.setLatency(15);
+      const session = new NavigationSession('pane-a', backend);
+      const first = session.navigate(ROOT);
+      await new Promise(resolve => setTimeout(resolve, 3));
+      backend.setLatency(0);
+      await session.navigate(other);
+      await first;
+      const state = session.snapshot();
+      equal(state.current, other, 'the pane is on the second directory');
+      const names = state.entries.map(e => e.name);
+      assert(
+          !names.includes('root-file.txt'),
+          `the abandoned listing bled through: ${names.join(', ')}`);
+      session.dispose();
+    },
+  },
+  {
+    name: 'two panes hold independent selections',
+    async run() {
+      const backend = backendWithRoot();
+      const a = backend.add(ROOT, 'a.txt', false);
+      backend.add(ROOT, 'b.txt', false);
+      const left = new NavigationSession('left', backend);
+      const right = new NavigationSession('right', backend);
+      await left.navigate(ROOT);
+      await right.navigate(ROOT);
+      left.select(a);
+      equal(left.snapshot().selection.size, 1, 'left has a selection');
+      equal(right.snapshot().selection.size, 0, 'right is untouched');
+      left.dispose();
+      right.dispose();
+    },
+  },
+  {
+    name: 'a range selection is resolved over indices',
+    async run() {
+      const backend = backendWithRoot();
+      const keys: FileKey[] = [];
+      for (let i = 0; i < 10; i++) {
+        keys.push(backend.add(ROOT, `f${i}.txt`, false));
+      }
+      const session = new NavigationSession('pane-a', backend);
+      await session.navigate(ROOT);
+      session.select(keys[2]!);
+      session.select(keys[6]!, 'range');
+      equal(session.snapshot().selection.size, 5, 'inclusive range of five');
+      session.dispose();
+    },
+  },
+  {
+    name: 'a removed entry drops out of the selection',
+    async run() {
+      const backend = backendWithRoot();
+      const doomed = backend.add(ROOT, 'doomed.txt', false);
+      const session = new NavigationSession('pane-a', backend);
+      await session.navigate(ROOT);
+      session.select(doomed);
+      equal(session.snapshot().selection.size, 1, 'selected to begin with');
+      backend.remove(doomed);
+      await new Promise(resolve => setTimeout(resolve, 5));
+      equal(session.snapshot().selection.size, 0, 'selection dropped it');
+      assert(
+          !session.snapshot().entries.some(e => e.key === doomed),
+          'the row is gone too');
+      session.dispose();
+    },
+  },
+  {
+    name: 'opening something that is not there reports it rather than hanging',
+    async run() {
+      const backend = backendWithRoot();
+      const session = new NavigationSession('pane-a', backend);
+      await session.navigate(asFileKey('mock://nowhere'));
+      const state = session.snapshot();
+      equal(state.loading, false, 'loading finished');
+      assert(!!state.error, 'an error is reported');
+      equal(state.error!.code, 'not-found', 'the error is typed');
+      session.dispose();
+    },
+  },
+];
+
+export async function runSessionTests(): Promise<boolean> {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const testCase of CASES) {
+    try {
+      await testCase.run();
+      passed++;
+    } catch (error) {
+      failures.push(
+          `  FAIL ${testCase.name}\n       ${
+              error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`NavigationSession: ${passed}/${CASES.length} passed`);
+  failures.forEach(line => console.log(line));
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/ui/format_test.ts b/ui/file_manager/file_manager/kibaos/tests/ui/format_test.ts
new file mode 100644
index 0000000000..d9a368513e
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/ui/format_test.ts
@@ -0,0 +1,106 @@
+/** The grammar and the arithmetic, which is where most of the craft lives. */
+import {formatCount, formatDate, formatSelection, formatSize, kindOf, labelForKind} from '../../ui/format.js';
+
+class AssertionError extends Error {}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${JSON.stringify(expected)}, got ${
+            JSON.stringify(actual)}`);
+  }
+}
+
+interface Case {
+  name: string;
+  run(): void;
+}
+
+/** A fixed clock, so "yesterday" does not depend on when the suite runs. */
+const NOW = new Date('2026-09-02T15:30:00').getTime();
+const minutes = (n: number) => NOW - n * 60_000;
+const days = (n: number) => NOW - n * 86_400_000;
+
+const CASES: Case[] = [
+  {
+    name: 'sizes never claim a precision they do not have',
+    run() {
+      equal(formatSize(512), '512 bytes', 'bytes stay exact');
+      equal(formatSize(1024), '1.0 KB', 'one kibibyte');
+      equal(formatSize(1536), '1.5 KB', 'one and a half');
+      equal(formatSize(1024 * 1024 * 2.44), '2.4 MB', 'three significant figures');
+      equal(formatSize(1024 * 1024 * 512), '512 MB', 'no decimal above ten');
+      equal(formatSize(undefined), '', 'nothing is not zero');
+    },
+  },
+  {
+    name: 'counts are written the way somebody would say them',
+    run() {
+      equal(formatCount(0, 1), '1 file', 'never 1 file(s)');
+      equal(formatCount(1, 0), '1 folder', 'singular folder');
+      equal(formatCount(3, 2), '3 folders and 2 files', 'both halves');
+      equal(formatCount(0, 0), 'Nothing here yet', 'never 0 files');
+      equal(formatSelection(0), 'No items selected', 'never 0 selected');
+      equal(formatSelection(1), '1 item selected', 'singular selection');
+    },
+  },
+  {
+    name: 'dates age the way somebody would say them',
+    run() {
+      equal(formatDate(NOW - 5_000, NOW), 'Just now', 'under a minute');
+      equal(formatDate(minutes(1), NOW), '1 minute ago', 'singular minute');
+      equal(formatDate(minutes(14), NOW), '14 minutes ago', 'plural minutes');
+      const today = formatDate(NOW - 3 * 3_600_000, NOW);
+      equal(today.startsWith('Today at '), true, `today: got ${today}`);
+      const yesterday = formatDate(days(1), NOW);
+      equal(
+          yesterday.startsWith('Yesterday at '), true,
+          `yesterday: got ${yesterday}`);
+      const thisYear = formatDate(days(30), NOW);
+      equal(
+          /^[A-Z][a-z]+day/.test(thisYear), true,
+          `this year names the weekday: got ${thisYear}`);
+      const older = formatDate(new Date('2025-05-12T09:00:00').getTime(), NOW);
+      equal(older.includes('2025'), true, `older carries the year: got ${older}`);
+      equal(formatDate(undefined, NOW), '', 'nothing is not the epoch');
+    },
+  },
+  {
+    name: 'an Arch package is recognised by the half that matters',
+    run() {
+      equal(
+          kindOf('linux-6.18.2-1-x86_64.pkg.tar.zst', false), 'package',
+          'the compound extension wins over the tail');
+      equal(labelForKind('package'), 'Package', 'and it is labelled as one');
+      equal(kindOf('notes.tar.zst', false), 'archive', 'a plain archive is not');
+    },
+  },
+  {
+    name: 'file kinds come off the extension, and a folder is a folder',
+    run() {
+      equal(kindOf('anything', true), 'folder', 'directories short circuit');
+      equal(kindOf('holiday.JPEG', false), 'image', 'case does not matter');
+      equal(kindOf('main.ts', false), 'code', 'source is code');
+      equal(kindOf('README', false), 'file', 'no extension is just a file');
+      equal(kindOf('trailing.', false), 'file', 'an empty extension is not a kind');
+      equal(kindOf('.bashrc', false), 'file', 'a leading dot is not an extension');
+    },
+  },
+];
+
+export function runFormatTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const testCase of CASES) {
+    try {
+      testCase.run();
+      passed++;
+    } catch (error) {
+      failures.push(
+          `  FAIL ${testCase.name}\n       ${
+              error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`format: ${passed}/${CASES.length} passed`);
+  failures.forEach(line => console.log(line));
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/ui/history_test.ts b/ui/file_manager/file_manager/kibaos/tests/ui/history_test.ts
new file mode 100644
index 0000000000..253762dfce
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/ui/history_test.ts
@@ -0,0 +1,129 @@
+/** Back, forward, and the trail. */
+import {asFileKey} from '../../port/types.js';
+import type {Trail, Visit} from '../../ui/history.js';
+import {History} from '../../ui/history.js';
+
+function visit(name: string): Visit {
+  return {key: asFileKey(`mock://${name}`), label: name};
+}
+function labels(trail: Trail|null): string {
+  return trail ? trail.map(step => step.label).join('/') : 'null';
+}
+
+class AssertionError extends Error {}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+const HOME: Trail = [visit('home')];
+const DOCS: Trail = [visit('home'), visit('docs')];
+const WORK: Trail = [visit('home'), visit('docs'), visit('work')];
+
+interface Check {
+  name: string;
+  run(): void;
+}
+
+const CHECKS: Check[] = [
+  {
+    name: 'nothing to go back to at the start',
+    run() {
+      const history = new History();
+      equal(history.canGoBack(), false, 'back');
+      equal(history.canGoForward(), false, 'forward');
+      equal(history.current(), null, 'current');
+      equal(history.back(), null, 'back at the start is not a crash');
+    },
+  },
+  {
+    name: 'back and forward walk the route',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(WORK);
+      equal(labels(history.back()), 'home/docs', 'one back');
+      equal(labels(history.back()), 'home', 'two back');
+      equal(history.canGoBack(), false, 'and no further');
+      equal(labels(history.forward()), 'home/docs', 'forward again');
+    },
+  },
+  {
+    name: 'going somewhere new discards the branch you left',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(WORK);
+      history.back();
+      history.visit([visit('home'), visit('docs'), visit('photos')]);
+      equal(history.canGoForward(), false,
+            'work should not still be ahead of photos');
+      equal(labels(history.back()), 'home/docs', 'and back still works');
+    },
+  },
+  {
+    name: 'arriving where you already are is not a step',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(DOCS);
+      history.visit(DOCS);
+      equal(labels(history.back()), 'home',
+            'clicking the same place three times filled the history');
+    },
+  },
+  {
+    name: 'up removes the last step and stops at a root',
+    run() {
+      equal(labels(History.up(WORK)), 'home/docs', 'up from work');
+      equal(labels(History.up(HOME)), 'null', 'up from a root goes nowhere');
+    },
+  },
+  {
+    name: 'clicking a crumb cuts the trail there',
+    run() {
+      equal(labels(History.truncate(WORK, 0)), 'home', 'first crumb');
+      equal(labels(History.truncate(WORK, 1)), 'home/docs', 'second crumb');
+      equal(labels(History.truncate(WORK, 2)), 'home/docs/work', 'the last one');
+    },
+  },
+  {
+    name: 'stepping sideways replaces the last step rather than adding one',
+    run() {
+      equal(labels(History.sibling(WORK, visit('play'))), 'home/docs/play',
+            'a sibling is not a child');
+    },
+  },
+  {
+    name: 'an empty trail is refused rather than recorded',
+    run() {
+      const history = new History();
+      history.visit([]);
+      equal(history.current(), null, 'nowhere is not a place you have been');
+    },
+  },
+];
+
+export function runHistoryTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const check of CHECKS) {
+    try {
+      check.run();
+      passed++;
+    } catch (error) {
+      failures.push(`  FAIL ${check.name}\n       ${
+          error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`history: ${passed}/${CHECKS.length} passed`);
+  for (const failure of failures) {
+    console.log(failure);
+  }
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/ui/places_test.ts b/ui/file_manager/file_manager/kibaos/tests/ui/places_test.ts
new file mode 100644
index 0000000000..81a70fcb87
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/ui/places_test.ts
@@ -0,0 +1,179 @@
+/**
+ * Volume kinds, and what they mean in a sidebar.
+ *
+ * This is the only place that knows `drive` means somebody's Google Drive
+ * rather than a disk, so it is the only place that can get it wrong.
+ */
+import type {Volume, VolumeKind} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import {firstDestination, placeKindFor, placesFor} from '../../ui/places.js';
+
+function volume(id: string, kind: VolumeKind, removable = false): Volume {
+  return {
+    id,
+    root: asFileKey(`mock://${id}`),
+    label: id,
+    kind,
+    removable,
+    readOnly: false,
+    capacity: null,
+  };
+}
+
+interface Check {
+  name: string;
+  run(): void;
+}
+
+class AssertionError extends Error {}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+
+const CHECKS: Check[] = [
+  {
+    name: 'a cloud, a phone and a container are not this computer',
+    run() {
+      for (const kind of ['drive', 'provided', 'android', 'crostini'] as
+           VolumeKind[]) {
+        equal(placeKindFor(volume('x', kind)), 'network',
+              `${kind} was filed as part of the machine`);
+      }
+    },
+  },
+  {
+    name: 'a disk is a disk whether or not it comes out',
+    run() {
+      equal(placeKindFor(volume('x', 'system')), 'volume', 'system');
+      equal(placeKindFor(volume('x', 'removable', true)), 'volume', 'removable');
+      equal(placeKindFor(volume('x', 'mtp')), 'volume', 'mtp');
+      equal(placeKindFor(volume('x', 'archive')), 'volume', 'archive');
+    },
+  },
+  {
+    name: 'recent and trash are places you go, not drives you have',
+    run() {
+      equal(placeKindFor(volume('x', 'recent')), 'recent', 'recent');
+      equal(placeKindFor(volume('x', 'trash')), 'trash', 'trash');
+    },
+  },
+  {
+    name: 'nothing is invented that the backend did not offer',
+    run() {
+      const places = placesFor([volume('a', 'system')]);
+      equal(places.length, 1, 'a place appeared from nowhere');
+      // A Basket nobody asked for is a destination that leads somewhere the
+      // backend has never heard of.
+      assert(!places.some(place => place.kind === 'basket'),
+             'a basket was offered without one existing');
+    },
+  },
+  {
+    name: 'the basket appears only when there is one',
+    run() {
+      const withBasket =
+          placesFor([volume('a', 'system')], {basketKey: 'fake://basket',
+                                              basketCount: 2});
+      assert(withBasket.some(place => place.kind === 'basket'),
+             'the basket was dropped');
+      const keyOnly =
+          placesFor([volume('a', 'system')], {basketKey: 'fake://basket'});
+      assert(!keyOnly.some(place => place.kind === 'basket'),
+             'a basket with no count is not a basket');
+    },
+  },
+  {
+    name: 'the capacity survives the mapping',
+    run() {
+      const disk: Volume = {
+        ...volume('a', 'system'),
+        capacity: {total: 100, free: 50},
+      };
+      const other: Volume = {
+        ...volume('b', 'system'),
+        capacity: {total: 200, free: 80},
+      };
+      const [place] = placesFor([disk, other]);
+      equal(place!.volume?.capacity?.free, 50,
+            'the sidebar cannot draw what the mapping threw away');
+      equal(place!.capacity?.free, 50, 'and it should be asked to draw it');
+    },
+  },
+  {
+    name: 'one disk behind many folders is measured once, not many times',
+    run() {
+      // What the Dell actually reports: every user folder is its own volume on
+      // the same 28 GB disk. Reading a capacity off each of them is how the
+      // sidebar ended up saying "8.7 GB free of 28 GB" fourteen times.
+      const capacity = {total: 28, free: 8};
+      const folders = ['Desktop', 'Documents', 'Downloads', 'Home'].map(
+          name => ({...volume(name, 'system'), capacity}));
+      const places = placesFor(folders);
+      equal(places.length, 4, 'every folder is still a place you can go');
+      equal(places.filter(place => place.capacity).length, 0,
+            'one disk needs no bar at all, the status bar already says it');
+    },
+  },
+  {
+    name: 'a second disk is worth measuring, and both get exactly one bar',
+    run() {
+      const internal = {total: 28, free: 8};
+      const stick = {total: 64, free: 61};
+      const places = placesFor([
+        {...volume('Desktop', 'system'), capacity: internal},
+        {...volume('Home', 'system'), capacity: internal},
+        {...volume('stick', 'system', true), capacity: stick},
+      ]);
+      const measured = places.filter(place => place.capacity);
+      equal(measured.length, 2, 'one bar per disk, not one per folder');
+      equal(measured[0]!.label, 'Desktop', 'on the first place that names it');
+      equal(measured[1]!.label, 'stick', 'and the removable one is its own disk');
+    },
+  },
+  {
+    name: 'the window opens on a drive, not on Recent',
+    run() {
+      const places = placesFor(
+          [volume('recent', 'recent'), volume('home', 'system')]);
+      equal(firstDestination(places)?.label, 'home',
+            'opening onto Recent shows everywhere before you asked for anywhere');
+    },
+  },
+  {
+    name: 'with no local disk it still opens somewhere',
+    run() {
+      const places =
+          placesFor([volume('recent', 'recent'), volume('gdrive', 'drive')]);
+      equal(firstDestination(places)?.label, 'gdrive',
+            'a machine with only a cloud mount should still open onto it');
+      equal(firstDestination([]), undefined, 'nothing to open is not a crash');
+    },
+  },
+];
+
+export function runPlacesTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const check of CHECKS) {
+    try {
+      check.run();
+      passed++;
+    } catch (error) {
+      failures.push(`  FAIL ${check.name}\n       ${
+          error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`places: ${passed}/${CHECKS.length} passed`);
+  for (const failure of failures) {
+    console.log(failure);
+  }
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/ui/voice_test.ts b/ui/file_manager/file_manager/kibaos/tests/ui/voice_test.ts
new file mode 100644
index 0000000000..eb3e0dcaa9
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/ui/voice_test.ts
@@ -0,0 +1,186 @@
+/**
+ * The voice, enforced.
+ *
+ * Style is the easy half: dashes, exclamation marks, sentences that end. The
+ * half that actually matters is claims. A string can be warm, correctly
+ * punctuated, free of every banned character, and still be false. An earlier
+ * draft of this catalogue offered "press Ctrl+Shift+N to make a new folder";
+ * that chord is bound in ash to a new incognito window and never reaches Files,
+ * so a style checker would have waved it through and the first person to
+ * believe it would have found out.
+ */
+import type {EmptyReason} from '../../ui/copy.js';
+import {duration, emptyCopy, ERRORS, SHORTCUTS} from '../../ui/copy.js';
+
+class AssertionError extends Error {}
+function fail(message: string): never {
+  throw new AssertionError(message);
+}
+
+const REASONS: EmptyReason[] = [
+  'empty', 'filtered', 'search', 'trash', 'basket', 'unreadable', 'gone',
+  'offline',
+];
+
+/** Every user visible sentence this app can produce, with where it came from. */
+function catalogue(): Array<{where: string, text: string}> {
+  const out: Array<{where: string, text: string}> = [];
+  for (const reason of REASONS) {
+    const copy = emptyCopy(reason, 'holiday photos');
+    out.push({where: `emptyCopy(${reason}).title`, text: copy.title});
+    if (copy.detail) {
+      out.push({where: `emptyCopy(${reason}).detail`, text: copy.detail});
+    }
+  }
+  out.push({where: 'ERRORS.busy', text: ERRORS.busy('Music', 'Celluloid')});
+  out.push({where: 'ERRORS.readOnly', text: ERRORS.readOnly()});
+  out.push({where: 'ERRORS.noSpace', text: ERRORS.noSpace('2.4 GB', '900 MB')});
+  out.push({where: 'ERRORS.gone', text: ERRORS.gone('Music')});
+  for (const seconds of [1, 30, 120, 3600]) {
+    out.push({where: `duration(${seconds})`, text: duration(seconds)});
+  }
+  return out;
+}
+
+/** Words that describe the machine to itself rather than the person to their files. */
+const JARGON = [
+  'EBUSY', 'ENOENT', 'EACCES', 'errno', 'inode', 'null', 'undefined', 'NaN',
+  'fd ', 'syscall', 'stat()', 'mkfs', 'unmount failed',
+];
+
+/** Reassurance about nothing, which is chatter rather than warmth. */
+const CHATTER = [
+  'plenty of room', 'ready for your files', 'oops', 'sorry', 'whoops',
+  'no worries', 'all good', 'awesome', 'great news',
+];
+
+interface Case {
+  name: string;
+  run(): void;
+}
+
+const CASES: Case[] = [
+  {
+    name: 'no em dashes and no en dashes anywhere',
+    run() {
+      for (const {where, text} of catalogue()) {
+        if (/[–—]/.test(text)) {
+          fail(`${where} contains a dash: ${text}`);
+        }
+      }
+    },
+  },
+  {
+    name: 'no exclamation marks and no cheerfulness where an error belongs',
+    run() {
+      for (const {where, text} of catalogue()) {
+        if (text.includes('!')) {
+          fail(`${where} shouts: ${text}`);
+        }
+        const lowered = text.toLowerCase();
+        for (const phrase of CHATTER) {
+          if (lowered.includes(phrase)) {
+            fail(`${where} reassures about nothing ("${phrase}"): ${text}`);
+          }
+        }
+      }
+    },
+  },
+  {
+    name: 'every string is a complete sentence',
+    run() {
+      for (const {where, text} of catalogue()) {
+        if (!/[.?]$/.test(text)) {
+          fail(`${where} does not end a sentence: ${text}`);
+        }
+        if (!/^[A-Z"]/.test(text)) {
+          fail(`${where} does not start one: ${text}`);
+        }
+        if (text.split(' ').length < 3) {
+          fail(`${where} is a label rather than a sentence: ${text}`);
+        }
+      }
+    },
+  },
+  {
+    name: 'nothing describes the machine to itself',
+    run() {
+      for (const {where, text} of catalogue()) {
+        for (const word of JARGON) {
+          if (text.includes(word)) {
+            fail(`${where} leaks "${word}": ${text}`);
+          }
+        }
+      }
+    },
+  },
+  {
+    name: 'a string that names a shortcut names one that exists',
+    run() {
+      // The claim check. Anything of the form "press X" has to name a chord
+      // this app actually binds, or the sentence is a promise it cannot keep.
+      const pattern = /press ([A-Z][A-Za-z0-9]*(?:\+[A-Za-z0-9]+)*)/gi;
+      for (const {where, text} of catalogue()) {
+        for (const match of text.matchAll(pattern)) {
+          const chord = match[1]!;
+          if (!SHORTCUTS.has(chord)) {
+            fail(`${where} names ${chord}, which this app does not bind: ${text}`);
+          }
+        }
+      }
+    },
+  },
+  {
+    name: 'the empty states differ, because the reasons differ',
+    run() {
+      const seen = new Map<string, EmptyReason>();
+      for (const reason of REASONS) {
+        const title = emptyCopy(reason, 'a drive').title;
+        const already = seen.get(title);
+        if (already) {
+          fail(`${reason} says the same as ${already}: ${title}`);
+        }
+        seen.set(title, reason);
+      }
+    },
+  },
+  {
+    name: 'a search with no results repeats what was searched for',
+    run() {
+      const copy = emptyCopy('search', 'quarterly report');
+      if (!copy.title.includes('quarterly report')) {
+        fail(`the query is not echoed back: ${copy.title}`);
+      }
+    },
+  },
+  {
+    name: 'time is said coarsely rather than counted down',
+    run() {
+      const long = duration(4000);
+      if (/\d/.test(long)) {
+        fail(`a long operation claims a precision it does not have: ${long}`);
+      }
+      if (!long.includes('carry on')) {
+        fail(`a long operation does not say it survives the window: ${long}`);
+      }
+    },
+  },
+];
+
+export function runVoiceTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const testCase of CASES) {
+    try {
+      testCase.run();
+      passed++;
+    } catch (error) {
+      failures.push(
+          `  FAIL ${testCase.name}\n       ${
+              error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`voice: ${passed}/${CASES.length} passed`);
+  failures.forEach(line => console.log(line));
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/kibaos/tools/gen_tokens.py b/ui/file_manager/file_manager/kibaos/tools/gen_tokens.py
new file mode 100755
index 0000000000..5ebee48b76
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tools/gen_tokens.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Turns ui/tokens.css into a TypeScript module.
+
+The stylesheet cannot ship as its own pak resource. A new resource is a new id,
+the id map is compiled into chrome, and adding one means a full link: 43,084
+edges and about six hours on hardware that overheats. `pak-swap-resources.py`
+refuses to insert an id for exactly this reason. So the tokens travel inside a
+resource that already exists, which is the bundled JavaScript.
+
+`ui/tokens.css` stays the single source. The harness pages and the goldens link
+it directly; the app imports the module this writes. `tests/run.sh` regenerates
+and fails if the result would differ, so the two cannot drift.
+
+  python3 gen_tokens.py [--check]
+"""
+import argparse
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+KIBAOS = os.path.dirname(HERE)
+SOURCE = os.path.join(KIBAOS, "ui/tokens.css")
+OUTPUT = os.path.join(KIBAOS, "ui/tokens_css.ts")
+
+HEADER = """/**
+ * The stylesheet, as a string the bundle can carry.
+ *
+ * Generated by `tools/gen_tokens.py` from `ui/tokens.css`, which is the source
+ * of truth. Do not edit this file; edit the stylesheet and run the generator,
+ * or just run `tests/run.sh`, which checks that this is current.
+ *
+ * It exists because a new pak resource needs a new id, a new id is compiled
+ * into chrome, and that is a full link. See the generator for the details.
+ */
+"""
+
+
+def render():
+    with open(SOURCE) as handle:
+        css = handle.read()
+    return HEADER + "export const TOKENS_CSS = " + json.dumps(css) + ";\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true",
+                        help="exit non zero if the file is not current")
+    args = parser.parse_args()
+
+    wanted = render()
+    current = None
+    if os.path.exists(OUTPUT):
+        with open(OUTPUT) as handle:
+            current = handle.read()
+    if current == wanted:
+        return 0
+    if args.check:
+        sys.stderr.write(
+            "ui/tokens_css.ts is stale. Run tools/gen_tokens.py\n")
+        return 1
+    with open(OUTPUT, "w") as handle:
+        handle.write(wanted)
+    print("wrote %s" % os.path.relpath(OUTPUT, KIBAOS))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/ui/file_manager/file_manager/kibaos/ui/copy.ts b/ui/file_manager/file_manager/kibaos/ui/copy.ts
new file mode 100644
index 0000000000..c24e89e38d
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/copy.ts
@@ -0,0 +1,131 @@
+/**
+ * Every user visible string, in one place, so the voice can be tested.
+ *
+ * The rules, taken from the greeter, which already has them right:
+ * complete sentences, second person, what happened and then what you can do,
+ * never blaming the person, no exclamation marks, and no em or en dashes.
+ *
+ * Two rules that are easier to get wrong.
+ *
+ * Warmth is service, not commentary. A good host does not tell you the room is
+ * nice, they have already made it nice. So nothing here says "plenty of room"
+ * or "ready for your files". When everything is fine the right tone is an
+ * accurate number and silence.
+ *
+ * And nothing claims what we did not observe. "Everything here was moved to
+ * Trash" asserts a history this app did not watch happen, so it is not said.
+ */
+
+/**
+ * The chords this app actually binds.
+ *
+ * Copy that names a shortcut is checked against this table, because a sentence
+ * can be warm, correctly punctuated, free of dashes, and false. An earlier
+ * draft offered "press Ctrl+Shift+N to make a new folder"; that chord is taken
+ * by ash for a new incognito window and never reaches Files, so the sentence
+ * would have failed the first time anybody believed it.
+ */
+export const SHORTCUTS: ReadonlyMap<string, string> = new Map([
+  ['Enter', 'open the selected item'],
+  ['Backspace', 'go up one folder'],
+  ['Alt+Up', 'go up one folder'],
+  ['Ctrl+A', 'select everything'],
+  ['Escape', 'cancel'],
+]);
+
+export type EmptyReason =
+    'empty'|'filtered'|'search'|'trash'|'basket'|'unreadable'|'gone'|'offline';
+
+interface EmptyCopy {
+  readonly title: string;
+  readonly detail?: string;
+}
+
+/**
+ * What an empty view says.
+ *
+ * A room somebody walks into should read as clean and prepared rather than
+ * abandoned, and it should never be the same sentence for two different
+ * reasons, because "no files" tells you nothing about which of these happened.
+ */
+export function emptyCopy(reason: EmptyReason, subject?: string): EmptyCopy {
+  switch (reason) {
+    case 'empty':
+      return {
+        title: 'This folder is empty.',
+        detail: 'Drag files here to add them.',
+      };
+    case 'filtered':
+      return {
+        title: 'No files match this filter.',
+        detail: 'Clear the filter to see everything in this folder.',
+      };
+    case 'search':
+      return {
+        title: subject ? `Nothing matches "${subject}".` : 'Nothing matches that.',
+        detail: 'Check the spelling, or search across all of your files.',
+      };
+    case 'trash':
+      return {title: 'There is nothing in Trash.'};
+    case 'basket':
+      return {
+        title: 'Your basket is empty.',
+        detail: 'Gather files from different folders here to work with them together.',
+      };
+    case 'unreadable':
+      return {
+        title: 'This folder cannot be opened with your current permissions.',
+        detail: 'Ask whoever owns it for access, or choose another folder.',
+      };
+    case 'gone':
+      return {
+        title: 'This folder is no longer there.',
+        detail: 'It may have been moved or removed since you opened it.',
+      };
+    case 'offline':
+      // The label goes in the detail rather than at the front of the title.
+      // A drive is named by whoever formatted it, so a title that opens with
+      // one opens with whatever they typed, and "usb backup was unplugged"
+      // starts a sentence in lower case. Nothing here begins with a value
+      // somebody else chose.
+      return {
+        title: 'That drive was unplugged.',
+        detail: subject ? `Plug ${subject} back in to browse its files.` :
+                          'Plug it back in to browse its files.',
+      };
+  }
+}
+
+/** Sentences for the things that go wrong during an operation. */
+export const ERRORS = {
+  busy: (name: string, program: string) =>
+      `${name} is open in ${program}, so it cannot be moved right now. ` +
+      `Close ${program} and try again, or end it here.`,
+  readOnly: () =>
+      'This folder is protected, so new files cannot be placed here. ' +
+      'Check the folder permissions, or choose another location.',
+  noSpace: (needed: string, free: string) =>
+      `There is not enough room. This needs ${needed} and ${free} is free.`,
+  gone: (name: string) =>
+      `${name} is no longer there, so it could not be opened.`,
+} as const;
+
+/**
+ * How long something will take, said coarsely.
+ *
+ * A range nobody can be disappointed by is worth ten countdown clocks that
+ * lie. The estimate is a rate measured over the last few seconds, and printing
+ * "2 hours 37 minutes" claims a precision the number does not have.
+ */
+export function duration(seconds: number): string {
+  if (seconds < 10) {
+    return 'This will take just a moment.';
+  }
+  if (seconds < 60) {
+    return 'This usually takes under a minute.';
+  }
+  if (seconds < 600) {
+    return 'This usually takes a few minutes.';
+  }
+  return 'This will take a while. You can close this window and it will carry on.';
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/file_list.ts b/ui/file_manager/file_manager/kibaos/ui/file_list.ts
new file mode 100644
index 0000000000..8cd86cbbe8
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/file_list.ts
@@ -0,0 +1,405 @@
+/**
+ * The list, virtualised, and ours.
+ *
+ * ChromeOS's List is not reused for two reasons that cost real time to learn.
+ * `mergeItems` keeps the element it already made and never re-runs the render
+ * path for a row already on screen, so a change made during rendering never
+ * reaches anything visible. And its selection walks rendered rows, which at a
+ * hundred thousand entries walks the few dozen that happen to exist.
+ *
+ * So: a fixed row height per density, a spacer that owns the scroll extent, a
+ * pool of rows the size of the viewport, and a selection that is a set of
+ * indices with an anchor. Nothing here asks the DOM what is selected.
+ */
+import type {EntryDto, FileKey, MetadataSnapshot} from '../port/types.js';
+import type {EmptyReason} from './copy.js';
+import {emptyCopy} from './copy.js';
+import {createRow, updateRow} from './file_row.js';
+
+export interface FileListOptions {
+  /** Must match --kibaos-row-height for the density in use. */
+  readonly rowHeight?: number;
+  /** Rows rendered beyond the viewport, so a fast scroll is not a blank band. */
+  readonly overscan?: number;
+  readonly onActivate?: (entry: EntryDto) => void;
+  readonly onSelectionChange?: (keys: ReadonlySet<FileKey>) => void;
+  /**
+   * The window actually on screen changed. Metadata is fetched against
+   * this rather than against the directory, because a directory of a
+   * hundred thousand entries would otherwise mean a hundred thousand stat
+   * calls to fill in forty visible rows.
+   */
+  readonly onRangeChange?: (first: number, count: number) => void;
+}
+
+export class FileList {
+  private entries: readonly EntryDto[] = [];
+  private metadata: MetadataSnapshot = new Map();
+  private readonly selection = new Set<number>();
+  private anchor: number|null = null;
+  private focused = -1;
+  private readonly rowHeight: number;
+  private readonly overscan: number;
+  private readonly pool: HTMLElement[] = [];
+  private readonly viewport: HTMLElement;
+  private readonly spacer: HTMLElement;
+  private readonly surface: HTMLElement;
+  private frame = 0;
+  private lastFirst = -1;
+  private lastCount = -1;
+  private now = Date.now();
+  /** Shares for the bar behind the size column, indexed alongside entries. */
+  private shares: number[] = [];
+  private emptyReason: EmptyReason = 'empty';
+  private emptySubject: string|undefined;
+  private readonly empty: HTMLElement;
+
+  constructor(
+      private readonly container: HTMLElement,
+      private readonly options: FileListOptions = {}) {
+    this.rowHeight = options.rowHeight ?? 40;
+    this.overscan = options.overscan ?? 4;
+
+    this.viewport = document.createElement('div');
+    this.viewport.className = 'kibaos-list';
+    this.viewport.setAttribute('role', 'listbox');
+    this.viewport.setAttribute('aria-multiselectable', 'true');
+    this.viewport.tabIndex = 0;
+
+    this.spacer = document.createElement('div');
+    this.spacer.className = 'kibaos-list-spacer';
+
+    this.surface = document.createElement('div');
+    this.surface.className = 'kibaos-list-surface';
+
+    // role=status rather than a bare div, so the reason a view is empty is
+    // announced rather than being a silence a screen reader cannot see.
+    this.empty = document.createElement('div');
+    this.empty.className = 'kibaos-empty';
+    this.empty.setAttribute('role', 'status');
+    this.empty.hidden = true;
+    const emptyTitle = document.createElement('p');
+    emptyTitle.className = 'kibaos-empty-title';
+    const emptyDetail = document.createElement('p');
+    emptyDetail.className = 'kibaos-empty-detail';
+    this.empty.append(emptyTitle, emptyDetail);
+
+    this.spacer.appendChild(this.surface);
+    this.viewport.appendChild(this.spacer);
+    this.viewport.appendChild(this.empty);
+    this.container.appendChild(this.viewport);
+
+    this.viewport.addEventListener('scroll', this.onScroll, {passive: true});
+    this.viewport.addEventListener('keydown', this.onKeyDown);
+    this.viewport.addEventListener('click', this.onClick);
+    this.viewport.addEventListener('dblclick', this.onDoubleClick);
+    this.viewport.addEventListener('dragstart', this.onDragStart);
+  }
+
+  /**
+   * Why this view has nothing in it.
+   *
+   * A folder nobody has put anything in, a filter that matched nothing, and a
+   * drive that was unplugged are three different situations, and "No files"
+   * tells you which of them happened exactly never.
+   */
+  setEmptyReason(reason: EmptyReason, subject?: string): void {
+    this.emptyReason = reason;
+    this.emptySubject = subject;
+    this.renderEmpty();
+  }
+
+  private renderEmpty(): void {
+    const show = this.entries.length === 0;
+    this.empty.hidden = !show;
+    this.spacer.hidden = show;
+    if (!show) {
+      return;
+    }
+    const copy = emptyCopy(this.emptyReason, this.emptySubject);
+    this.empty.querySelector('.kibaos-empty-title')!.textContent = copy.title;
+    const detail = this.empty.querySelector('.kibaos-empty-detail') as HTMLElement;
+    detail.textContent = copy.detail ?? '';
+    detail.hidden = !copy.detail;
+  }
+
+  /** Programmatic selection, for restoring one across a navigation. */
+  setSelectedIndices(indices: Iterable<number>): void {
+    this.selection.clear();
+    for (const index of indices) {
+      if (index >= 0 && index < this.entries.length) {
+        this.selection.add(index);
+      }
+    }
+    const first = this.selection.values().next();
+    this.anchor = first.done ? null : first.value;
+    this.lastFirst = -1;
+    this.render();
+    this.options.onSelectionChange?.(this.selectedKeys());
+  }
+
+  setEntries(entries: readonly EntryDto[], now = Date.now()): void {
+    this.entries = entries;
+    this.now = now;
+    this.selection.clear();
+    this.anchor = null;
+    this.focused = entries.length ? 0 : -1;
+    this.recomputeShares();
+    this.spacer.style.height = `${entries.length * this.rowHeight}px`;
+    this.viewport.setAttribute('aria-setsize', String(entries.length));
+    // Invalidated even when the window has not moved, so render() takes the
+    // full path and reports the range. A file arriving in the folder you are
+    // already looking at does not scroll anything, and whoever fetches the
+    // details for visible rows only hears about them through that report.
+    this.lastFirst = -1;
+    this.renderEmpty();
+    this.render();
+  }
+
+  setMetadata(snapshot: MetadataSnapshot): void {
+    this.metadata = snapshot;
+    this.recomputeShares();
+    this.lastFirst = -1;
+    this.render();
+  }
+
+  /**
+   * Each entry's share of the largest in the folder, not of the total.
+   *
+   * Against the total, a folder of five hundred files gives every bar a width
+   * of nothing and the column says the same as it did before.
+   */
+  private recomputeShares(): void {
+    let largest = 0;
+    for (const entry of this.entries) {
+      const size = this.metadata.get(entry.key)?.size ?? 0;
+      if (size > largest) {
+        largest = size;
+      }
+    }
+    this.shares = this.entries.map(entry => {
+      if (!largest || entry.isDirectory) {
+        return 0;
+      }
+      return (this.metadata.get(entry.key)?.size ?? 0) / largest;
+    });
+  }
+
+  private onScroll = (): void => {
+    // One render per frame at most. A scroll fires far more often than the
+    // compositor draws, and doing the work each time is how a list stutters
+    // while doing nothing visible.
+    if (this.frame) {
+      return;
+    }
+    this.frame = requestAnimationFrame(() => {
+      this.frame = 0;
+      this.render();
+    });
+  };
+
+  private visibleRange(): {first: number, count: number} {
+    const height = this.viewport.clientHeight || this.rowHeight;
+    const first = Math.max(
+        0, Math.floor(this.viewport.scrollTop / this.rowHeight) - this.overscan);
+    const visible = Math.ceil(height / this.rowHeight) + this.overscan * 2;
+    return {first, count: Math.min(visible, this.entries.length - first)};
+  }
+
+  render(): void {
+    const {first, count} = this.visibleRange();
+    if (first === this.lastFirst && count === this.lastCount) {
+      // Still the same window, but the rows themselves may have changed, so
+      // they are rewritten rather than skipped. Skipping here is exactly the
+      // mistake mergeItems makes.
+      this.paint(first, count);
+      return;
+    }
+    while (this.pool.length < count) {
+      const row = createRow();
+      this.pool.push(row);
+      this.surface.appendChild(row);
+    }
+    while (this.pool.length > count) {
+      this.pool.pop()!.remove();
+    }
+    this.lastFirst = first;
+    this.lastCount = count;
+    this.surface.style.transform = `translateY(${first * this.rowHeight}px)`;
+    this.paint(first, count);
+    this.options.onRangeChange?.(first, count);
+  }
+
+  private paint(first: number, count: number): void {
+    for (let i = 0; i < count; i++) {
+      const index = first + i;
+      const entry = this.entries[index];
+      const row = this.pool[i];
+      if (!entry || !row) {
+        continue;
+      }
+      updateRow(row, {
+        entry,
+        metadata: this.metadata.get(entry.key),
+        selected: this.selection.has(index),
+        cut: false,
+        share: this.shares[index],
+        now: this.now,
+      });
+      row.dataset['index'] = String(index);
+      row.setAttribute('aria-posinset', String(index + 1));
+      row.tabIndex = index === this.focused ? 0 : -1;
+    }
+  }
+
+  // ---- selection, over indices and never over the DOM ---------------------
+
+  private selectIndex(index: number, mode: 'replace'|'toggle'|'range'): void {
+    if (index < 0 || index >= this.entries.length) {
+      return;
+    }
+    if (mode === 'replace') {
+      this.selection.clear();
+      this.selection.add(index);
+      this.anchor = index;
+    } else if (mode === 'toggle') {
+      if (!this.selection.delete(index)) {
+        this.selection.add(index);
+      }
+      this.anchor = index;
+    } else {
+      const from = this.anchor ?? index;
+      const [lo, hi] = from <= index ? [from, index] : [index, from];
+      this.selection.clear();
+      for (let i = lo; i <= hi; i++) {
+        this.selection.add(i);
+      }
+    }
+    this.focused = index;
+    this.lastFirst = -1;
+    this.render();
+    this.options.onSelectionChange?.(this.selectedKeys());
+  }
+
+  selectedKeys(): ReadonlySet<FileKey> {
+    const keys = new Set<FileKey>();
+    for (const index of this.selection) {
+      const entry = this.entries[index];
+      if (entry) {
+        keys.add(entry.key);
+      }
+    }
+    return keys;
+  }
+
+  selectAll(): void {
+    this.selection.clear();
+    for (let i = 0; i < this.entries.length; i++) {
+      this.selection.add(i);
+    }
+    this.lastFirst = -1;
+    this.render();
+    this.options.onSelectionChange?.(this.selectedKeys());
+  }
+
+  scrollToIndex(index: number): void {
+    const top = index * this.rowHeight;
+    const bottom = top + this.rowHeight;
+    const viewTop = this.viewport.scrollTop;
+    const viewBottom = viewTop + this.viewport.clientHeight;
+    if (top < viewTop) {
+      this.viewport.scrollTop = top;
+    } else if (bottom > viewBottom) {
+      this.viewport.scrollTop = bottom - this.viewport.clientHeight;
+    }
+  }
+
+  private move(delta: number, extend: boolean): void {
+    const next = Math.max(
+        0, Math.min(this.entries.length - 1, (this.focused < 0 ? 0 : this.focused) + delta));
+    this.selectIndex(next, extend ? 'range' : 'replace');
+    this.scrollToIndex(next);
+  }
+
+  private onKeyDown = (event: KeyboardEvent): void => {
+    const page = Math.max(1, Math.floor(this.viewport.clientHeight / this.rowHeight) - 1);
+    switch (event.key) {
+      case 'ArrowDown': this.move(1, event.shiftKey); break;
+      case 'ArrowUp': this.move(-1, event.shiftKey); break;
+      case 'PageDown': this.move(page, event.shiftKey); break;
+      case 'PageUp': this.move(-page, event.shiftKey); break;
+      case 'Home': this.move(-this.entries.length, event.shiftKey); break;
+      case 'End': this.move(this.entries.length, event.shiftKey); break;
+      case 'a':
+        if (event.ctrlKey) {
+          this.selectAll();
+          break;
+        }
+        return;
+      case 'Enter': {
+        const entry = this.entries[this.focused];
+        if (entry) {
+          this.options.onActivate?.(entry);
+        }
+        break;
+      }
+      default:
+        return;
+    }
+    event.preventDefault();
+  };
+
+  private indexFromEvent(event: Event): number {
+    const row = (event.target as HTMLElement|null)?.closest?.('.kibaos-row');
+    const raw = (row as HTMLElement|null)?.dataset?.['index'];
+    return raw === undefined ? -1 : Number(raw);
+  }
+
+  private onClick = (event: MouseEvent): void => {
+    const index = this.indexFromEvent(event);
+    if (index < 0) {
+      return;
+    }
+    this.selectIndex(
+        index, event.shiftKey ? 'range' : (event.ctrlKey ? 'toggle' : 'replace'));
+  };
+
+  private onDoubleClick = (event: MouseEvent): void => {
+    const index = this.indexFromEvent(event);
+    const entry = this.entries[index];
+    if (entry) {
+      this.options.onActivate?.(entry);
+    }
+  };
+
+  /**
+   * What leaves the window when a row is dragged away.
+   *
+   * The desktop hands a drag to another window's application as files only
+   * when the data is what ChromeOS's own Files app writes: a tag and the list
+   * of file system URLs in `fs/sources`. A key is exactly such a URL, so the
+   * payload is the selection's keys, one to a line. Picking up a row that is
+   * not selected selects it first, as every file manager does.
+   */
+  private onDragStart = (event: DragEvent): void => {
+    const index = this.indexFromEvent(event);
+    const transfer = event.dataTransfer;
+    if (index < 0 || !transfer) {
+      return;
+    }
+    if (!this.selection.has(index)) {
+      this.selectIndex(index, 'replace');
+    }
+    transfer.effectAllowed = 'copyMove';
+    transfer.setData('fs/tag', 'filemanager-data');
+    transfer.setData('fs/sources', [...this.selectedKeys()].join('\n'));
+    transfer.setData('fs/effectallowed', 'copyMove');
+  };
+
+  destroy(): void {
+    if (this.frame) {
+      cancelAnimationFrame(this.frame);
+    }
+    this.viewport.remove();
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/file_row.ts b/ui/file_manager/file_manager/kibaos/ui/file_row.ts
new file mode 100644
index 0000000000..21add372c9
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/file_row.ts
@@ -0,0 +1,108 @@
+/**
+ * One row, as a create step and an update step.
+ *
+ * Deliberately not a custom element and deliberately no shadow root per row: at
+ * a hundred thousand entries a shadow root per row is a hundred thousand style
+ * scopes, and the rows are recycled anyway.
+ *
+ * The split matters more than it looks. ChromeOS's `List.mergeItems` reuses the
+ * element it already made and never re-runs the render path for a row that is
+ * already on screen, which is why a patch that set a class during rendering
+ * changed nothing for any visible row. `updateRow` always writes every field,
+ * so a recycled row cannot keep a stale one.
+ */
+import type {EntryDto, Metadata} from '../port/types.js';
+import type {FileKind} from './format.js';
+import {formatDate, formatSize, kindOf, labelForKind} from './format.js';
+import {drawPath, glyphElement} from './svg.js';
+
+export interface RowModel {
+  readonly entry: EntryDto;
+  readonly metadata?: Metadata;
+  readonly selected: boolean;
+  readonly cut: boolean;
+  /** This entry's share of the folder, 0 to 1, for the bar behind the size. */
+  readonly share?: number;
+  readonly now: number;
+}
+
+/** Inline, so a glyph is never a separate resource that a transplant cannot carry. */
+const GLYPHS: Record<FileKind, string> = {
+  folder: 'M3 5.5A1.5 1.5 0 0 1 4.5 4h3.6l1.5 1.8h6.9A1.5 1.5 0 0 1 18 7.3v6.2A1.5 1.5 0 0 1 16.5 15h-12A1.5 1.5 0 0 1 3 13.5z',
+  image: 'M3.5 5.5h13v9h-13zM5.5 12.5l3-3.5 2.5 3 2-2.5 2.5 3',
+  audio: 'M8 14a2 2 0 1 1-2-2V4l8-1.5V12a2 2 0 1 1-2-2V5.2L8 6z',
+  video: 'M3.5 5.5h9v9h-9zM12.5 10l4-2.5v5z',
+  archive: 'M3.5 5.5h13v9h-13zM9.2 5.5v1.6M10.8 7.1v1.6M9.2 8.7v1.6M10.8 10.3v1.6',
+  code: 'M7.5 6 4 10l3.5 4M12.5 6 16 10l-3.5 4',
+  document: 'M5 3h6l4 4v10H5zm6 0v4h4',
+  package: 'M10 2.5 17 6v8l-7 3.5L3 14V6zM3 6l7 3.5L17 6M10 9.5V17',
+  file: 'M5 3h6l4 4v10H5z',
+};
+
+/**
+ * Which glyphs are drawn as outlines rather than filled.
+ *
+ * The pictorial ones have to be. A frame with something inside it, filled with
+ * a single non zero winding path, floods to a solid block, which is exactly
+ * what the image glyph did on its first render.
+ */
+const STROKED: ReadonlySet<FileKind> = new Set<FileKind>(
+    ['code', 'document', 'package', 'image', 'video', 'archive']);
+
+export function createRow(): HTMLElement {
+  const row = document.createElement('div');
+  row.className = 'kibaos-row';
+  row.setAttribute('role', 'option');
+  row.tabIndex = -1;
+  // A row can be picked up. What it carries is the list's to say.
+  row.draggable = true;
+
+  const tile = document.createElement('span');
+  tile.className = 'kibaos-tile';
+  tile.appendChild(glyphElement('kibaos-glyph'));
+  row.appendChild(tile);
+
+  for (const field of ['name', 'size', 'type', 'date']) {
+    const cell = document.createElement('span');
+    cell.className = `kibaos-${field}`;
+    row.appendChild(cell);
+  }
+  return row;
+}
+
+export function updateRow(row: HTMLElement, model: RowModel): void {
+  const {entry, metadata, selected, cut, share, now} = model;
+  const kind = kindOf(entry.name, entry.isDirectory);
+
+  row.dataset['key'] = entry.key;
+  row.dataset['directory'] = String(entry.isDirectory);
+  row.dataset['cut'] = String(cut);
+  row.setAttribute('aria-selected', String(selected));
+
+  drawPath(
+      row.querySelector('path')!, GLYPHS[kind], {stroked: STROKED.has(kind)});
+
+  row.querySelector('.kibaos-name')!.textContent = entry.name;
+  // A folder has no meaningful size of its own, and printing a dash for one is
+  // an answer to a question nobody asked.
+  row.querySelector('.kibaos-size')!.textContent =
+      entry.isDirectory ? '' : formatSize(metadata?.size);
+  row.querySelector('.kibaos-type')!.textContent = labelForKind(kind);
+  row.querySelector('.kibaos-date')!.textContent =
+      formatDate(metadata?.modificationTime, now);
+
+  const size = row.querySelector('.kibaos-size') as HTMLElement;
+  size.style.setProperty(
+      '--kibaos-share', share ? `${Math.round(share * 100)}%` : '0%');
+
+  // The accessible name carries what the columns say, because a screen reader
+  // reading "Downloads 2.4 MB Folder Today at 3:15 PM" as four separate cells
+  // is not how anybody would say it.
+  row.setAttribute(
+      'aria-label',
+      [entry.name, labelForKind(kind),
+       entry.isDirectory ? '' : formatSize(metadata?.size),
+       formatDate(metadata?.modificationTime, now)]
+          .filter(Boolean)
+          .join(', '));
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/format.ts b/ui/file_manager/file_manager/kibaos/ui/format.ts
new file mode 100644
index 0000000000..869026d5be
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/format.ts
@@ -0,0 +1,151 @@
+/**
+ * Turning numbers into the sentences a person actually reads.
+ *
+ * Separate from the row so it can be tested on its own, because most of what
+ * makes a file manager feel considered is here rather than in the layout: never
+ * printing "1 item(s)", never claiming a precision the number does not have,
+ * and ageing dates the way somebody would say them out loud.
+ */
+
+const KIB = 1024;
+
+/**
+ * Sizes carry three significant figures at most.
+ *
+ * "1.4 MB" and not "1.44 MB", because the second digit after the point is
+ * noise that changes while you are reading it.
+ */
+export function formatSize(bytes: number|undefined): string {
+  if (bytes === undefined) {
+    return '';
+  }
+  if (bytes < KIB) {
+    return `${bytes} bytes`;
+  }
+  const units = ['KB', 'MB', 'GB', 'TB', 'PB'];
+  let value = bytes / KIB;
+  let unit = 0;
+  while (value >= KIB && unit < units.length - 1) {
+    value /= KIB;
+    unit++;
+  }
+  const digits = value < 10 ? 1 : 0;
+  return `${value.toFixed(digits)} ${units[unit]}`;
+}
+
+/** The grammar rule: never "item(s)", never "0 files". */
+export function formatCount(folders: number, files: number): string {
+  const parts: string[] = [];
+  if (folders > 0) {
+    parts.push(folders === 1 ? '1 folder' : `${folders} folders`);
+  }
+  if (files > 0) {
+    parts.push(files === 1 ? '1 file' : `${files} files`);
+  }
+  if (!parts.length) {
+    return 'Nothing here yet';
+  }
+  return parts.join(' and ');
+}
+
+export function formatSelection(count: number): string {
+  if (count === 0) {
+    return 'No items selected';
+  }
+  return count === 1 ? '1 item selected' : `${count} items selected`;
+}
+
+function clockTime(date: Date): string {
+  return date.toLocaleTimeString(
+      undefined, {hour: 'numeric', minute: '2-digit'});
+}
+
+/**
+ * Dates age the way somebody would say them.
+ *
+ * `now` is a parameter rather than read from the clock so this can be tested
+ * without waiting for tomorrow.
+ */
+export function formatDate(when: number|undefined, now: number): string {
+  if (when === undefined) {
+    return '';
+  }
+  const date = new Date(when);
+  const current = new Date(now);
+  const seconds = Math.floor((now - when) / 1000);
+
+  if (seconds < 60) {
+    return 'Just now';
+  }
+  if (seconds < 3600) {
+    const minutes = Math.floor(seconds / 60);
+    return minutes === 1 ? '1 minute ago' : `${minutes} minutes ago`;
+  }
+
+  const sameDay = date.toDateString() === current.toDateString();
+  if (sameDay) {
+    return `Today at ${clockTime(date)}`;
+  }
+
+  const yesterday = new Date(current);
+  yesterday.setDate(current.getDate() - 1);
+  if (date.toDateString() === yesterday.toDateString()) {
+    return `Yesterday at ${clockTime(date)}`;
+  }
+
+  if (date.getFullYear() === current.getFullYear()) {
+    return date.toLocaleDateString(
+        undefined, {weekday: 'long', day: 'numeric', month: 'long'});
+  }
+  return date.toLocaleDateString(
+      undefined, {day: 'numeric', month: 'long', year: 'numeric'});
+}
+
+export type FileKind = 'folder'|'image'|'audio'|'video'|'archive'|'code'|
+    'document'|'package'|'file';
+
+const BY_EXTENSION: ReadonlyMap<string, FileKind> = new Map(Object.entries({
+  png: 'image', jpg: 'image', jpeg: 'image', gif: 'image', webp: 'image',
+  svg: 'image', bmp: 'image', avif: 'image',
+  mp3: 'audio', flac: 'audio', ogg: 'audio', wav: 'audio', m4a: 'audio',
+  mp4: 'video', mkv: 'video', webm: 'video', mov: 'video', avi: 'video',
+  zip: 'archive', tar: 'archive', gz: 'archive', xz: 'archive',
+  zst: 'archive', bz2: 'archive', rar: 'archive', '7z': 'archive',
+  ts: 'code', js: 'code', py: 'code', rs: 'code', c: 'code', h: 'code',
+  cc: 'code', cpp: 'code', sh: 'code', json: 'code', html: 'code',
+  css: 'code', go: 'code', java: 'code',
+  pdf: 'document', doc: 'document', docx: 'document', odt: 'document',
+  txt: 'document', md: 'document', rtf: 'document',
+}) as Array<[string, FileKind]>);
+
+export function kindOf(name: string, isDirectory: boolean): FileKind {
+  if (isDirectory) {
+    return 'folder';
+  }
+  // Arch packages are a compound extension and the interesting half is not the
+  // last one, so they are matched before the generic tail.
+  if (/\.pkg\.tar\.(zst|xz|gz)$/i.test(name)) {
+    return 'package';
+  }
+  const dot = name.lastIndexOf('.');
+  if (dot <= 0 || dot === name.length - 1) {
+    return 'file';
+  }
+  return BY_EXTENSION.get(name.slice(dot + 1).toLowerCase()) ?? 'file';
+}
+
+const LABELS: Record<FileKind, string> = {
+  folder: 'Folder',
+  image: 'Image',
+  audio: 'Audio',
+  video: 'Video',
+  archive: 'Archive',
+  code: 'Code',
+  document: 'Document',
+  package: 'Package',
+  file: 'File',
+};
+
+export function labelForKind(kind: FileKind): string {
+  return LABELS[kind];
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/history.ts b/ui/file_manager/file_manager/kibaos/ui/history.ts
new file mode 100644
index 0000000000..ecc8995a51
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/history.ts
@@ -0,0 +1,88 @@
+/**
+ * Back, forward, and how you got here.
+ *
+ * A breadcrumb is not a parsed path. `FileKey` is deliberately opaque, because
+ * a key can be a fake-entry:// for Recent or an archive mounted inside another
+ * archive, and none of those have a parent you can find by splitting on a
+ * slash. So the trail is a record of the route taken rather than a
+ * decomposition of the destination, which is also the only version that stays
+ * true when the same folder is reachable two ways.
+ */
+import type {FileKey} from '../port/types.js';
+
+export interface Visit {
+  readonly key: FileKey;
+  readonly label: string;
+}
+
+export type Trail = readonly Visit[];
+
+export class History {
+  private readonly entries: Trail[] = [];
+  private index = -1;
+
+  /**
+   * Records arriving somewhere. Anything ahead is discarded, the same way a
+   * browser does: once you go back and then somewhere new, the branch you left
+   * is not somewhere you can return to by pressing forward.
+   */
+  visit(trail: Trail): void {
+    if (!trail.length) {
+      return;
+    }
+    const here = this.current();
+    if (here && here.length === trail.length &&
+        here[here.length - 1]!.key === trail[trail.length - 1]!.key) {
+      // Arriving where you already are is not a step. Without this, clicking
+      // the same place twice fills the history with entries that all go
+      // nowhere, and back stops meaning anything.
+      return;
+    }
+    this.entries.length = this.index + 1;
+    this.entries.push(trail.slice());
+    this.index = this.entries.length - 1;
+  }
+
+  current(): Trail|null {
+    return this.entries[this.index] ?? null;
+  }
+
+  canGoBack(): boolean {
+    return this.index > 0;
+  }
+
+  canGoForward(): boolean {
+    return this.index >= 0 && this.index < this.entries.length - 1;
+  }
+
+  back(): Trail|null {
+    if (!this.canGoBack()) {
+      return null;
+    }
+    this.index--;
+    return this.current();
+  }
+
+  forward(): Trail|null {
+    if (!this.canGoForward()) {
+      return null;
+    }
+    this.index++;
+    return this.current();
+  }
+
+  /** The trail with the last step removed, or null at a root. */
+  static up(trail: Trail): Trail|null {
+    return trail.length > 1 ? trail.slice(0, -1) : null;
+  }
+
+  /** Everything down to and including `level`, for a breadcrumb click. */
+  static truncate(trail: Trail, level: number): Trail {
+    return trail.slice(0, level + 1);
+  }
+
+  /** Replaces the last step, for stepping sideways to a sibling. */
+  static sibling(trail: Trail, visit: Visit): Trail {
+    return [...trail.slice(0, -1), visit];
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/path_bar.ts b/ui/file_manager/file_manager/kibaos/ui/path_bar.ts
new file mode 100644
index 0000000000..ed3288fdd6
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/path_bar.ts
@@ -0,0 +1,268 @@
+/**
+ * Where you are, and the way sideways.
+ *
+ * The chevron between two crumbs is not decoration. It lists what else was in
+ * the folder to its left, so stepping from Documents/Work to Documents/Play is
+ * one click rather than up then down. Dolphin and Nautilus both have this and
+ * it is the single most missed thing when moving off them.
+ *
+ * A breadcrumb, not a path. See `history.ts` for why a `FileKey` cannot simply
+ * be split on a slash.
+ */
+import type {Trail, Visit} from './history.js';
+import {History} from './history.js';
+import {glyph} from './svg.js';
+
+export interface PathBarOptions {
+  readonly onGo?: (trail: Trail) => void;
+  /**
+   * What else is in the folder at `level`. Returning an empty list is a fine
+   * answer and says the popover has nothing to show, which is different from
+   * the call failing.
+   */
+  readonly siblings?: (level: number) => Promise<readonly Visit[]>;
+}
+
+// A function rather than a constant: a node lives in one place, and a deep
+// path draws six of these.
+function chevron(): SVGElement {
+  return glyph('kibaos-chevron-glyph', 'M8 6l4 4-4 4', {stroked: true});
+}
+
+export class PathBar {
+  private readonly nav: HTMLElement;
+  private readonly list: HTMLElement;
+  private trail: Trail = [];
+  private popover: HTMLElement|null = null;
+  private openAt = -1;
+  /** Bumped per open, so a slow reply for a closed popover is dropped. */
+  private generation = 0;
+
+  constructor(
+      container: HTMLElement, private readonly options: PathBarOptions = {}) {
+    this.nav = document.createElement('nav');
+    this.nav.className = 'kibaos-path';
+    this.nav.setAttribute('aria-label', 'Location');
+    this.list = document.createElement('ol');
+    this.list.className = 'kibaos-path-list';
+    this.nav.appendChild(this.list);
+    container.appendChild(this.nav);
+    this.nav.addEventListener('click', this.onClick);
+    this.nav.addEventListener('keydown', this.onKeyDown);
+    document.addEventListener('pointerdown', this.onDocumentPointerDown, true);
+  }
+
+  setTrail(trail: Trail): void {
+    this.trail = trail.slice();
+    this.close();
+    this.render();
+  }
+
+  private render(): void {
+    this.list.textContent = '';
+    this.trail.forEach((visit, level) => {
+      if (level > 0) {
+        this.list.appendChild(this.renderChevron(level - 1));
+      }
+      this.list.appendChild(this.renderCrumb(visit, level));
+    });
+    // A trailing chevron so the last folder's own contents are reachable the
+    // same way as every other level. Without it the deepest folder is the one
+    // place you cannot step sideways from.
+    if (this.trail.length) {
+      this.list.appendChild(this.renderChevron(this.trail.length - 1));
+    }
+  }
+
+  private renderCrumb(visit: Visit, level: number): HTMLElement {
+    const item = document.createElement('li');
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'kibaos-crumb';
+    button.dataset['level'] = String(level);
+    button.textContent = visit.label;
+    if (level === this.trail.length - 1) {
+      button.setAttribute('aria-current', 'page');
+    }
+    item.appendChild(button);
+    return item;
+  }
+
+  private renderChevron(level: number): HTMLElement {
+    const item = document.createElement('li');
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'kibaos-chevron';
+    button.dataset['chevron'] = String(level);
+    button.setAttribute('aria-expanded', 'false');
+    button.setAttribute('aria-haspopup', 'menu');
+    const at = this.trail[level];
+    // The name has to say which folder is about to be listed, because on a
+    // deep path there are five of these and they are otherwise identical.
+    button.setAttribute('aria-label', `What else is in ${at?.label ?? 'here'}`);
+    button.appendChild(chevron());
+    item.appendChild(button);
+    return item;
+  }
+
+  private async open(level: number, chevron: HTMLElement): Promise<void> {
+    if (this.openAt === level) {
+      this.close();
+      return;
+    }
+    this.close();
+    if (!this.options.siblings) {
+      return;
+    }
+    this.openAt = level;
+    chevron.setAttribute('aria-expanded', 'true');
+    const generation = ++this.generation;
+    let entries: readonly Visit[];
+    try {
+      entries = await this.options.siblings(level);
+    } catch {
+      if (generation === this.generation) {
+        this.showPopover(chevron, null);
+      }
+      return;
+    }
+    if (generation !== this.generation) {
+      return;
+    }
+    this.showPopover(chevron, entries);
+  }
+
+  private showPopover(chevron: HTMLElement, entries: readonly Visit[]|null):
+      void {
+    const popover = document.createElement('div');
+    popover.className = 'kibaos-path-popover';
+    popover.setAttribute('role', 'menu');
+    if (entries === null) {
+      const message = document.createElement('p');
+      message.className = 'kibaos-path-popover-empty';
+      message.textContent = 'That folder could not be read.';
+      popover.appendChild(message);
+    } else if (!entries.length) {
+      const message = document.createElement('p');
+      message.className = 'kibaos-path-popover-empty';
+      // Not "no results": there is nothing wrong, there is simply nothing
+      // beside you.
+      message.textContent = 'No other folders here.';
+      popover.appendChild(message);
+    } else {
+      for (const entry of entries) {
+        const option = document.createElement('button');
+        option.type = 'button';
+        option.className = 'kibaos-path-option';
+        option.setAttribute('role', 'menuitem');
+        option.dataset['key'] = entry.key;
+        option.textContent = entry.label;
+        popover.appendChild(option);
+      }
+    }
+    // Anchored to the toolbar rather than to the chevron's own list item. The
+    // path bar clips horizontally so a deep trail cannot push the toolbar
+    // wider, and a clip is a clip: keeping the popover inside it cut the
+    // popover off at the height of the bar.
+    const host = (this.nav.parentElement ?? this.nav) as HTMLElement;
+    popover.addEventListener('click', this.onPopoverClick);
+    popover.addEventListener('keydown', this.onKeyDown);
+    host.appendChild(popover);
+    const anchor = chevron.getBoundingClientRect();
+    const frame = host.getBoundingClientRect();
+    popover.style.insetBlockStart = `${Math.round(frame.height) + 2}px`;
+    if (getComputedStyle(host).direction === 'rtl') {
+      popover.style.right = `${Math.round(frame.right - anchor.right)}px`;
+    } else {
+      // Clamped so a chevron near the right edge does not open a popover that
+      // runs off the window.
+      const width = popover.offsetWidth;
+      const left = Math.min(
+          Math.round(anchor.left - frame.left),
+          Math.max(0, Math.round(frame.width - width - 4)));
+      popover.style.left = `${left}px`;
+    }
+    this.popover = popover;
+    const first = popover.querySelector<HTMLElement>('.kibaos-path-option');
+    first?.focus();
+  }
+
+  private close(): void {
+    this.generation++;
+    this.popover?.remove();
+    this.popover = null;
+    if (this.openAt >= 0) {
+      this.nav
+          .querySelector(`[data-chevron="${this.openAt}"]`)
+          ?.setAttribute('aria-expanded', 'false');
+    }
+    this.openAt = -1;
+  }
+
+  private onPopoverClick = (event: MouseEvent): void => {
+    const option = (event.target as HTMLElement|null)
+                       ?.closest?.('.kibaos-path-option') as HTMLElement|null;
+    if (!option) {
+      return;
+    }
+    const level = this.openAt;
+    const key = option.dataset['key']!;
+    const label = option.textContent ?? '';
+    this.close();
+    // Truncate to the chevron's own level, then step in. That is a sibling of
+    // whatever was next, which is the whole point of the control.
+    const base = History.truncate(this.trail, level);
+    this.options.onGo?.([...base, {key: key as Visit['key'], label}]);
+  };
+
+  private onClick = (event: MouseEvent): void => {
+    const target = event.target as HTMLElement|null;
+    const chevron = target?.closest?.('.kibaos-chevron') as HTMLElement|null;
+    if (chevron) {
+      void this.open(Number(chevron.dataset['chevron']), chevron);
+      return;
+    }
+    const crumb = target?.closest?.('.kibaos-crumb') as HTMLElement|null;
+    if (crumb) {
+      this.close();
+      const level = Number(crumb.dataset['level']);
+      if (level < this.trail.length - 1) {
+        this.options.onGo?.(History.truncate(this.trail, level));
+      }
+    }
+  };
+
+  private onKeyDown = (event: KeyboardEvent): void => {
+    if (event.key !== 'Escape' || this.openAt < 0) {
+      return;
+    }
+    const chevron = this.nav.querySelector<HTMLElement>(
+        `[data-chevron="${this.openAt}"]`);
+    this.close();
+    // Focus goes back to what opened it, or it lands on the document body and
+    // the next Tab starts from the top of the page.
+    chevron?.focus();
+    event.preventDefault();
+  };
+
+  private onDocumentPointerDown = (event: Event): void => {
+    if (this.openAt < 0) {
+      return;
+    }
+    const target = event.target as Node|null;
+    // The popover is a sibling of the path bar now, so containment has to be
+    // checked against both or the first click on an option closes it before
+    // that click can land.
+    const inside = target &&
+        (this.nav.contains(target) || this.popover?.contains(target));
+    if (!inside) {
+      this.close();
+    }
+  };
+
+  destroy(): void {
+    document.removeEventListener(
+        'pointerdown', this.onDocumentPointerDown, true);
+    this.nav.remove();
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/places.ts b/ui/file_manager/file_manager/kibaos/ui/places.ts
new file mode 100644
index 0000000000..0e3823ed8a
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/places.ts
@@ -0,0 +1,105 @@
+/**
+ * Volumes, as places you can go.
+ *
+ * This is the only thing that knows what a VolumeKind means. The sidebar groups
+ * by the place kind it is handed and stays ignorant of the fact that `drive`
+ * means somebody's Google Drive rather than a disk in the machine, which is the
+ * sort of detail that otherwise ends up hardcoded in a view and wrong for the
+ * next backend.
+ *
+ * Nothing is invented here. A place appears because a volume backs it, so there
+ * is no destination in the sidebar that leads somewhere the backend has never
+ * heard of.
+ */
+import type {Volume} from '../port/types.js';
+import type {Place, PlaceKind} from './sidebar.js';
+
+/** Somewhere else that happens to be mounted here: cloud, phone, container. */
+const ELSEWHERE = new Set(['drive', 'provided', 'android', 'crostini']);
+
+export function placeKindFor(volume: Volume): PlaceKind {
+  if (volume.kind === 'recent') {
+    return 'recent';
+  }
+  if (volume.kind === 'trash') {
+    return 'trash';
+  }
+  if (ELSEWHERE.has(volume.kind)) {
+    return 'network';
+  }
+  return 'volume';
+}
+
+/**
+ * Which places get a free space meter.
+ *
+ * On this hardware every user folder is exposed as its own volume backed by the
+ * same disk, so reading a capacity off each place puts fourteen identical
+ * "8.7 GB free of 28 GB" bars down the sidebar. Fourteen copies of one fact
+ * state it less clearly than one does, and the status bar is already saying it.
+ *
+ * So a meter has to earn its place by having something to be compared against.
+ * One device gets none. Two or more get exactly one each, on the first place
+ * that names them. Devices are told apart by the numbers they report, which is
+ * all the port offers and is enough: two disks reporting byte-identical size
+ * and free space are indistinguishable to a person looking at a sidebar too.
+ */
+function metered(volumes: readonly Volume[]): ReadonlySet<string> {
+  const firstOfDevice = new Map<string, string>();
+  for (const volume of volumes) {
+    const capacity = volume.capacity;
+    if (!capacity || capacity.total <= 0) {
+      continue;
+    }
+    const device = `${capacity.total}/${capacity.free}`;
+    if (!firstOfDevice.has(device)) {
+      firstOfDevice.set(device, volume.id);
+    }
+  }
+  return firstOfDevice.size > 1 ? new Set(firstOfDevice.values()) :
+                                  new Set<string>();
+}
+
+export interface PlacesOptions {
+  /** Omitted or zero means the basket is not offered at all. */
+  readonly basketCount?: number;
+  readonly basketKey?: string;
+}
+
+export function placesFor(
+    volumes: readonly Volume[], options: PlacesOptions = {}): Place[] {
+  const meters = metered(volumes);
+  const places: Place[] = volumes.map(volume => {
+    const place: Place = {
+      key: volume.root,
+      label: volume.label,
+      kind: placeKindFor(volume),
+      volume,
+    };
+    return meters.has(volume.id) && volume.capacity ?
+        {...place, capacity: volume.capacity} :
+        place;
+  });
+  const {basketCount, basketKey} = options;
+  if (basketCount !== undefined && basketKey !== undefined) {
+    places.push({
+      key: basketKey as Place['key'],
+      label: 'Basket',
+      kind: 'basket',
+      badge: basketCount,
+    });
+  }
+  return places;
+}
+
+/**
+ * Where to land when the window opens.
+ *
+ * The first real volume rather than the first place: opening onto Recent shows
+ * a list assembled from everywhere, which is a fine thing to ask for and a poor
+ * thing to be given before you have asked for anything.
+ */
+export function firstDestination(places: readonly Place[]): Place|undefined {
+  return places.find(place => place.kind === 'volume') ??
+      places.find(place => place.kind === 'network') ?? places[0];
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/shell.ts b/ui/file_manager/file_manager/kibaos/ui/shell.ts
new file mode 100644
index 0000000000..24a2343863
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/shell.ts
@@ -0,0 +1,337 @@
+/**
+ * The window: places on the left, what is in them on the right.
+ *
+ * This is the first thing that talks to the port rather than being handed data,
+ * so it is also the first place the seam has to actually hold. Everything it
+ * needs is behind `FilesBackendPort`, which is why the whole of it runs against
+ * `MockBackend` in a browser with no session, no pak and no machine.
+ *
+ * Metadata is fetched against the window on screen rather than the directory.
+ * A hundred thousand entries is a normal directory and forty of them are
+ * visible, so asking for all of it to fill a screen is the difference between
+ * opening instantly and not opening.
+ */
+import type {FilesBackendPort} from '../port/port.js';
+import type {EntryDto, FileKey, Metadata, MetadataField, Volume} from '../port/types.js';
+import {FilesError} from '../port/types.js';
+import type {SessionState} from '../session/navigation_session.js';
+import {NavigationSession} from '../session/navigation_session.js';
+import type {EmptyReason} from './copy.js';
+import {FileList} from './file_list.js';
+import type {Trail, Visit} from './history.js';
+import {History} from './history.js';
+import {firstDestination, placesFor} from './places.js';
+import type {Place} from './sidebar.js';
+import {Sidebar} from './sidebar.js';
+import {StatusBar} from './status_bar.js';
+import {Toolbar} from './toolbar.js';
+
+const FIELDS: readonly MetadataField[] = ['size', 'modificationTime'];
+
+export interface ShellOptions {
+  readonly rowHeight?: number;
+  /** Omit both to leave the basket out entirely rather than showing an empty one. */
+  readonly basketKey?: string;
+  readonly basketCount?: number;
+}
+
+function element(tag: string, className: string): HTMLElement {
+  const node = document.createElement(tag);
+  node.className = className;
+  return node;
+}
+
+/** What an empty view means, given why it is empty. */
+function reasonFor(error: FilesError|null): EmptyReason {
+  if (!error) {
+    return 'empty';
+  }
+  // "This folder is empty" is a lie when the truth is that it could not be
+  // read, and the two look identical if the code is not consulted.
+  return error.code === 'not-found' ? 'gone' : 'unreadable';
+}
+
+export class FilesShell {
+  private readonly root: HTMLElement;
+  private readonly notice: HTMLElement;
+  private readonly sidebar: Sidebar;
+  private readonly toolbar: Toolbar;
+  private readonly list: FileList;
+  private readonly status: StatusBar;
+  private readonly history = new History();
+  private places: readonly Place[] = [];
+  private trail: Trail = [];
+  private readonly session: NavigationSession;
+  private readonly metadata = new Map<FileKey, Metadata>();
+  private entries: readonly EntryDto[] = [];
+  private unsubscribe: (() => void)|null = null;
+  /**
+   * Bumped on every navigation. A metadata reply that arrives after you have
+   * moved on belongs to a directory nobody is looking at, and applying it is
+   * work done on behalf of a screen that no longer exists.
+   */
+  private generation = 0;
+
+  constructor(
+      container: HTMLElement,
+      private readonly port: FilesBackendPort,
+      private readonly options: ShellOptions = {}) {
+    this.root = element('div', 'kibaos-shell');
+
+    const aside = element('div', 'kibaos-shell-aside');
+    this.sidebar = new Sidebar(aside, {onSelect: place => void this.goTo(place)});
+
+    const main = element('div', 'kibaos-shell-main');
+    this.toolbar = new Toolbar(main, {
+      onBack: () => void this.step(this.history.back()),
+      onForward: () => void this.step(this.history.forward()),
+      onUp: () => void this.go(History.up(this.trail)),
+      onGo: trail => void this.go(trail),
+      siblings: level => this.siblingsOf(level),
+    });
+    this.notice = element('p', 'kibaos-shell-notice');
+    this.notice.hidden = true;
+    // A status rather than an alert: it is worth saying, and not worth
+    // interrupting whatever the screen reader was in the middle of.
+    this.notice.setAttribute('role', 'status');
+    const listHost = element('div', 'kibaos-shell-list');
+    main.append(this.notice, listHost);
+
+    this.list = new FileList(listHost, {
+      rowHeight: options.rowHeight,
+      onActivate: entry => void this.activate(entry),
+      onRangeChange: (first, count) => void this.fillMetadata(first, count),
+      onSelectionChange: () => this.refreshStatus(),
+    });
+    this.status = new StatusBar(main);
+
+    this.root.append(aside, main);
+    container.appendChild(this.root);
+
+    this.session = new NavigationSession('main', port);
+    this.unsubscribe = this.session.subscribe(state => this.apply(state));
+  }
+
+  /** Loads the places and opens the first real one. */
+  async start(): Promise<void> {
+    let volumes;
+    try {
+      volumes = await this.port.volumes();
+    } catch (error) {
+      // A sidebar with nothing in it and no explanation reads as a broken
+      // window. Say which part failed.
+      this.say('The places on this computer could not be read.');
+      return;
+    }
+    const places = placesFor(volumes, {
+      basketKey: this.options.basketKey,
+      basketCount: this.options.basketCount,
+    });
+    this.places = places;
+    this.sidebar.setPlaces(places);
+    const destination = firstDestination(places);
+    if (!destination) {
+      this.say('No drives are available yet.');
+      return;
+    }
+    await this.goTo(destination);
+  }
+
+  private say(message: string): void {
+    this.notice.textContent = message;
+    this.notice.hidden = false;
+  }
+
+  private async goTo(place: Place): Promise<void> {
+    this.notice.hidden = true;
+    await this.go([{key: place.key, label: place.label}]);
+  }
+
+  /** Arriving somewhere new, which is a step in the history. */
+  private async go(trail: Trail|null): Promise<void> {
+    if (!trail || !trail.length) {
+      return;
+    }
+    this.history.visit(trail);
+    await this.land(trail);
+  }
+
+  /**
+   * Arriving somewhere the history moved us to, which is not a new step.
+   *
+   * Kept separate from `go` on purpose. Today `visit` would refuse to record
+   * this anyway, because it refuses a trail ending where you already are, so
+   * the mutation gate correctly reports the two as indistinguishable. That is
+   * an argument for keeping them apart rather than merging them: back would
+   * otherwise be relying on a guard in another class to avoid discarding the
+   * branch it is walking through, and the day that guard is relaxed is not the
+   * day anybody wants to discover this.
+   */
+  private async step(trail: Trail|null): Promise<void> {
+    if (trail) {
+      await this.land(trail);
+    }
+  }
+
+  private async land(trail: Trail): Promise<void> {
+    this.trail = trail.slice();
+    const here = trail[trail.length - 1]!;
+    this.toolbar.setTrail(this.trail);
+    this.toolbar.setAvailability({
+      back: this.history.canGoBack(),
+      forward: this.history.canGoForward(),
+      up: this.trail.length > 1,
+    });
+    // Only the root of a place is that place. Three folders down you are not
+    // at the drive, and a marker saying otherwise is a marker nobody can trust.
+    this.sidebar.setSelected(trail.length === 1 ? here.key : null);
+    await this.navigate(here.key);
+  }
+
+  /**
+   * What else is in the folder at `level`, for a chevron popover.
+   *
+   * Capped, because this runs on a click and the folder above you can be as
+   * large as any other. Two hundred is far more than a popover can usefully
+   * show and far less than a directory can hold.
+   */
+  private async siblingsOf(level: number): Promise<readonly Visit[]> {
+    const at = this.trail[level];
+    if (!at) {
+      return [];
+    }
+    const found: Visit[] = [];
+    for await (const page of this.port.list(at.key)) {
+      for (const entry of page.entries) {
+        if (entry.isDirectory) {
+          found.push({key: entry.key, label: entry.name});
+        }
+      }
+      if (found.length >= 200) {
+        break;
+      }
+    }
+    return found;
+  }
+
+  private async navigate(key: FileKey): Promise<void> {
+    this.generation++;
+    this.metadata.clear();
+    await this.session.navigate(key);
+  }
+
+  private async activate(entry: EntryDto): Promise<void> {
+    if (!entry.isDirectory) {
+      return;
+    }
+    await this.go([...this.trail, {key: entry.key, label: entry.name}]);
+  }
+
+  /**
+   * The volume you are on, which stays the same as you go deeper.
+   *
+   * Taken from the first step of the trail rather than from the folder you are
+   * standing in, because only the root of a trail is a place the sidebar knows
+   * and only a place carries capacity.
+   */
+  private currentVolume(): Volume|null {
+    const root = this.trail[0];
+    if (!root) {
+      return null;
+    }
+    return this.places.find(place => place.key === root.key)?.volume ?? null;
+  }
+
+  /**
+   * The total, when there is an honest one to give.
+   *
+   * Null the moment any file being counted has not reported a size, which is
+   * the normal state part way down a large directory.
+   */
+  private bytesOf(entries: readonly EntryDto[]): number|null {
+    let total = 0;
+    for (const entry of entries) {
+      if (entry.isDirectory) {
+        continue;
+      }
+      const size = this.metadata.get(entry.key)?.size;
+      if (size === undefined) {
+        return null;
+      }
+      total += size;
+    }
+    return total;
+  }
+
+  private refreshStatus(): void {
+    const selected = this.list.selectedKeys();
+    const counted = selected.size > 0 ?
+        this.entries.filter(entry => selected.has(entry.key)) :
+        this.entries;
+    this.status.set({
+      folders: this.entries.filter(entry => entry.isDirectory).length,
+      files: this.entries.filter(entry => !entry.isDirectory).length,
+      selected: selected.size,
+      bytes: this.bytesOf(counted),
+      capacity: this.currentVolume()?.capacity ?? null,
+    });
+  }
+
+  private apply(state: SessionState): void {
+    this.entries = state.entries;
+    // Details for the new rows are not fetched here. setEntries reports its
+    // range unconditionally, precisely so a folder that changed under a window
+    // that has not scrolled still asks for what just arrived, and doing it
+    // again here only asks twice with a staler range. list_test pins that.
+    this.list.setEntries(state.entries);
+    this.refreshStatus();
+    if (state.error) {
+      this.list.setEmptyReason(reasonFor(state.error));
+    } else if (!state.loading && state.entries.length === 0) {
+      this.list.setEmptyReason('empty');
+    }
+  }
+
+  private async fillMetadata(first: number, count: number): Promise<void> {
+    const generation = this.generation;
+    const wanted = this.entries.slice(first, first + count)
+                       .filter(entry => !this.metadata.has(entry.key))
+                       .map(entry => entry.key);
+    if (!wanted.length) {
+      return;
+    }
+    let snapshot;
+    try {
+      snapshot = await this.port.metadata(wanted, FIELDS);
+    } catch {
+      // A row without a size is worth far more than a window that refuses to
+      // draw, so this is deliberately not surfaced.
+      return;
+    }
+    if (generation !== this.generation) {
+      return;
+    }
+    for (const [key, value] of snapshot) {
+      this.metadata.set(key, value);
+    }
+    this.list.setMetadata(this.metadata);
+    // Sizes arriving is exactly when a total can become sayable.
+    this.refreshStatus();
+  }
+
+  /** For tests and for the window: what is on screen right now. */
+  state(): SessionState {
+    return this.session.snapshot();
+  }
+
+  destroy(): void {
+    this.status.destroy();
+    this.toolbar.destroy();
+    this.unsubscribe?.();
+    this.unsubscribe = null;
+    this.session.dispose();
+    this.list.destroy();
+    this.sidebar.destroy();
+    this.root.remove();
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/sidebar.ts b/ui/file_manager/file_manager/kibaos/ui/sidebar.ts
new file mode 100644
index 0000000000..55e7aebd19
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/sidebar.ts
@@ -0,0 +1,304 @@
+/**
+ * The places you can go, as our own component.
+ *
+ * Upstream puts this in a shadow root, which is why restyling it needed a
+ * stylesheet pushed into every tree item individually and why its selected
+ * state was unreadable for months: the rule paints on_primary over primary and
+ * a palette that retints those separately lands dark on dark. None of that is
+ * a problem you can have if you own the markup.
+ *
+ * Built as a list of buttons rather than a tree. A tree role promises expand
+ * and collapse semantics, arrow keys that walk levels, and a shape a screen
+ * reader will describe as nested. This is a flat set of destinations in
+ * labelled groups, so it says so.
+ */
+import type {FileKey, Volume, VolumePurpose} from '../port/types.js';
+import {formatSize} from './format.js';
+import {glyph} from './svg.js';
+
+export type PlaceKind =
+    'recent'|'starred'|'trash'|'basket'|'volume'|'network';
+
+export interface Place {
+  readonly key: FileKey;
+  readonly label: string;
+  readonly kind: PlaceKind;
+  readonly volume?: Volume;
+  /**
+   * The free space meter to draw, when this place has earned one.
+   *
+   * Deliberately not `volume.capacity`. Every place on this machine has a
+   * capacity, and drawing all of them is what put fourteen identical bars down
+   * the sidebar. `placesFor` decides which ones are worth showing.
+   */
+  readonly capacity?: {readonly total: number, readonly free: number};
+  /** Shown as a count beside the label, for the basket. */
+  readonly badge?: number;
+}
+
+export interface SidebarOptions {
+  readonly onSelect?: (place: Place) => void;
+}
+
+const GLYPHS: Record<PlaceKind|'removable'|'system'|VolumePurpose, string> = {
+  // Drawn from the same family as the row glyphs in `file_row.ts`, so a
+  // Pictures place and a picture in the list read as the same idea.
+  home: 'M3.2 9.6 10 3.8l6.8 5.8M5.6 8.4V16.2h8.8V8.4M8.4 16.2v-4.1h3.2v4.1',
+  desktop: 'M3.5 4.8h13v8.4h-13zM7.6 16.2h4.8M10 13.2v3',
+  documents: 'M6 3.4h5.2l3.6 3.6v9.6H6zM11.2 3.4V7h3.6M8 10.5h5M8 13h5',
+  downloads: 'M10 3.8v7.8m0 0-3.2-3.2M10 11.6l3.2-3.2M4.6 15.8h10.8',
+  music: 'M7.4 13.1V4.6l7.2-1.4v8.5M7.4 13.1a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0zM14.6 11.7a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0z',
+  pictures: 'M3.5 5.5h13v9h-13zM5.5 12.5l3-3.5 2.5 3 2-2.5 2.5 3M7.4 8.6a1 1 0 1 1-2 0 1 1 0 0 1 2 0z',
+  videos: 'M3.5 5.5h9v9h-9zM12.5 10l4-2.5v5zM6.5 5.5v9M9.5 5.5v9',
+  recent: 'M10 5v5l3.5 2M10 3.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13z',
+  starred: 'M10 3.5l2 4.2 4.5.6-3.3 3.2.8 4.5-4-2.2-4 2.2.8-4.5L3.5 8.3l4.5-.6z',
+  trash: 'M4.5 6h11M8 6V4.5h4V6M6 6l.7 9.5h6.6L14 6M8.5 8.5v5M11.5 8.5v5',
+  basket: 'M3.5 7.5h13l-1.4 8h-10.2zM7 7.5 8.5 3.5M13 7.5 11.5 3.5',
+  volume: 'M3 5.5h14v9H3zM3 11.5h14',
+  network: 'M6 14.5a3.5 3.5 0 0 1-.3-7A5 5 0 0 1 15 8.6a3 3 0 0 1-.5 5.9z',
+  system: 'M4 5h12v7H4zM2.5 14.5h15',
+  removable: 'M7 3.5h6v5h2v8H5v-8h2zM9 5v2M11 5v2',
+};
+
+// Everything except the two pictorial fills. A frame with something inside it,
+// filled with a single non zero winding path, floods to a solid block, which is
+// the same trap `file_row.ts` records.
+const STROKED = new Set<string>(['recent', 'trash', 'volume', 'system',
+                                 'removable', 'basket', 'network', 'home',
+                                 'desktop', 'documents', 'downloads', 'music',
+                                 'pictures', 'videos']);
+
+function placeGlyph(kind: string): SVGElement {
+  return glyph(
+      'kibaos-place-glyph', GLYPHS[kind as keyof typeof GLYPHS] ?? GLYPHS.volume,
+      {stroked: STROKED.has(kind), width: 1.5});
+}
+
+function volumeGlyphKind(volume: Volume): string {
+  // What a place is for beats what it is made of. Every user folder on this
+  // machine is a local disk, and drawing the disk on all of them is what made
+  // the sidebar a column of fourteen identical laptops.
+  if (volume.purpose) {
+    return volume.purpose;
+  }
+  if (volume.removable) {
+    return 'removable';
+  }
+  return volume.kind === 'system' ? 'system' : 'volume';
+}
+
+let instances = 0;
+
+export class Sidebar {
+  private readonly nav: HTMLElement;
+  /** Distinguishes this sidebar's heading ids from another pane's. */
+  private readonly instance = ++instances;
+  private places: Place[] = [];
+  private selected: FileKey|null = null;
+
+  constructor(
+      private readonly container: HTMLElement,
+      private readonly options: SidebarOptions = {}) {
+    this.nav = document.createElement('nav');
+    this.nav.className = 'kibaos-sidebar';
+    this.nav.setAttribute('aria-label', 'Places');
+    this.container.appendChild(this.nav);
+    this.nav.addEventListener('click', this.onClick);
+    this.nav.addEventListener('keydown', this.onKeyDown);
+  }
+
+  setPlaces(places: readonly Place[]): void {
+    this.places = places.slice();
+    this.render();
+  }
+
+  setSelected(key: FileKey|null): void {
+    this.selected = key;
+    this.render();
+  }
+
+  private groups(): Array<{title: string, places: Place[]}> {
+    const quick = this.places.filter(
+        place => place.kind === 'recent' || place.kind === 'starred' ||
+            place.kind === 'trash');
+    const volumes = this.places.filter(place => place.kind === 'volume');
+    const elsewhere = this.places.filter(place => place.kind === 'network');
+    const basket = this.places.filter(place => place.kind === 'basket');
+    const out: Array<{title: string, places: Place[]}> = [];
+    if (quick.length) {
+      out.push({title: 'Quick access', places: quick});
+    }
+    // Removable media is separated from what is always there, because a drive
+    // you can pull out and a drive you cannot are not the same kind of place.
+    const fixed = volumes.filter(place => !place.volume?.removable);
+    const removable = volumes.filter(place => place.volume?.removable);
+    if (fixed.length) {
+      out.push({title: 'This computer', places: fixed});
+    }
+    if (removable.length) {
+      out.push({title: 'Devices', places: removable});
+    }
+    // A phone, a container and somebody's Google Drive are not in this
+    // computer and are not devices plugged into it. Filing them under either
+    // is how a sidebar starts lying about where your files actually are.
+    if (elsewhere.length) {
+      out.push({title: 'Elsewhere', places: elsewhere});
+    }
+    if (basket.length) {
+      out.push({title: 'Gathered', places: basket});
+    }
+    return out;
+  }
+
+  private render(): void {
+    this.nav.textContent = '';
+    for (const group of this.groups()) {
+      const section = document.createElement('div');
+      section.className = 'kibaos-place-group';
+      const heading = document.createElement('h2');
+      heading.className = 'kibaos-place-heading';
+      heading.textContent = group.title;
+      const id = `kibaos-group-${this.instance}-` +
+          group.title.replace(/\s+/g, '-').toLowerCase();
+      heading.id = id;
+      const list = document.createElement('ul');
+      list.className = 'kibaos-place-list';
+      list.setAttribute('aria-labelledby', id);
+      for (const place of group.places) {
+        list.appendChild(this.renderPlace(place));
+      }
+      section.append(heading, list);
+      this.nav.appendChild(section);
+    }
+  }
+
+  private renderPlace(place: Place): HTMLElement {
+    const item = document.createElement('li');
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'kibaos-place';
+    button.dataset['key'] = place.key;
+    const current = place.key === this.selected;
+    // aria-current rather than aria-selected: this is where you are, not one
+    // of a set of things you have picked.
+    if (current) {
+      button.setAttribute('aria-current', 'page');
+    }
+    // Where you are is the natural place for the keyboard to land, but only if
+    // it is somewhere this sidebar actually lists. It usually is not: open a
+    // folder three levels down and none of these is current. Falling back to
+    // the first place keeps the sidebar in the tab order instead of dropping
+    // it out of the document entirely.
+    button.tabIndex = place === this.tabStop() ? 0 : -1;
+
+    const kind = place.kind === 'volume' && place.volume ?
+        volumeGlyphKind(place.volume) : place.kind;
+    const label = document.createElement('span');
+    label.className = 'kibaos-place-label';
+    label.textContent = place.label;
+
+    button.appendChild(placeGlyph(kind));
+    button.appendChild(label);
+
+    if (place.badge !== undefined && place.badge > 0) {
+      const badge = document.createElement('span');
+      badge.className = 'kibaos-place-badge';
+      badge.textContent = String(place.badge);
+      // The number is meaningless read on its own, so the button says what it
+      // counts and the badge itself is decoration.
+      button.setAttribute(
+          'aria-label',
+          `${place.label}, ${place.badge} ${place.badge === 1 ? 'item' : 'items'}`);
+      button.appendChild(badge);
+    }
+
+    item.appendChild(button);
+
+    const {capacity} = place;
+    if (capacity && capacity.total > 0) {
+      // Exact free space in words, with the bar as the supplement. A ring or a
+      // bar on its own is poor for comparison and worse for anybody who cannot
+      // see it, so the sentence carries the meaning.
+      const used = 1 - capacity.free / capacity.total;
+      const meter = document.createElement('div');
+      meter.className = 'kibaos-place-capacity';
+      const text = document.createElement('span');
+      text.className = 'kibaos-place-free';
+      text.textContent =
+          `${formatSize(capacity.free)} free of ${formatSize(capacity.total)}`;
+      const bar = document.createElement('div');
+      bar.className = 'kibaos-place-bar';
+      bar.setAttribute('role', 'img');
+      bar.setAttribute('aria-hidden', 'true');
+      const fill = document.createElement('div');
+      fill.className = 'kibaos-place-bar-fill';
+      fill.style.inlineSize = `${Math.round(used * 100)}%`;
+      if (used >= 0.98) {
+        fill.dataset['level'] = 'full';
+      } else if (used >= 0.90) {
+        fill.dataset['level'] = 'high';
+      }
+      bar.appendChild(fill);
+      meter.append(text, bar);
+      item.appendChild(meter);
+    }
+
+    return item;
+  }
+
+  private tabStop(): Place|undefined {
+    return this.places.find(place => place.key === this.selected) ??
+        this.places[0];
+  }
+
+  private buttons(): HTMLElement[] {
+    return [...this.nav.querySelectorAll<HTMLElement>('.kibaos-place')];
+  }
+
+  private activate(button: HTMLElement): void {
+    const key = button.dataset['key'];
+    const place = this.places.find(candidate => candidate.key === key);
+    if (place) {
+      this.options.onSelect?.(place);
+    }
+  }
+
+  private onClick = (event: MouseEvent): void => {
+    const button = (event.target as HTMLElement|null)?.closest?.('.kibaos-place');
+    if (button) {
+      this.activate(button as HTMLElement);
+    }
+  };
+
+  // Arrow keys walk the whole sidebar rather than one group, because the
+  // grouping is a way of reading it and not a set of separate controls.
+  private onKeyDown = (event: KeyboardEvent): void => {
+    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' &&
+        event.key !== 'Home' && event.key !== 'End') {
+      return;
+    }
+    const buttons = this.buttons();
+    if (!buttons.length) {
+      return;
+    }
+    const active = document.activeElement as HTMLElement|null;
+    const at = buttons.findIndex(button => button === active);
+    let next: number;
+    switch (event.key) {
+      case 'ArrowDown': next = at < 0 ? 0 : Math.min(buttons.length - 1, at + 1); break;
+      case 'ArrowUp': next = at < 0 ? 0 : Math.max(0, at - 1); break;
+      case 'Home': next = 0; break;
+      default: next = buttons.length - 1;
+    }
+    for (const button of buttons) {
+      button.tabIndex = -1;
+    }
+    buttons[next]!.tabIndex = 0;
+    buttons[next]!.focus();
+    event.preventDefault();
+  };
+
+  destroy(): void {
+    this.nav.remove();
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/status_bar.ts b/ui/file_manager/file_manager/kibaos/ui/status_bar.ts
new file mode 100644
index 0000000000..f53c67152b
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/status_bar.ts
@@ -0,0 +1,107 @@
+/**
+ * What is in front of you, along the bottom.
+ *
+ * The hard part of a status bar is not the layout, it is knowing when to keep
+ * quiet. Metadata is fetched for the window on screen rather than the whole
+ * directory, so a total assembled from whatever happens to have arrived is a
+ * number that changes as you scroll and is wrong until you reach the end. This
+ * shows a size only when every file it is counting has actually reported one,
+ * and otherwise says how many things there are and stops there.
+ *
+ * Deliberately not a live region. The list is a listbox and already announces
+ * each row as focus moves through it, so a polite region repeating the count
+ * would speak over the row you just arrived at. Announcing bulk changes only,
+ * such as select all, would be better than either and is not built yet.
+ */
+import {formatCount, formatSelection, formatSize} from './format.js';
+
+export interface StatusModel {
+  readonly folders: number;
+  readonly files: number;
+  readonly selected: number;
+  /** Bytes, or null when a size is missing for anything being counted. */
+  readonly bytes: number|null;
+  readonly capacity: {readonly total: number, readonly free: number}|null;
+}
+
+const EMPTY: StatusModel = {
+  folders: 0,
+  files: 0,
+  selected: 0,
+  bytes: null,
+  capacity: null,
+};
+
+export class StatusBar {
+  private readonly bar: HTMLElement;
+  private readonly summary: HTMLElement;
+  private readonly space: HTMLElement;
+  private readonly free: HTMLElement;
+  private readonly bar_fill: HTMLElement;
+  private model: StatusModel = EMPTY;
+
+  constructor(container: HTMLElement) {
+    this.bar = document.createElement('div');
+    this.bar.className = 'kibaos-status';
+    // The window's summary of itself, which is what contentinfo is for.
+    this.bar.setAttribute('role', 'contentinfo');
+
+    this.summary = document.createElement('span');
+    this.summary.className = 'kibaos-status-summary';
+
+    this.space = document.createElement('div');
+    this.space.className = 'kibaos-status-space';
+    this.free = document.createElement('span');
+    this.free.className = 'kibaos-status-free';
+    const track = document.createElement('div');
+    track.className = 'kibaos-status-track';
+    // The sentence beside it carries the meaning, so this is not read out.
+    track.setAttribute('aria-hidden', 'true');
+    this.bar_fill = document.createElement('div');
+    this.bar_fill.className = 'kibaos-status-fill';
+    track.appendChild(this.bar_fill);
+    this.space.append(this.free, track);
+
+    this.bar.append(this.summary, this.space);
+    container.appendChild(this.bar);
+    this.render();
+  }
+
+  set(model: StatusModel): void {
+    this.model = model;
+    this.render();
+  }
+
+  private summaryText(): string {
+    const {folders, files, selected, bytes} = this.model;
+    const head =
+        selected > 0 ? formatSelection(selected) : formatCount(folders, files);
+    // Only when the number is real. A total that grows as you scroll is worse
+    // than no total, because it looks like an answer.
+    return bytes === null ? head : `${head}, ${formatSize(bytes)}`;
+  }
+
+  private render(): void {
+    this.summary.textContent = this.summaryText();
+    const capacity = this.model.capacity;
+    if (!capacity || capacity.total <= 0) {
+      this.space.hidden = true;
+      return;
+    }
+    this.space.hidden = false;
+    this.free.textContent = `${formatSize(capacity.free)} free`;
+    const used = 1 - capacity.free / capacity.total;
+    this.bar_fill.style.inlineSize = `${Math.round(used * 100)}%`;
+    if (used >= 0.98) {
+      this.bar_fill.dataset['level'] = 'full';
+    } else if (used >= 0.90) {
+      this.bar_fill.dataset['level'] = 'high';
+    } else {
+      delete this.bar_fill.dataset['level'];
+    }
+  }
+
+  destroy(): void {
+    this.bar.remove();
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/svg.ts b/ui/file_manager/file_manager/kibaos/ui/svg.ts
new file mode 100644
index 0000000000..c5d41fd165
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/svg.ts
@@ -0,0 +1,73 @@
+/**
+ * Glyphs as nodes rather than as markup.
+ *
+ * Every glyph in this app used to be a template string assigned to innerHTML.
+ * That works in a plain page and throws on chrome://file-manager, which
+ * requires Trusted Types and refuses a bare string at that sink. Nothing local
+ * caught it, because the harness pages carried no such policy. They do now, so
+ * this particular way of being wrong cannot come back quietly.
+ *
+ * Building the nodes is the right way round for SVG regardless.
+ * `createElement('svg')` makes an HTMLUnknownElement that renders nothing,
+ * which is why the string form was reached for in the first place.
+ */
+
+const SVG_NS = 'http://www.w3.org/2000/svg';
+
+/** How a glyph's path is painted. */
+export interface Stroke {
+  /** Drawn as an outline rather than filled. */
+  readonly stroked: boolean;
+  /** Line width when stroked. Ignored when filled. */
+  readonly width?: number;
+}
+
+/**
+ * An `<svg>` holding one empty `<path>`.
+ *
+ * Empty because a recycled row keeps the element it already has and only ever
+ * changes the path's attributes. See `file_row.ts` for why that split matters.
+ */
+export function glyphElement(className: string): SVGElement {
+  const svg = document.createElementNS(SVG_NS, 'svg');
+  // setAttribute rather than `.className`: on an SVGElement that property is a
+  // read only SVGAnimatedString, and assigning a string to it does nothing at
+  // all rather than failing.
+  svg.setAttribute('class', className);
+  svg.setAttribute('viewBox', '0 0 20 20');
+  svg.setAttribute('aria-hidden', 'true');
+  svg.appendChild(document.createElementNS(SVG_NS, 'path'));
+  return svg;
+}
+
+/**
+ * Points an existing path at a shape.
+ *
+ * Every attribute the other branch sets is cleared here, because a recycled row
+ * that goes from a stroked glyph to a filled one keeps whatever the last one
+ * left behind.
+ */
+export function drawPath(path: Element, d: string, stroke: Stroke): void {
+  path.setAttribute('d', d);
+  if (stroke.stroked) {
+    path.setAttribute('fill', 'none');
+    path.setAttribute('stroke', 'currentColor');
+    path.setAttribute('stroke-width', String(stroke.width ?? 1.6));
+    path.setAttribute('stroke-linejoin', 'round');
+    path.setAttribute('stroke-linecap', 'round');
+  } else {
+    path.setAttribute('fill', 'currentColor');
+    path.removeAttribute('stroke');
+    path.removeAttribute('stroke-width');
+    path.removeAttribute('stroke-linejoin');
+    path.removeAttribute('stroke-linecap');
+  }
+}
+
+/** A finished glyph, for the places that draw one and never change it. */
+export function glyph(
+    className: string, d: string, stroke: Stroke): SVGElement {
+  const svg = glyphElement(className);
+  drawPath(svg.firstElementChild!, d, stroke);
+  return svg;
+}
diff --git a/ui/file_manager/file_manager/kibaos/ui/tokens.css b/ui/file_manager/file_manager/kibaos/ui/tokens.css
new file mode 100644
index 0000000000..96f144dcfd
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/tokens.css
@@ -0,0 +1,617 @@
+/**
+ * The KibaOS surface vocabulary.
+ *
+ * The accent is not a new decision. The greeter already defines it, in GTK
+ * theme variables rather than in its stylesheet: accent_bg_color is #6d4ea1 in
+ * theme.css and #d1bcff in theme-dark.css, and the installer's token table
+ * carries the same pair. Counting literal hex in greeter.css and concluding the
+ * greeter was achromatic was a mistake; it uses @accent_color for focus rings
+ * and the active pod.
+ *
+ * Surfaces are taken from the greeter's own values: translucent grounds, white
+ * hairlines, white overlay interactive states, and deep soft shadows.
+ */
+
+:root {
+  --kibaos-accent: #6d4ea1;
+  --kibaos-on-accent: #ffffff;
+
+  --kibaos-ground: #f4f2f9;
+  --kibaos-panel: #ffffff;
+  --kibaos-line: #e6e2f0;
+  --kibaos-ink: #1c1a24;
+  --kibaos-quiet: #6b6580;
+
+  --kibaos-row-hover: rgba(0, 0, 0, .04);
+  --kibaos-row-selected: rgba(109, 78, 161, .12);
+  --kibaos-tile: #f0edf7;
+  --kibaos-tile-dir: #e4dbf8;
+  --kibaos-tile-selected: #dbcdf6;
+  --kibaos-glyph: #6f6885;
+  --kibaos-tag-bg: #f7f5fc;
+  --kibaos-warn: #a1651a;
+  --kibaos-danger: #b3261e;
+
+  --kibaos-radius-row: 11px;
+  --kibaos-radius-tile: 11px;
+  --kibaos-radius-panel: 16px;
+  --kibaos-radius-pill: 999px;
+
+  --kibaos-row-height: 40px;
+  --kibaos-tile-size: 32px;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-kibaos-theme="light"]) {
+    --kibaos-accent: #d1bcff;
+    --kibaos-on-accent: #3f1d6c;
+
+    --kibaos-ground: #100f16;
+    --kibaos-panel: #191823;
+    --kibaos-line: #262433;
+    --kibaos-ink: #efecf8;
+    --kibaos-quiet: #948ea8;
+
+    --kibaos-row-hover: rgba(255, 255, 255, .06);
+    --kibaos-row-selected: rgba(209, 188, 255, .16);
+    --kibaos-tile: #23212f;
+    --kibaos-tile-dir: #372c57;
+    --kibaos-tile-selected: #4a3b74;
+    --kibaos-glyph: #a79dc4;
+    --kibaos-tag-bg: #211f2c;
+  --kibaos-warn: #e6b062;
+  --kibaos-danger: #f2b8b5;
+  }
+}
+
+/* Repeated rather than shared, because a media query and an attribute cannot
+   select the same block. The attribute form is what lets both themes be
+   rendered and diffed without emulating the reader's system setting. */
+:root[data-kibaos-theme="dark"] {
+    --kibaos-accent: #d1bcff;
+    --kibaos-on-accent: #3f1d6c;
+
+    --kibaos-ground: #100f16;
+    --kibaos-panel: #191823;
+    --kibaos-line: #262433;
+    --kibaos-ink: #efecf8;
+    --kibaos-quiet: #948ea8;
+
+    --kibaos-row-hover: rgba(255, 255, 255, .06);
+    --kibaos-row-selected: rgba(209, 188, 255, .16);
+    --kibaos-tile: #23212f;
+    --kibaos-tile-dir: #372c57;
+    --kibaos-tile-selected: #4a3b74;
+    --kibaos-glyph: #a79dc4;
+    --kibaos-tag-bg: #211f2c;
+  --kibaos-warn: #e6b062;
+  --kibaos-danger: #f2b8b5;
+}
+
+/* Density is fixed per mode, never measured. Dynamic row heights across a
+   hundred thousand entries make the scrollbar thumb jitter and drop frames. */
+:root[data-kibaos-density="compact"] { --kibaos-row-height: 32px; --kibaos-tile-size: 26px; }
+:root[data-kibaos-density="relaxed"] { --kibaos-row-height: 52px; --kibaos-tile-size: 38px; }
+
+.kibaos-row {
+  align-items: center;
+  block-size: var(--kibaos-row-height);
+  border-radius: var(--kibaos-radius-row);
+  box-sizing: border-box;
+  color: var(--kibaos-ink);
+  display: grid;
+  gap: 12px;
+  grid-template-columns: var(--kibaos-tile-size) 1fr 84px 96px 132px;
+  margin-inline: 8px;
+  padding-inline: 8px;
+  position: relative;
+  user-select: none;
+}
+
+.kibaos-row:hover { background: var(--kibaos-row-hover); }
+
+/* Selection and focus differ by shape as well as colour, because colour alone
+   is not a distinction everyone can see. */
+.kibaos-row[aria-selected="true"] {
+  background: var(--kibaos-row-selected);
+  box-shadow: inset 3px 0 0 0 var(--kibaos-accent);
+}
+.kibaos-row:focus-visible {
+  outline: 2px solid var(--kibaos-accent);
+  outline-offset: -2px;
+}
+
+/* A cut entry is dashed as well as dimmed, so it reads as pending rather than
+   as disabled. */
+.kibaos-row[data-cut="true"] { opacity: .55; }
+.kibaos-row[data-cut="true"] .kibaos-tile {
+  border: 1px dashed var(--kibaos-quiet);
+}
+
+.kibaos-tile {
+  align-items: center;
+  background: var(--kibaos-tile);
+  block-size: var(--kibaos-tile-size);
+  border-radius: var(--kibaos-radius-tile);
+  box-sizing: border-box;
+  display: flex;
+  inline-size: var(--kibaos-tile-size);
+  justify-content: center;
+}
+.kibaos-row[data-directory="true"] .kibaos-tile { background: var(--kibaos-tile-dir); }
+.kibaos-row[aria-selected="true"] .kibaos-tile { background: var(--kibaos-tile-selected); }
+
+.kibaos-glyph {
+  block-size: 18px;
+  color: var(--kibaos-glyph);
+  inline-size: 18px;
+}
+.kibaos-row[data-directory="true"] .kibaos-glyph { color: var(--kibaos-accent); }
+
+.kibaos-name {
+  font-size: 13px;
+  font-weight: 550;
+  letter-spacing: -.005em;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.kibaos-size, .kibaos-date {
+  color: var(--kibaos-quiet);
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+}
+
+/* A quiet proportional bar behind the size, so the large item in a folder of
+   five hundred is visible without reading a digit. */
+.kibaos-size { position: relative; }
+.kibaos-size::before {
+  background: currentColor;
+  block-size: 100%;
+  content: '';
+  inset-block-start: 0;
+  inset-inline-start: 0;
+  inline-size: var(--kibaos-share, 0%);
+  opacity: .10;
+  position: absolute;
+  border-radius: 3px;
+}
+
+.kibaos-type {
+  background: var(--kibaos-tag-bg);
+  border: 1px solid var(--kibaos-line);
+  border-radius: var(--kibaos-radius-pill);
+  color: var(--kibaos-quiet);
+  font-size: 10.5px;
+  font-weight: 600;
+  justify-self: start;
+  letter-spacing: .04em;
+  line-height: 15px;
+  padding: 2px 9px;
+}
+
+/* The list owns its scrolling. The spacer carries the full extent so the
+   scrollbar is honest about how much there is, and the surface holding the
+   recycled rows is moved rather than repositioned per row. */
+.kibaos-list {
+  block-size: 100%;
+  overflow-y: auto;
+  overflow-x: hidden;
+  position: relative;
+}
+.kibaos-list:focus-visible { outline: none; }
+.kibaos-list-spacer { position: relative; }
+.kibaos-list-surface {
+  inset-block-start: 0;
+  inset-inline: 0;
+  position: absolute;
+  will-change: transform;
+}
+
+/* An empty view should read as prepared rather than abandoned, so it is
+   centred and quiet rather than a message pinned to the top left. */
+/* An author `display` beats the user agent's `[hidden] { display: none }`
+   regardless of specificity, because author styles win on origin. So setting
+   .hidden on this element did nothing at all and every folder with files in it
+   also announced that it was empty. */
+.kibaos-empty[hidden] { display: none; }
+.kibaos-empty {
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  justify-content: center;
+  min-block-size: 220px;
+  padding: 32px 24px;
+  text-align: center;
+}
+.kibaos-empty-title {
+  color: var(--kibaos-ink);
+  font-size: 14px;
+  font-weight: 600;
+  margin: 0;
+}
+.kibaos-empty-detail {
+  color: var(--kibaos-quiet);
+  font-size: 13px;
+  margin: 0;
+  /* Wide enough that a two line detail breaks after a clause rather than
+     stranding "files." on its own. */
+  max-inline-size: 48ch;
+}
+
+
+/* The sidebar: where you can go, as opposed to what is in front of you.
+
+   Group headings are quiet and small rather than uppercase and tracked out.
+   Small caps at this size is a legibility cost paid for a filing cabinet
+   aesthetic nobody asked for, and these are three or four words that want to
+   be skimmed past on the way to the thing underneath. */
+.kibaos-sidebar {
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  inline-size: 232px;
+  overflow-y: auto;
+  padding: 12px 10px;
+}
+.kibaos-place-heading {
+  color: var(--kibaos-quiet);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: .01em;
+  margin: 0 0 4px;
+  padding-inline: 10px;
+}
+.kibaos-place-list {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.kibaos-place {
+  align-items: center;
+  background: none;
+  border: 0;
+  border-radius: var(--kibaos-radius-row);
+  color: var(--kibaos-ink);
+  cursor: default;
+  display: flex;
+  font: inherit;
+  gap: 10px;
+  inline-size: 100%;
+  padding: 7px 10px;
+  position: relative;
+  text-align: start;
+}
+.kibaos-place:hover { background: var(--kibaos-row-hover); }
+.kibaos-place:focus-visible {
+  outline: 2px solid var(--kibaos-accent);
+  outline-offset: -2px;
+}
+.kibaos-place[aria-current="page"] {
+  background: var(--kibaos-row-selected);
+  color: var(--kibaos-accent);
+  font-weight: 600;
+}
+/* A rail rather than a full bleed fill. The fill alone reads as a hover that
+   got stuck; the rail is what says this is where you are. */
+.kibaos-place[aria-current="page"]::before {
+  background: var(--kibaos-accent);
+  block-size: 16px;
+  border-radius: var(--kibaos-radius-pill);
+  content: "";
+  inline-size: 3px;
+  inset-block-start: 50%;
+  inset-inline-start: 1px;
+  position: absolute;
+  translate: 0 -50%;
+}
+.kibaos-place-glyph {
+  block-size: 18px;
+  color: var(--kibaos-glyph);
+  flex: none;
+  inline-size: 18px;
+}
+.kibaos-place[aria-current="page"] .kibaos-place-glyph { color: inherit; }
+.kibaos-place-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.kibaos-place-badge {
+  background: var(--kibaos-tag-bg);
+  border-radius: var(--kibaos-radius-pill);
+  color: var(--kibaos-quiet);
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+  margin-inline-start: auto;
+  padding: 1px 7px;
+}
+.kibaos-place[aria-current="page"] .kibaos-place-badge {
+  background: var(--kibaos-panel);
+  color: var(--kibaos-accent);
+}
+
+/* Capacity sits under the drive it belongs to, indented to the label rather
+   than the glyph, so the eye reads it as a note about that row. */
+.kibaos-place-capacity {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding: 1px 10px 6px 38px;
+}
+.kibaos-place-free {
+  color: var(--kibaos-quiet);
+  font-size: 11px;
+}
+.kibaos-place-bar {
+  background: var(--kibaos-line);
+  block-size: 3px;
+  border-radius: var(--kibaos-radius-pill);
+  overflow: hidden;
+}
+.kibaos-place-bar-fill {
+  background: var(--kibaos-accent);
+  block-size: 100%;
+  border-radius: inherit;
+}
+.kibaos-place-bar-fill[data-level="high"] { background: var(--kibaos-warn); }
+.kibaos-place-bar-fill[data-level="full"] { background: var(--kibaos-danger); }
+
+
+/* Where the app mounts us.
+
+   Opaque and over everything, because the stock window is still underneath and
+   still running: it owns the dialogs, the progress panel and the menus we have
+   not replaced. Drawing over it rather than deleting it is what makes this
+   reversible, and `mountKibaosShell` removes this element if the shell fails
+   to start, which puts the old window straight back. */
+#kibaos-shell {
+  background: var(--kibaos-ground);
+  inset: 0;
+  overflow: hidden;
+  position: fixed;
+  z-index: 2147483647;
+}
+
+/* The window. Places on the left, what is in them on the right, each on its
+   own panel so the ground shows between them: the greeter does the same thing,
+   and it is what stops a file manager reading as one undifferentiated grid. */
+.kibaos-shell {
+  background: var(--kibaos-ground);
+  block-size: 100%;
+  box-sizing: border-box;
+  display: flex;
+  gap: 8px;
+  padding: 8px;
+}
+.kibaos-shell-aside {
+  background: var(--kibaos-panel);
+  border: 1px solid var(--kibaos-line);
+  border-radius: var(--kibaos-radius-panel);
+  display: flex;
+  flex: none;
+  overflow: hidden;
+}
+.kibaos-shell-main {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 8px;
+  /* Without this a long file name makes the whole window wider instead of
+     being truncated, and the sidebar gets pushed off the left edge. */
+  min-inline-size: 0;
+}
+.kibaos-shell-list {
+  background: var(--kibaos-panel);
+  border: 1px solid var(--kibaos-line);
+  border-radius: var(--kibaos-radius-panel);
+  flex: 1;
+  min-block-size: 0;
+  overflow: hidden;
+  padding: 4px 0;
+}
+.kibaos-shell-notice {
+  background: var(--kibaos-panel);
+  border: 1px solid var(--kibaos-line);
+  border-radius: var(--kibaos-radius-panel);
+  color: var(--kibaos-quiet);
+  font-size: 13px;
+  margin: 0;
+  padding: 11px 15px;
+}
+
+
+/* The toolbar. Back, forward, up, then where you are.
+
+   The buttons are disabled rather than removed when there is nowhere to go: a
+   control that appears and disappears shifts everything beside it, and the one
+   thing you need from back and forward is that they are always in the same
+   place. */
+.kibaos-toolbar {
+  align-items: center;
+  /* The containing block for a sibling popover, which cannot live inside the
+     path bar because that clips. */
+  position: relative;
+  background: var(--kibaos-panel);
+  border: 1px solid var(--kibaos-line);
+  border-radius: var(--kibaos-radius-panel);
+  display: flex;
+  flex: none;
+  gap: 8px;
+  min-block-size: 44px;
+  padding: 5px 8px;
+}
+.kibaos-tool-group {
+  display: flex;
+  flex: none;
+  gap: 2px;
+}
+.kibaos-tool {
+  align-items: center;
+  background: none;
+  border: 0;
+  border-radius: var(--kibaos-radius-tile);
+  block-size: 30px;
+  color: var(--kibaos-glyph);
+  cursor: default;
+  display: flex;
+  inline-size: 30px;
+  justify-content: center;
+  padding: 0;
+}
+.kibaos-tool:hover:not(:disabled) {
+  background: var(--kibaos-row-hover);
+  color: var(--kibaos-ink);
+}
+.kibaos-tool:focus-visible {
+  outline: 2px solid var(--kibaos-accent);
+  outline-offset: -2px;
+}
+/* Not display:none and not 0.3 either. A disabled control still has to read as
+   a control, or the row looks like it lost something. */
+.kibaos-tool:disabled { opacity: .38; }
+.kibaos-tool-glyph { block-size: 18px; inline-size: 18px; }
+
+.kibaos-path {
+  flex: 1;
+  min-inline-size: 0;
+  overflow: hidden;
+}
+.kibaos-path-list {
+  align-items: center;
+  display: flex;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.kibaos-path-list > li { display: flex; position: relative; }
+.kibaos-crumb {
+  background: none;
+  border: 0;
+  border-radius: var(--kibaos-radius-tile);
+  color: var(--kibaos-quiet);
+  cursor: default;
+  font: inherit;
+  max-inline-size: 22ch;
+  overflow: hidden;
+  padding: 5px 8px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.kibaos-crumb:hover { background: var(--kibaos-row-hover); }
+.kibaos-crumb:focus-visible,
+.kibaos-chevron:focus-visible,
