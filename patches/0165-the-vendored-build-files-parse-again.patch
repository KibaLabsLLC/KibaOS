@@ -0,0 +1,70 @@
+/**
+ * The contract, run against the real adapter.
+ *
+ * This is the file the port's docstring has been promising since M0: the same
+ * cases, two implementations, and a difference between them is a bug in
+ * whichever one is lying. Four capabilities are implemented so far, and the six
+ * cases covering the rest are reported as not run rather than passed over.
+ */
+import {ChromeOsBackend} from '../../adapter/chromeos_backend.js';
+import type {FileKey} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import type {Capability, Fixture} from '../contract/port_contract.js';
+import {runContract} from '../contract/port_contract.js';
+import {FakePlatform} from './fake_platform.js';
+
+const ROOT = 'filesystem:chrome://file-manager/external/myfiles';
+const USB = 'filesystem:chrome://file-manager/external/usb';
+
+/** Our codes back to the DOMException names the platform actually throws. */
+const DOM_NAMES: Record<string, string> = {
+  'not-found': 'NotFoundError',
+  'permission-denied': 'SecurityError',
+  'read-only': 'NoModificationAllowedError',
+  'no-space': 'QuotaExceededError',
+  cancelled: 'AbortError',
+  unsupported: 'TypeMismatchError',
+  io: 'InvalidStateError',
+  busy: 'InvalidStateError',
+};
+
+/**
+ * Everything except naming the process holding a file open, which ChromeOS
+ * simply does not report. See the Capability comment in the contract.
+ */
+export const IMPLEMENTED: readonly Capability[] =
+    ['list', 'metadata', 'watch', 'volumes', 'search', 'tasks',
+     'task-execution', 'io', 'io-failure', 'dialog'];
+
+export function makeAdapterFixture(): Fixture {
+  const platform = new FakePlatform();
+  platform.addVolume({
+    volumeId: 'system',
+    volumeType: 'downloads',
+    label: 'My files',
+    url: ROOT,
+    sizeStats: {totalSize: 512e9, remainingSize: 8.7e9},
+  });
+  platform.addVolume({
+    volumeId: 'usb',
+    volumeType: 'removable',
+    label: 'Samsung Flash Drive',
+    url: USB,
+    sizeStats: {totalSize: 128e9, remainingSize: 96e9},
+  });
+  return {
+    port: new ChromeOsBackend(platform),
+    root: asFileKey(ROOT),
+    add: (parent: FileKey, name: string, isDirectory: boolean) =>
+        asFileKey(platform.add(parent, name, isDirectory, {size: 1024})),
+    remove: (key: FileKey) => platform.remove(key),
+    // An operation failure, not a resolution one: the contract's io cases are
+    // about a file that is there and will not budge.
+    failWith: (key: FileKey, error: FilesError) =>
+        platform.failOperation(key, DOM_NAMES[error.code] ?? 'InvalidStateError'),
+  };
+}
+
+export async function runAdapterContract() {
+  return runContract('ChromeOsBackend', makeAdapterFixture, IMPLEMENTED);
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/contract/port_contract.ts b/ui/file_manager/file_manager/kibaos/tests/contract/port_contract.ts
new file mode 100644
index 0000000000..7103c14c76
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/contract/port_contract.ts
@@ -0,0 +1,528 @@
+/**
+ * The contract every backend must satisfy, mock and real alike.
+ *
+ * Parameterised by a factory rather than written against the mock, because a
+ * suite that only exercises the mock proves the mock agrees with itself. The
+ * same file runs against ChromeBackend, and a difference between them is a bug
+ * in whichever one is lying.
+ */
+import type {FilesBackendPort} from '../../port/port.js';
+import type {ChangeEvent, EntryDto, FileKey, IoProgress, Volume} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import {beginCheck} from '../progress.js';
+
+export interface Fixture {
+  port: FilesBackendPort;
+  root: FileKey;
+  /**
+   * Adds an entry out of band, the way another process would.
+   *
+   * May answer with a promise. A fixture backed by an in memory store hands
+   * back a key immediately, and one backed by a real filesystem cannot: the
+   * file does not exist until the disk says so, and returning before then would
+   * race every assertion that follows.
+   */
+  add(parent: FileKey, name: string, isDirectory: boolean):
+      FileKey|Promise<FileKey>;
+  remove(key: FileKey): void|Promise<void>;
+  /**
+   * Makes an operation on this entry fail.
+   *
+   * Only a fixture that controls the failure can do this, which a real
+   * filesystem does not: it fails when it fails. Cases that need it are tagged
+   * `io-failure` so a backend over real hardware can decline them by name
+   * rather than by pretending.
+   */
+  failWith(key: FileKey, error: FilesError): void;
+  /**
+   * Waits until a watch opened a moment ago is actually live.
+   *
+   * Optional, and the default is a macrotask, which is all an in memory backend
+   * needs. A backend over real ChromeOS needs considerably more: `addFileWatch`
+   * is a round trip to the browser process, and a change made before it returns
+   * is not delivered to anybody. That window is documented in `platform.ts` and
+   * the hardware run is what demonstrated it, by waiting forever for an event
+   * that was never going to come.
+   *
+   * This is a gap in the port, not only in the fixture. Nothing in
+   * `FilesBackendPort` lets a caller know a watch is live. The app does not
+   * notice because it opens the watch and then lists, and the listing covers
+   * the window. Anyone who watches without listing is racing.
+   */
+  armed?(): Promise<void>;
+}
+
+/**
+ * What a case exercises.
+ *
+ * A backend that implements some of the port and not the rest is the normal
+ * state of affairs part way through building one. Tagging cases lets such a
+ * backend run everything it claims and have the remainder reported as skipped,
+ * rather than the suite either failing on unfinished work or, far worse,
+ * quietly not covering it.
+ */
+export type Capability = 'list'|'metadata'|'watch'|'search'|'tasks'|'io'|
+    /**
+     * Making an operation fail on demand. Separate from `io` because a fixture
+     * over a real filesystem cannot do it: a disk fails when it fails, and
+     * cannot be told to. A backend that runs against real hardware declines
+     * this one by name rather than by pretending the assertion passed.
+     */
+    'io-failure'|
+    /**
+     * Actually running a task. Separate from `tasks` because on a real machine
+     * it launches a real application: the default handler for a text file on
+     * the Dell is the Files app's own viewer, so a contract run that executed
+     * one navigated the very window the test was running in and took the
+     * debugger connection with it. Offering tasks is safe to check anywhere.
+     * Running one is not.
+     */
+    'task-execution'|
+    /**
+     * Naming the process holding a file open. Separate from `io` because it is
+     * genuinely separate: ChromeOS reports a failed operation as a
+     * `ProgressStatus` carrying an error name and nothing else, so there is no
+     * holder to be had from that API at all. On Linux it would come from the
+     * host bridge asking who has the file open, which is not built. Folding it
+     * into `io` would have meant either a backend failing a case it cannot
+     * satisfy, or the assertion being dropped and the mock losing coverage of a
+     * feature we do intend to have.
+     */
+    'io-holder'|'volumes'|'dialog';
+
+/**
+ * A fixture as a case receives it, with the arming wait filled in.
+ *
+ * `armed` is optional on `Fixture` because most fixtures have no opinion about
+ * it, and never optional here because the runner supplies the default before a
+ * case ever runs.
+ */
+export type ArmedFixture = Fixture&{armed(): Promise<void>};
+
+export interface Case {
+  name: string;
+  capability: Capability;
+  run(fixture: ArmedFixture): Promise<void>;
+}
+
+class AssertionError extends Error {}
+
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(`${message}: expected ${expected}, got ${actual}`);
+  }
+}
+
+async function collect(pages: AsyncIterable<{entries: readonly EntryDto[]}>):
+    Promise<EntryDto[]> {
+  const out: EntryDto[] = [];
+  for await (const page of pages) {
+    out.push(...page.entries);
+  }
+  return out;
+}
+
+async function rejects(
+    body: () => Promise<unknown>, code: string, message: string):
+    Promise<void> {
+  try {
+    await body();
+  } catch (error) {
+    assert(error instanceof FilesError, `${message}: not a FilesError`);
+    equal(error.code, code, message);
+    return;
+  }
+  throw new AssertionError(`${message}: nothing was thrown`);
+}
+
+/**
+ * Waits until a watch has actually armed.
+ *
+ * A single microtask used to be enough, because the mock arms in one. A backend
+ * over ChromeOS cannot: the platform never says what changed, only that
+ * something did, so the adapter has to read the directory once to have anything
+ * to compare against, and that read is several awaits deep. Making the change
+ * before it lands means the baseline already contains the change, and the diff
+ * then correctly reports nothing, which reads as a hang.
+ *
+ * A macrotask boundary drains every microtask chain queued behind it, which is
+ * all any in-memory backend needs.
+ */
+export async function armed(): Promise<void> {
+  await new Promise(resolve => setTimeout(resolve, 0));
+}
+
+export const CASES: Case[] = [
+  {
+    name: 'lists the entries in a directory',
+    capability: 'list',
+    async run({port, root, add}) {
+      await add(root, 'alpha.txt', false);
+      await add(root, 'beta', true);
+      const entries = await collect(port.list(root));
+      equal(entries.length, 2, 'entry count');
+      assert(entries.some(e => e.name === 'alpha.txt'), 'alpha.txt is listed');
+      assert(
+          entries.find(e => e.name === 'beta')!.isDirectory,
+          'beta is a directory');
+    },
+  },
+  {
+    name: 'pages a long listing and marks only the last page done',
+    capability: 'list',
+    async run({port, root, add}) {
+      for (let i = 0; i < 25; i++) {
+        await add(root, `file-${i}.txt`, false);
+      }
+      const dones: boolean[] = [];
+      let total = 0;
+      for await (const page of port.list(root, {pageSize: 10})) {
+        dones.push(page.done);
+        total += page.entries.length;
+      }
+      equal(total, 25, 'entries across all pages');
+      equal(dones.filter(d => d).length, 1, 'exactly one page marked done');
+      equal(dones[dones.length - 1], true, 'the last page is the one marked');
+    },
+  },
+  {
+    name: 'hides dotfiles unless asked',
+    capability: 'list',
+    async run({port, root, add}) {
+      await add(root, 'visible.txt', false);
+      await add(root, '.hidden', false);
+      equal((await collect(port.list(root))).length, 1, 'hidden by default');
+      equal(
+          (await collect(port.list(root, {showHidden: true}))).length, 2,
+          'shown when asked');
+    },
+  },
+  {
+    name: 'stops listing when the caller aborts',
+    capability: 'list',
+    async run({port, root, add}) {
+      for (let i = 0; i < 50; i++) {
+        await add(root, `f${i}`, false);
+      }
+      const controller = new AbortController();
+      let pages = 0;
+      for await (const _page of port.list(
+                   root, {pageSize: 5, signal: controller.signal})) {
+        pages++;
+        controller.abort();
+      }
+      equal(pages, 1, 'iteration stopped after the abort');
+    },
+  },
+  {
+    name: 'reports not-found for an entry that is not there',
+    capability: 'list',
+    async run({port}) {
+      await rejects(
+          () => collect(port.list(asFileKey('nowhere'))), 'not-found',
+          'listing a missing directory');
+    },
+  },
+  {
+    name: 'refuses to list something that is not a directory',
+    capability: 'list',
+    async run({port, root, add}) {
+      const file = await add(root, 'plain.txt', false);
+      await rejects(
+          () => collect(port.list(file)), 'unsupported', 'listing a file');
+    },
+  },
+  {
+    name: 'returns metadata in one batch, limited to the fields asked for',
+    capability: 'metadata',
+    async run({port, root, add}) {
+      const a = await add(root, 'a.txt', false);
+      const b = await add(root, 'b.txt', false);
+      const snapshot = await port.metadata([a, b], ['size']);
+      equal(snapshot.size, 2, 'one entry per key');
+      assert(!('mimeType' in (snapshot.get(a) ?? {})), 'unrequested field absent');
+    },
+  },
+  {
+    name: 'watch reports an addition made after the listing',
+    capability: 'watch',
+    async run({port, root, add, armed}) {
+      const controller = new AbortController();
+      const seen: ChangeEvent[] = [];
+      const pump = (async () => {
+        for await (const event of port.watch(root, controller.signal)) {
+          seen.push(event);
+          break;
+        }
+      })();
+      await armed();
+      await add(root, 'late.txt', false);
+      await pump;
+      controller.abort();
+      equal(seen.length, 1, 'one change observed');
+      equal(seen[0]!.kind, 'added', 'the change is an addition');
+    },
+  },
+  {
+    name: 'the revision advances between a listing and a later change',
+    capability: 'watch',
+    async run({port, root, add, armed}) {
+      await add(root, 'first.txt', false);
+      let listed = -1;
+      for await (const page of port.list(root)) {
+        listed = page.revision;
+      }
+      const controller = new AbortController();
+      const seen: ChangeEvent[] = [];
+      const pump = (async () => {
+        for await (const event of port.watch(root, controller.signal)) {
+          seen.push(event);
+          break;
+        }
+      })();
+      await armed();
+      await add(root, 'second.txt', false);
+      await pump;
+      controller.abort();
+      assert(
+          seen[0]!.revision > listed,
+          `change revision ${seen[0]!.revision} must exceed listed ${listed}`);
+    },
+  },
+  {
+    name: 'watch reports a removal',
+    capability: 'watch',
+    async run({port, root, add, remove, armed}) {
+      const doomed = await add(root, 'doomed.txt', false);
+      const controller = new AbortController();
+      const seen: ChangeEvent[] = [];
+      const pump = (async () => {
+        for await (const event of port.watch(root, controller.signal)) {
+          seen.push(event);
+          break;
+        }
+      })();
+      await armed();
+      await remove(doomed);
+      await pump;
+      controller.abort();
+      equal(seen[0]!.kind, 'removed', 'the change is a removal');
+    },
+  },
+  {
+    name: 'search finds an entry nested below the scope',
+    capability: 'search',
+    async run({port, root, add}) {
+      const deep = await add(root, 'deep', true);
+      await add(deep, 'needle.txt', false);
+      await add(root, 'unrelated.txt', false);
+      const found = await collect(port.search('needle', root));
+      equal(found.length, 1, 'one match');
+      equal(found[0]!.name, 'needle.txt', 'the right match');
+    },
+  },
+  {
+    name: 'offers tasks for a selection and runs one',
+    capability: 'tasks',
+    async run({port, root, add}) {
+      const file = await add(root, 'openable.txt', false);
+      const tasks = await port.tasks([file]);
+      assert(tasks.length > 0, 'at least one task offered');
+      assert(tasks.some(t => t.isDefault), 'one task is the default');
+    },
+  },
+  {
+    name: 'a task that was never offered is refused',
+    capability: 'task-execution',
+    async run({port, root, add}) {
+      const file = await add(root, 'openable.txt', false);
+      await rejects(
+          () => port.executeTask('no-such-task', [file]), 'not-found',
+          'running a task the backend never offered');
+    },
+  },
+  {
+    name: 'a task can be handed to whatever handles it',
+    capability: 'task-execution',
+    async run({port, root, add}) {
+      const file = await add(root, 'openable.txt', false);
+      const tasks = await port.tasks([file]);
+      await port.executeTask(tasks[0]!.id, [file]);
+    },
+  },
+  {
+    name: 'an io operation runs to completion and reports progress',
+    capability: 'io',
+    async run({port, root, add}) {
+      const file = await add(root, 'copied.txt', false);
+      const controller = new AbortController();
+      const seen: IoProgress[] = [];
+      const pump = (async () => {
+        for await (const progress of port.subscribeIo(controller.signal)) {
+          seen.push(progress);
+          if (progress.state === 'succeeded' || progress.state === 'failed') {
+            break;
+          }
+        }
+      })();
+      await port.startIo({kind: 'copy', sources: [file], destination: root});
+      await pump;
+      controller.abort();
+      equal(seen[seen.length - 1]!.state, 'succeeded', 'final state');
+      assert(seen.some(p => p.state === 'queued'), 'reported being queued');
+    },
+  },
+  {
+    name: 'an io failure arrives as a typed error, not a string',
+    capability: 'io-failure',
+    async run({port, root, add, failWith}) {
+      const file = await add(root, 'locked.txt', false);
+      failWith(file, new FilesError(
+                         'permission-denied', 'It will not let you.'));
+      const controller = new AbortController();
+      let last: IoProgress|null = null;
+      const pump = (async () => {
+        for await (const progress of port.subscribeIo(controller.signal)) {
+          last = progress;
+          if (progress.state === 'failed' || progress.state === 'succeeded') {
+            break;
+          }
+        }
+      })();
+      await port.startIo({kind: 'move', sources: [file], destination: root});
+      await pump;
+      controller.abort();
+      equal(last!.state, 'failed', 'the operation failed');
+      assert(last!.error instanceof FilesError,
+             'the failure arrived as a string rather than a typed error');
+      equal(last!.error!.code, 'permission-denied', 'the error is typed');
+    },
+  },
+  {
+    name: 'a busy file names the process holding it open',
+    capability: 'io-holder',
+    async run({port, root, add, failWith}) {
+      const file = await add(root, 'busy.txt', false);
+      failWith(file, new FilesError(
+                         'busy', 'It is open somewhere else.',
+                         {pid: 4012, name: 'celluloid'}));
+      const controller = new AbortController();
+      let last: IoProgress|null = null;
+      const pump = (async () => {
+        for await (const progress of port.subscribeIo(controller.signal)) {
+          last = progress;
+          if (progress.state === 'failed' || progress.state === 'succeeded') {
+            break;
+          }
+        }
+      })();
+      await port.startIo({kind: 'move', sources: [file], destination: root});
+      await pump;
+      controller.abort();
+      equal(last!.error!.code, 'busy', 'the error is typed');
+      // "It is open in celluloid" is a sentence somebody can act on. "The
+      // operation failed" is not.
+      equal(last!.error!.holder!.name, 'celluloid', 'the holder is named');
+    },
+  },
+  {
+    name: 'a cancelled io operation stops and says it was cancelled',
+    capability: 'io',
+    async run({port, root, add}) {
+      const files = [
+        await add(root, 'x', false),
+        await add(root, 'y', false),
+        await add(root, 'z', false),
+      ];
+      const controller = new AbortController();
+      let last: IoProgress|null = null;
+      const taskIdHolder: {id?: string} = {};
+      const pump = (async () => {
+        for await (const progress of port.subscribeIo(controller.signal)) {
+          last = progress;
+          if (progress.state === 'running' && taskIdHolder.id) {
+            await port.cancelIo(progress.taskId);
+          }
+          if (progress.state === 'cancelled' || progress.state === 'succeeded') {
+            break;
+          }
+        }
+      })();
+      taskIdHolder.id =
+          await port.startIo({kind: 'copy', sources: files, destination: root});
+      await pump;
+      controller.abort();
+      equal(last!.state, 'cancelled', 'the operation reported cancellation');
+    },
+  },
+  {
+    name: 'volumes are reported with their capacity and removability',
+    capability: 'volumes',
+    async run({port}) {
+      const volumes: readonly Volume[] = await port.volumes();
+      assert(volumes.length > 0, 'at least one volume');
+      const system = volumes.find(v => v.kind === 'system');
+      assert(!!system, 'a system volume exists');
+      assert(!system!.removable, 'the system volume is not removable');
+    },
+  },
+  {
+    name: 'reports no dialog mode when not launched as a picker',
+    capability: 'dialog',
+    async run({port}) {
+      equal(await port.dialogMode(), null, 'dialog mode');
+    },
+  },
+];
+
+export interface Result {
+  name: string;
+  ok: boolean;
+  error?: string;
+}
+
+export async function runContract(
+    label: string, makeFixture: () => Promise<Fixture>|Fixture,
+    capabilities?: readonly Capability[]): Promise<Result[]> {
+  const results: Result[] = [];
+  const skipped = capabilities ?
+      CASES.filter(c => !capabilities.includes(c.capability)) :
+      [];
+  for (const testCase of CASES) {
+    if (capabilities && !capabilities.includes(testCase.capability)) {
+      continue;
+    }
+    try {
+      beginCheck(`${label}: ${testCase.name}`);
+      const fixture = await makeFixture();
+      await testCase.run({...fixture, armed: fixture.armed ?? armed});
+      results.push({name: testCase.name, ok: true});
+    } catch (error) {
+      results.push({
+        name: testCase.name,
+        ok: false,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  const failed = results.filter(r => !r.ok);
+  console.log(`${label}: ${results.length - failed.length}/${results.length} passed`);
+  for (const result of failed) {
+    console.log(`  FAIL ${result.name}\n       ${result.error}`);
+  }
+  if (skipped.length) {
+    // Named out loud every run. A capability nobody has built is a fact about
+    // the backend, and a suite that reports 11 of 11 without saying which six
+    // it did not run is telling you something false by omission.
+    const groups = [...new Set(skipped.map(c => c.capability))].sort();
+    console.log(`  ${skipped.length} case(s) not run, ${
+        label} does not implement: ${groups.join(', ')}`);
+  }
+  return results;
+}
