+ */
+export const TOKENS_CSS = "/**\n * The KibaOS surface vocabulary.\n *\n * The accent is not a new decision. The greeter already defines it, in GTK\n * theme variables rather than in its stylesheet: accent_bg_color is #6d4ea1 in\n * theme.css and #d1bcff in theme-dark.css, and the installer's token table\n * carries the same pair. Counting literal hex in greeter.css and concluding the\n * greeter was achromatic was a mistake; it uses @accent_color for focus rings\n * and the active pod.\n *\n * Surfaces are taken from the greeter's own values: translucent grounds, white\n * hairlines, white overlay interactive states, and deep soft shadows.\n */\n\n:root {\n  --kibaos-accent: #6d4ea1;\n  --kibaos-on-accent: #ffffff;\n\n  --kibaos-ground: #f4f2f9;\n  --kibaos-panel: #ffffff;\n  --kibaos-line: #e6e2f0;\n  --kibaos-ink: #1c1a24;\n  --kibaos-quiet: #6b6580;\n\n  --kibaos-row-hover: rgba(0, 0, 0, .04);\n  --kibaos-row-selected: rgba(109, 78, 161, .12);\n  --kibaos-tile: #f0edf7;\n  --kibaos-tile-dir: #e4dbf8;\n  --kibaos-tile-selected: #dbcdf6;\n  --kibaos-glyph: #6f6885;\n  --kibaos-tag-bg: #f7f5fc;\n  --kibaos-warn: #a1651a;\n  --kibaos-danger: #b3261e;\n\n  --kibaos-radius-row: 11px;\n  --kibaos-radius-tile: 11px;\n  --kibaos-radius-panel: 16px;\n  --kibaos-radius-pill: 999px;\n\n  --kibaos-row-height: 40px;\n  --kibaos-tile-size: 32px;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-kibaos-theme=\"light\"]) {\n    --kibaos-accent: #d1bcff;\n    --kibaos-on-accent: #3f1d6c;\n\n    --kibaos-ground: #100f16;\n    --kibaos-panel: #191823;\n    --kibaos-line: #262433;\n    --kibaos-ink: #efecf8;\n    --kibaos-quiet: #948ea8;\n\n    --kibaos-row-hover: rgba(255, 255, 255, .06);\n    --kibaos-row-selected: rgba(209, 188, 255, .16);\n    --kibaos-tile: #23212f;\n    --kibaos-tile-dir: #372c57;\n    --kibaos-tile-selected: #4a3b74;\n    --kibaos-glyph: #a79dc4;\n    --kibaos-tag-bg: #211f2c;\n  --kibaos-warn: #e6b062;\n  --kibaos-danger: #f2b8b5;\n  }\n}\n\n/* Repeated rather than shared, because a media query and an attribute cannot\n   select the same block. The attribute form is what lets both themes be\n   rendered and diffed without emulating the reader's system setting. */\n:root[data-kibaos-theme=\"dark\"] {\n    --kibaos-accent: #d1bcff;\n    --kibaos-on-accent: #3f1d6c;\n\n    --kibaos-ground: #100f16;\n    --kibaos-panel: #191823;\n    --kibaos-line: #262433;\n    --kibaos-ink: #efecf8;\n    --kibaos-quiet: #948ea8;\n\n    --kibaos-row-hover: rgba(255, 255, 255, .06);\n    --kibaos-row-selected: rgba(209, 188, 255, .16);\n    --kibaos-tile: #23212f;\n    --kibaos-tile-dir: #372c57;\n    --kibaos-tile-selected: #4a3b74;\n    --kibaos-glyph: #a79dc4;\n    --kibaos-tag-bg: #211f2c;\n  --kibaos-warn: #e6b062;\n  --kibaos-danger: #f2b8b5;\n}\n\n/* Density is fixed per mode, never measured. Dynamic row heights across a\n   hundred thousand entries make the scrollbar thumb jitter and drop frames. */\n:root[data-kibaos-density=\"compact\"] { --kibaos-row-height: 32px; --kibaos-tile-size: 26px; }\n:root[data-kibaos-density=\"relaxed\"] { --kibaos-row-height: 52px; --kibaos-tile-size: 38px; }\n\n.kibaos-row {\n  align-items: center;\n  block-size: var(--kibaos-row-height);\n  border-radius: var(--kibaos-radius-row);\n  box-sizing: border-box;\n  color: var(--kibaos-ink);\n  display: grid;\n  gap: 12px;\n  grid-template-columns: var(--kibaos-tile-size) 1fr 84px 96px 132px;\n  margin-inline: 8px;\n  padding-inline: 8px;\n  position: relative;\n  user-select: none;\n}\n\n.kibaos-row:hover { background: var(--kibaos-row-hover); }\n\n/* Selection and focus differ by shape as well as colour, because colour alone\n   is not a distinction everyone can see. */\n.kibaos-row[aria-selected=\"true\"] {\n  background: var(--kibaos-row-selected);\n  box-shadow: inset 3px 0 0 0 var(--kibaos-accent);\n}\n.kibaos-row:focus-visible {\n  outline: 2px solid var(--kibaos-accent);\n  outline-offset: -2px;\n}\n\n/* A cut entry is dashed as well as dimmed, so it reads as pending rather than\n   as disabled. */\n.kibaos-row[data-cut=\"true\"] { opacity: .55; }\n.kibaos-row[data-cut=\"true\"] .kibaos-tile {\n  border: 1px dashed var(--kibaos-quiet);\n}\n\n.kibaos-tile {\n  align-items: center;\n  background: var(--kibaos-tile);\n  block-size: var(--kibaos-tile-size);\n  border-radius: var(--kibaos-radius-tile);\n  box-sizing: border-box;\n  display: flex;\n  inline-size: var(--kibaos-tile-size);\n  justify-content: center;\n}\n.kibaos-row[data-directory=\"true\"] .kibaos-tile { background: var(--kibaos-tile-dir); }\n.kibaos-row[aria-selected=\"true\"] .kibaos-tile { background: var(--kibaos-tile-selected); }\n\n.kibaos-glyph {\n  block-size: 18px;\n  color: var(--kibaos-glyph);\n  inline-size: 18px;\n}\n.kibaos-row[data-directory=\"true\"] .kibaos-glyph { color: var(--kibaos-accent); }\n\n.kibaos-name {\n  font-size: 13px;\n  font-weight: 550;\n  letter-spacing: -.005em;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.kibaos-size, .kibaos-date {\n  color: var(--kibaos-quiet);\n  font-size: 12px;\n  font-variant-numeric: tabular-nums;\n}\n\n/* A quiet proportional bar behind the size, so the large item in a folder of\n   five hundred is visible without reading a digit. */\n.kibaos-size { position: relative; }\n.kibaos-size::before {\n  background: currentColor;\n  block-size: 100%;\n  content: '';\n  inset-block-start: 0;\n  inset-inline-start: 0;\n  inline-size: var(--kibaos-share, 0%);\n  opacity: .10;\n  position: absolute;\n  border-radius: 3px;\n}\n\n.kibaos-type {\n  background: var(--kibaos-tag-bg);\n  border: 1px solid var(--kibaos-line);\n  border-radius: var(--kibaos-radius-pill);\n  color: var(--kibaos-quiet);\n  font-size: 10.5px;\n  font-weight: 600;\n  justify-self: start;\n  letter-spacing: .04em;\n  line-height: 15px;\n  padding: 2px 9px;\n}\n\n/* The list owns its scrolling. The spacer carries the full extent so the\n   scrollbar is honest about how much there is, and the surface holding the\n   recycled rows is moved rather than repositioned per row. */\n.kibaos-list {\n  block-size: 100%;\n  overflow-y: auto;\n  overflow-x: hidden;\n  position: relative;\n}\n.kibaos-list:focus-visible { outline: none; }\n.kibaos-list-spacer { position: relative; }\n.kibaos-list-surface {\n  inset-block-start: 0;\n  inset-inline: 0;\n  position: absolute;\n  will-change: transform;\n}\n\n/* An empty view should read as prepared rather than abandoned, so it is\n   centred and quiet rather than a message pinned to the top left. */\n/* An author `display` beats the user agent's `[hidden] { display: none }`\n   regardless of specificity, because author styles win on origin. So setting\n   .hidden on this element did nothing at all and every folder with files in it\n   also announced that it was empty. */\n.kibaos-empty[hidden] { display: none; }\n.kibaos-empty {\n  align-items: center;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  justify-content: center;\n  min-block-size: 220px;\n  padding: 32px 24px;\n  text-align: center;\n}\n.kibaos-empty-title {\n  color: var(--kibaos-ink);\n  font-size: 14px;\n  font-weight: 600;\n  margin: 0;\n}\n.kibaos-empty-detail {\n  color: var(--kibaos-quiet);\n  font-size: 13px;\n  margin: 0;\n  /* Wide enough that a two line detail breaks after a clause rather than\n     stranding \"files.\" on its own. */\n  max-inline-size: 48ch;\n}\n\n\n/* The sidebar: where you can go, as opposed to what is in front of you.\n\n   Group headings are quiet and small rather than uppercase and tracked out.\n   Small caps at this size is a legibility cost paid for a filing cabinet\n   aesthetic nobody asked for, and these are three or four words that want to\n   be skimmed past on the way to the thing underneath. */\n.kibaos-sidebar {\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n  inline-size: 232px;\n  overflow-y: auto;\n  padding: 12px 10px;\n}\n.kibaos-place-heading {\n  color: var(--kibaos-quiet);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: .01em;\n  margin: 0 0 4px;\n  padding-inline: 10px;\n}\n.kibaos-place-list {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.kibaos-place {\n  align-items: center;\n  background: none;\n  border: 0;\n  border-radius: var(--kibaos-radius-row);\n  color: var(--kibaos-ink);\n  cursor: default;\n  display: flex;\n  font: inherit;\n  gap: 10px;\n  inline-size: 100%;\n  padding: 7px 10px;\n  position: relative;\n  text-align: start;\n}\n.kibaos-place:hover { background: var(--kibaos-row-hover); }\n.kibaos-place:focus-visible {\n  outline: 2px solid var(--kibaos-accent);\n  outline-offset: -2px;\n}\n.kibaos-place[aria-current=\"page\"] {\n  background: var(--kibaos-row-selected);\n  color: var(--kibaos-accent);\n  font-weight: 600;\n}\n/* A rail rather than a full bleed fill. The fill alone reads as a hover that\n   got stuck; the rail is what says this is where you are. */\n.kibaos-place[aria-current=\"page\"]::before {\n  background: var(--kibaos-accent);\n  block-size: 16px;\n  border-radius: var(--kibaos-radius-pill);\n  content: \"\";\n  inline-size: 3px;\n  inset-block-start: 50%;\n  inset-inline-start: 1px;\n  position: absolute;\n  translate: 0 -50%;\n}\n.kibaos-place-glyph {\n  block-size: 18px;\n  color: var(--kibaos-glyph);\n  flex: none;\n  inline-size: 18px;\n}\n.kibaos-place[aria-current=\"page\"] .kibaos-place-glyph { color: inherit; }\n.kibaos-place-label {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.kibaos-place-badge {\n  background: var(--kibaos-tag-bg);\n  border-radius: var(--kibaos-radius-pill);\n  color: var(--kibaos-quiet);\n  font-size: 11px;\n  font-variant-numeric: tabular-nums;\n  margin-inline-start: auto;\n  padding: 1px 7px;\n}\n.kibaos-place[aria-current=\"page\"] .kibaos-place-badge {\n  background: var(--kibaos-panel);\n  color: var(--kibaos-accent);\n}\n\n/* Capacity sits under the drive it belongs to, indented to the label rather\n   than the glyph, so the eye reads it as a note about that row. */\n.kibaos-place-capacity {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding: 1px 10px 6px 38px;\n}\n.kibaos-place-free {\n  color: var(--kibaos-quiet);\n  font-size: 11px;\n}\n.kibaos-place-bar {\n  background: var(--kibaos-line);\n  block-size: 3px;\n  border-radius: var(--kibaos-radius-pill);\n  overflow: hidden;\n}\n.kibaos-place-bar-fill {\n  background: var(--kibaos-accent);\n  block-size: 100%;\n  border-radius: inherit;\n}\n.kibaos-place-bar-fill[data-level=\"high\"] { background: var(--kibaos-warn); }\n.kibaos-place-bar-fill[data-level=\"full\"] { background: var(--kibaos-danger); }\n\n\n/* Where the app mounts us.\n\n   Opaque and over everything, because the stock window is still underneath and\n   still running: it owns the dialogs, the progress panel and the menus we have\n   not replaced. Drawing over it rather than deleting it is what makes this\n   reversible, and `mountKibaosShell` removes this element if the shell fails\n   to start, which puts the old window straight back. */\n#kibaos-shell {\n  background: var(--kibaos-ground);\n  inset: 0;\n  overflow: hidden;\n  position: fixed;\n  z-index: 2147483647;\n}\n\n/* The window. Places on the left, what is in them on the right, each on its\n   own panel so the ground shows between them: the greeter does the same thing,\n   and it is what stops a file manager reading as one undifferentiated grid. */\n.kibaos-shell {\n  background: var(--kibaos-ground);\n  block-size: 100%;\n  box-sizing: border-box;\n  display: flex;\n  gap: 8px;\n  padding: 8px;\n}\n.kibaos-shell-aside {\n  background: var(--kibaos-panel);\n  border: 1px solid var(--kibaos-line);\n  border-radius: var(--kibaos-radius-panel);\n  display: flex;\n  flex: none;\n  overflow: hidden;\n}\n.kibaos-shell-main {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  gap: 8px;\n  /* Without this a long file name makes the whole window wider instead of\n     being truncated, and the sidebar gets pushed off the left edge. */\n  min-inline-size: 0;\n}\n.kibaos-shell-list {\n  background: var(--kibaos-panel);\n  border: 1px solid var(--kibaos-line);\n  border-radius: var(--kibaos-radius-panel);\n  flex: 1;\n  min-block-size: 0;\n  overflow: hidden;\n  padding: 4px 0;\n}\n.kibaos-shell-notice {\n  background: var(--kibaos-panel);\n  border: 1px solid var(--kibaos-line);\n  border-radius: var(--kibaos-radius-panel);\n  color: var(--kibaos-quiet);\n  font-size: 13px;\n  margin: 0;\n  padding: 11px 15px;\n}\n\n\n/* The toolbar. Back, forward, up, then where you are.\n\n   The buttons are disabled rather than removed when there is nowhere to go: a\n   control that appears and disappears shifts everything beside it, and the one\n   thing you need from back and forward is that they are always in the same\n   place. */\n.kibaos-toolbar {\n  align-items: center;\n  /* The containing block for a sibling popover, which cannot live inside the\n     path bar because that clips. */\n  position: relative;\n  background: var(--kibaos-panel);\n  border: 1px solid var(--kibaos-line);\n  border-radius: var(--kibaos-radius-panel);\n  display: flex;\n  flex: none;\n  gap: 8px;\n  min-block-size: 44px;\n  padding: 5px 8px;\n}\n.kibaos-tool-group {\n  display: flex;\n  flex: none;\n  gap: 2px;\n}\n.kibaos-tool {\n  align-items: center;\n  background: none;\n  border: 0;\n  border-radius: var(--kibaos-radius-tile);\n  block-size: 30px;\n  color: var(--kibaos-glyph);\n  cursor: default;\n  display: flex;\n  inline-size: 30px;\n  justify-content: center;\n  padding: 0;\n}\n.kibaos-tool:hover:not(:disabled) {\n  background: var(--kibaos-row-hover);\n  color: var(--kibaos-ink);\n}\n.kibaos-tool:focus-visible {\n  outline: 2px solid var(--kibaos-accent);\n  outline-offset: -2px;\n}\n/* Not display:none and not 0.3 either. A disabled control still has to read as\n   a control, or the row looks like it lost something. */\n.kibaos-tool:disabled { opacity: .38; }\n.kibaos-tool-glyph { block-size: 18px; inline-size: 18px; }\n\n.kibaos-path {\n  flex: 1;\n  min-inline-size: 0;\n  overflow: hidden;\n}\n.kibaos-path-list {\n  align-items: center;\n  display: flex;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.kibaos-path-list > li { display: flex; position: relative; }\n.kibaos-crumb {\n  background: none;\n  border: 0;\n  border-radius: var(--kibaos-radius-tile);\n  color: var(--kibaos-quiet);\n  cursor: default;\n  font: inherit;\n  max-inline-size: 22ch;\n  overflow: hidden;\n  padding: 5px 8px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.kibaos-crumb:hover { background: var(--kibaos-row-hover); }\n.kibaos-crumb:focus-visible,\n.kibaos-chevron:focus-visible,\n.kibaos-path-option:focus-visible {\n  outline: 2px solid var(--kibaos-accent);\n  outline-offset: -2px;\n}\n/* Where you are is the one crumb that is not a link to somewhere else, so it\n   is the one that reads as text rather than as an action. */\n.kibaos-crumb[aria-current=\"page\"] {\n  color: var(--kibaos-ink);\n  font-weight: 600;\n}\n.kibaos-chevron {\n  align-items: center;\n  background: none;\n  border: 0;\n  border-radius: var(--kibaos-radius-tile);\n  block-size: 24px;\n  color: var(--kibaos-glyph);\n  cursor: default;\n  display: flex;\n  inline-size: 20px;\n  justify-content: center;\n  opacity: .6;\n  padding: 0;\n}\n.kibaos-chevron:hover,\n.kibaos-chevron[aria-expanded=\"true\"] {\n  background: var(--kibaos-row-hover);\n  color: var(--kibaos-ink);\n  opacity: 1;\n}\n.kibaos-chevron-glyph { block-size: 16px; inline-size: 16px; }\n\n.kibaos-path-popover {\n  background: var(--kibaos-panel);\n  border: 1px solid var(--kibaos-line);\n  border-radius: var(--kibaos-radius-tile);\n  box-shadow: 0 12px 32px rgba(0, 0, 0, .22), 0 2px 6px rgba(0, 0, 0, .12);\n  display: flex;\n  flex-direction: column;\n  max-block-size: 320px;\n  min-inline-size: 200px;\n  overflow-y: auto;\n  padding: 5px;\n  position: absolute;\n  z-index: 20;\n}\n.kibaos-path-option {\n  background: none;\n  border: 0;\n  border-radius: var(--kibaos-radius-tile);\n  color: var(--kibaos-ink);\n  cursor: default;\n  font: inherit;\n  overflow: hidden;\n  padding: 7px 10px;\n  text-align: start;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.kibaos-path-option:hover { background: var(--kibaos-row-hover); }\n.kibaos-path-popover-empty {\n  color: var(--kibaos-quiet);\n  margin: 0;\n  padding: 8px 10px;\n}\n\n\n/* The status bar. What is in front of you on the left, how much room is left\n   on the right, and nothing in the middle until there is an undo to put there. */\n.kibaos-status {\n  align-items: center;\n  background: var(--kibaos-panel);\n  border: 1px solid var(--kibaos-line);\n  border-radius: var(--kibaos-radius-panel);\n  color: var(--kibaos-quiet);\n  display: flex;\n  flex: none;\n  font-size: 12px;\n  gap: 16px;\n  justify-content: space-between;\n  min-block-size: 34px;\n  padding: 6px 14px;\n}\n.kibaos-status-summary {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.kibaos-status-space {\n  align-items: center;\n  display: flex;\n  flex: none;\n  gap: 8px;\n}\n.kibaos-status-track {\n  background: var(--kibaos-line);\n  block-size: 3px;\n  border-radius: var(--kibaos-radius-pill);\n  inline-size: 72px;\n  overflow: hidden;\n}\n.kibaos-status-fill {\n  background: var(--kibaos-accent);\n  block-size: 100%;\n  border-radius: inherit;\n}\n.kibaos-status-fill[data-level=\"high\"] { background: var(--kibaos-warn); }\n.kibaos-status-fill[data-level=\"full\"] { background: var(--kibaos-danger); }\n";
diff --git a/ui/file_manager/file_manager/kibaos/ui/toolbar.ts b/ui/file_manager/file_manager/kibaos/ui/toolbar.ts
new file mode 100644
index 0000000000..cb135edffd
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/ui/toolbar.ts
@@ -0,0 +1,82 @@
+/**
+ * Back, forward, up, and where you are.
+ *
+ * Three buttons and a path bar. The buttons are disabled rather than hidden
+ * when there is nowhere to go, because a control that appears and disappears
+ * moves everything beside it and makes the row impossible to aim at.
+ */
+import type {Trail} from './history.js';
+import type {PathBarOptions} from './path_bar.js';
+import {PathBar} from './path_bar.js';
+import {glyph} from './svg.js';
+
+const GLYPHS = {
+  back: 'M12.5 4.5 7 10l5.5 5.5',
+  forward: 'M7.5 4.5 13 10l-5.5 5.5',
+  up: 'M10 15.5V5m0 0-4.5 4.5M10 5l4.5 4.5',
+};
+
+export interface ToolbarOptions extends PathBarOptions {
+  readonly onBack?: () => void;
+  readonly onForward?: () => void;
+  readonly onUp?: () => void;
+}
+
+function button(kind: keyof typeof GLYPHS, label: string): HTMLButtonElement {
+  const element = document.createElement('button');
+  element.type = 'button';
+  element.className = 'kibaos-tool';
+  element.dataset['tool'] = kind;
+  // The name is on the button rather than on a tooltip, because a tooltip is
+  // not a name and a glyph on its own has none.
+  element.setAttribute('aria-label', label);
+  element.disabled = true;
+  element.appendChild(
+      glyph('kibaos-tool-glyph', GLYPHS[kind], {stroked: true}));
+  return element;
+}
+
+export class Toolbar {
+  private readonly bar: HTMLElement;
+  private readonly back: HTMLButtonElement;
+  private readonly forward: HTMLButtonElement;
+  private readonly up: HTMLButtonElement;
+  readonly pathBar: PathBar;
+
+  constructor(container: HTMLElement, options: ToolbarOptions = {}) {
+    this.bar = document.createElement('div');
+    this.bar.className = 'kibaos-toolbar';
+    this.bar.setAttribute('role', 'toolbar');
+    this.bar.setAttribute('aria-label', 'Navigation');
+
+    const group = document.createElement('div');
+    group.className = 'kibaos-tool-group';
+    this.back = button('back', 'Back');
+    this.forward = button('forward', 'Forward');
+    this.up = button('up', 'Up one folder');
+    group.append(this.back, this.forward, this.up);
+
+    this.back.addEventListener('click', () => options.onBack?.());
+    this.forward.addEventListener('click', () => options.onForward?.());
+    this.up.addEventListener('click', () => options.onUp?.());
+
+    this.bar.appendChild(group);
+    this.pathBar = new PathBar(this.bar, options);
+    container.appendChild(this.bar);
+  }
+
+  setTrail(trail: Trail): void {
+    this.pathBar.setTrail(trail);
+  }
+
+  setAvailability(state: {back: boolean, forward: boolean, up: boolean}): void {
+    this.back.disabled = !state.back;
+    this.forward.disabled = !state.forward;
+    this.up.disabled = !state.up;
+  }
+
+  destroy(): void {
+    this.pathBar.destroy();
+    this.bar.remove();
+  }
+}
