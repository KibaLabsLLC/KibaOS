+    return fromCallback<PlatformResultingTasks>(
+        this.runtime, done => this.api.getFileTasks(entries, dlpSourceUrls, done));
+  }
+
+  executeTask(
+      descriptor: PlatformTaskDescriptor,
+      entries: readonly PlatformEntry[]): Promise<string> {
+    return fromCallback<string>(
+        this.runtime, done => this.api.executeTask(descriptor, entries, done));
+  }
+
+  startIoTask(
+      type: PlatformIoType, entries: readonly PlatformEntry[],
+      params: {destinationFolder?: PlatformEntry}): Promise<number> {
+    return fromCallback<number>(
+        this.runtime,
+        // The notification is the system's own progress toast. The window is
+        // showing this operation already, so a second announcement of it is
+        // noise rather than news.
+        done => this.api.startIOTask(
+            type, entries, {...params, showNotification: false}, done));
+  }
+
+  cancelIoTask(taskId: number): void {
+    this.api.cancelIOTask(taskId);
+  }
+
+  onIoProgress(listener: (progress: PlatformIoProgress) => void): () => void {
+    // Narrowed here for the same reason as onDirectoryChanged: `type` and
+    // `state` are members of nominal string enums whose values are exactly the
+    // unions in `platform.ts`.
+    const forward = (raw: RawIoProgress) =>
+        listener(raw as unknown as PlatformIoProgress);
+    this.api.onIOTaskProgressStatus.addListener(forward);
+    return () => this.api.onIOTaskProgressStatus.removeListener(forward);
+  }
+
+  async getLaunchDialog(): Promise<PlatformLaunchDialog|null> {
+    return this.launch;
+  }
+
+  async selectFiles(paths: readonly string[], shouldReturnLocalPath: boolean):
+      Promise<void> {
+    await fromCallback<void>(
+        this.runtime,
+        done => this.api.selectFiles(paths, shouldReturnLocalPath, done));
+  }
+
+  cancelDialog(): void {
+    this.api.cancelDialog();
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/adapter/platform.ts b/ui/file_manager/file_manager/kibaos/adapter/platform.ts
new file mode 100644
index 0000000000..3544d308f5
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/adapter/platform.ts
@@ -0,0 +1,252 @@
+/**
+ * The narrow slice of ChromeOS the adapter is allowed to touch.
+ *
+ * Deliberately narrow: the adapter reaches for nothing outside this, so the
+ * whole of it can be driven by a fake in a browser that has no
+ * `chrome.fileManagerPrivate` and no filesystem.
+ *
+ * Every shape here was read off a live Files app renderer on the Dell on
+ * 2026-09-03, by calling the real API and printing what came back, rather than
+ * from the type definitions or from memory. That pass corrected six things this
+ * file previously asserted, and each correction is noted where it applies. The
+ * rule the file lives by is unchanged: where this lies, the adapter is verified
+ * against a fiction, and the fiction is what ships.
+ */
+
+/** A DOM `Entry`, reduced to what we read from it. */
+export interface PlatformEntry {
+  readonly name: string;
+  readonly isDirectory: boolean;
+  /** The identity used throughout the Files store already. */
+  toURL(): string;
+}
+
+/**
+ * A `DirectoryReader`, promisified.
+ *
+ * It must be called until it returns an empty array, which is the only signal
+ * that a directory is exhausted. Whether it splits the answer is up to the
+ * implementation and is not something to rely on either way: measured on the
+ * Dell, a directory of 86 entries came back in a single call. So one call may
+ * well be one directory, and there is still no way to know that without the
+ * empty read that follows.
+ */
+export interface PlatformDirectoryReader {
+  readEntries(): Promise<readonly PlatformEntry[]>;
+}
+
+/**
+ * A `MetadataItem`, of which we read a handful of fields.
+ *
+ * These come from `MetadataModel`, not from
+ * `chrome.fileManagerPrivate.getEntryProperties`. That distinction is not
+ * stylistic: asked directly, the private API answers `{}` for every local file,
+ * because the fields are filled in by the model layer above it. It also answers
+ * in a different vocabulary, and `restricted` is not a word in either. The name
+ * for it is `isDlpRestricted`, and MetadataModel fails an assertion rather than
+ * ignoring the wrong one.
+ *
+ * MetadataModel also returns a companion `<name>Error` key beside each field it
+ * could not read. We do not model those: a field that errored arrives absent,
+ * which is the same thing the caller has to handle anyway.
+ */
+export interface PlatformMetadata {
+  readonly size?: number;
+  readonly modificationTime?: Date;
+  readonly contentMimeType?: string;
+  readonly pinned?: boolean;
+  readonly shared?: boolean;
+  readonly availableOffline?: boolean;
+  readonly isDlpRestricted?: boolean;
+}
+
+/**
+ * A `VolumeInfo`, reduced.
+ *
+ * From `VolumeManager`, and it has to be: `getVolumeMetadataList` on the
+ * private API returns `VolumeMetadata`, which carries neither a label nor a
+ * root entry. It has `volumeLabel` and nothing to navigate to. So `listVolumes`
+ * cannot be written over `chrome.fileManagerPrivate` alone, and the thin
+ * implementation needs the app's VolumeManager as well as the private API.
+ *
+ * The two lists also differ in what they contain. On the Dell, VolumeManager
+ * reported 14 volumes and the private API 16, the extra two being a hidden
+ * `system_internal` and a `removable` device VolumeManager had not adopted.
+ */
+export interface PlatformVolume {
+  readonly volumeId: string;
+  /** The raw ChromeOS volume type string, mapped in the adapter. */
+  readonly volumeType: string;
+  readonly label: string;
+  readonly isReadOnly: boolean;
+  readonly root: PlatformEntry;
+}
+
+/**
+ * `chrome.fileManagerPrivate.FileWatchEvent`.
+ *
+ * This is the correction that matters most in this file. The event was
+ * previously written here as a directory url plus an optional list of changed
+ * files, on the understanding that ChromeOS was allowed to say only that
+ * something changed. What it actually delivers is smaller than that: two keys,
+ * an `entry` for the directory and an `eventType`, and no list of changed files
+ * at all, on any event. Creating a file and deleting it produced two events
+ * that were byte for byte identical.
+ *
+ * So the diff is not a fallback for when ChromeOS declines to elaborate. It is
+ * the only way to know what changed, and the code that read `changedFiles` was
+ * unreachable. Worse, the old shape named a `directoryUrl` field that does not
+ * exist, so the adapter's test for whether an event belonged to the directory
+ * it was watching compared `undefined` against a key and never matched: on
+ * hardware, the watch would have delivered nothing at all.
+ */
+export interface PlatformWatchEvent {
+  readonly entry: PlatformEntry;
+  readonly eventType: 'changed'|'error';
+}
+
+/** `chrome.fileManagerPrivate.FileTaskDescriptor`, which is a triple. */
+export interface PlatformTaskDescriptor {
+  readonly appId: string;
+  readonly taskType: string;
+  readonly actionId: string;
+}
+
+/** `FileTask`. Note every interesting flag is optional in the real one. */
+export interface PlatformFileTask {
+  readonly descriptor: PlatformTaskDescriptor;
+  readonly title: string;
+  readonly iconUrl?: string;
+  readonly isDefault?: boolean;
+  readonly isDlpBlocked?: boolean;
+}
+
+/**
+ * `ResultingTasks`, which is what `getFileTasks` answers with.
+ *
+ * Not an array. The tasks arrive wrapped in an object alongside a policy field,
+ * and unwrapping it is the caller's job.
+ */
+export interface PlatformResultingTasks {
+  readonly tasks: readonly PlatformFileTask[];
+  readonly policyDefaultHandlerStatus?: string;
+}
+
+/** `IoTaskType`, spelled the way the API spells it. Verified against the enum. */
+export type PlatformIoType = 'copy'|'delete'|'empty_trash'|'extract'|'move'|
+    'restore'|'restore_to_destination'|'trash'|'zip';
+
+/** `IoTaskState`. More states than we model, which is the point. */
+export type PlatformIoState = 'queued'|'scanning'|'in_progress'|'paused'|
+    'success'|'error'|'need_password'|'cancelled';
+
+/** `ProgressStatus`, reduced to what we report. */
+export interface PlatformIoProgress {
+  readonly taskId: number;
+  readonly type: PlatformIoType;
+  readonly state: PlatformIoState;
+  /**
+   * Both byte counts are zero on a successful small copy, measured. Nothing may
+   * divide by the total to get a fraction without checking it first.
+   */
+  readonly bytesTransferred: number;
+  readonly totalBytes: number;
+  readonly sourceName: string;
+  readonly itemCount: number;
+  readonly numRemainingItems: number;
+  /**
+   * A DOMException style name, and the empty string rather than absent when
+   * there was no error. Notably there is no notion of a holder.
+   */
+  readonly errorName?: string;
+}
+
+/**
+ * What the window was launched with, when it was launched as a picker.
+ *
+ * These are the launch parameters as the app receives them. Two fields named
+ * here before did not exist: there is no `shouldReturnLocalPath` anywhere in
+ * the app, and no `defaultName`. The real fields are `allowedPaths`, which is
+ * where the local path requirement comes from, and `targetName`. A window that
+ * is not a picker reports its type as `full-page`.
+ */
+export interface PlatformLaunchDialog {
+  readonly type: string;
+  readonly typeList?: readonly string[];
+  /** `nativePath` when the caller cannot accept a Drive or provider url. */
+  readonly allowedPaths?: string;
+  readonly targetName?: string;
+}
+
+export interface Platform {
+  /** `webkitResolveLocalFileSystemURL`. Rejects with a DOMException. */
+  resolve(url: string): Promise<PlatformEntry>;
+  createReader(directory: PlatformEntry): PlatformDirectoryReader;
+  /** `MetadataModel.get`, which is batched and returns results positionally. */
+  getMetadata(
+      entries: readonly PlatformEntry[],
+      names: readonly string[]): Promise<readonly PlatformMetadata[]>;
+  listVolumes(): Promise<readonly PlatformVolume[]>;
+  /**
+   * `getSizeStats`. Documented as answering nothing for a volume with no notion
+   * of capacity, and it does return undefined for those. Be aware that it is
+   * generous with the ones that do: every `local_root` volume on the Dell
+   * reported the capacity of the whole root filesystem, so several volumes
+   * legitimately report identical figures.
+   */
+  getSizeStats(volumeId: string):
+      Promise<{totalSize: number, remainingSize: number}|null>;
+  addFileWatch(entry: PlatformEntry): Promise<void>;
+  removeFileWatch(entry: PlatformEntry): Promise<void>;
+  onDirectoryChanged(listener: (event: PlatformWatchEvent) => void): () => void;
+
+  /**
+   * `searchFiles`. Both `maxResults` and `types` are required, so a search is
+   * always capped and always says what it will match. Omitting either is a
+   * TypeError from the bindings before the call is made.
+   */
+  searchFiles(params: {
+    /**
+     * Where to search. Absent means everywhere.
+     *
+     * Absent, never null. The bindings declare it optional and a null is not
+     * the same thing as an omission to them. Nothing ever passed one, so this
+     * was a wrong description rather than a live defect, and it was invisible
+     * until `kibaos/` was compiled against the app's own definitions.
+     */
+    rootDir?: PlatformEntry,
+    query: string,
+    types: 'ALL'|'EXCLUDE_DIRECTORIES'|'OFFLINE'|'SHARED_WITH_ME',
+    maxResults: number,
+  }): Promise<readonly PlatformEntry[]>;
+
+  /**
+   * `getFileTasks`, which takes two arguments and not one. The second is the
+   * source urls for data leak prevention, and calling it without them is
+   * refused with "No matching signature" rather than defaulted.
+   */
+  getFileTasks(
+      entries: readonly PlatformEntry[],
+      dlpSourceUrls: readonly string[]): Promise<PlatformResultingTasks>;
+  executeTask(
+      descriptor: PlatformTaskDescriptor,
+      entries: readonly PlatformEntry[]): Promise<string>;
+
+  startIoTask(
+      type: PlatformIoType, entries: readonly PlatformEntry[],
+      params: {destinationFolder?: PlatformEntry}): Promise<number>;
+  cancelIoTask(taskId: number): void;
+  onIoProgress(listener: (progress: PlatformIoProgress) => void): () => void;
+
+  /** Null unless the window was launched as the system file dialog. */
+  getLaunchDialog(): Promise<PlatformLaunchDialog|null>;
+  /**
+   * `selectFiles`. Takes the urls of the chosen entries, despite the parameter
+   * being named for paths: Chromium's own dialog controller passes
+   * `entry.toURL()`. The second argument is not optional, and is the dialog's
+   * allowedPaths reduced to a boolean, exactly as that controller computes it.
+   */
+  selectFiles(paths: readonly string[], shouldReturnLocalPath: boolean):
+      Promise<void>;
+  cancelDialog(): void;
+}
diff --git a/ui/file_manager/file_manager/kibaos/app/mount.ts b/ui/file_manager/file_manager/kibaos/app/mount.ts
new file mode 100644
index 0000000000..c367c36878
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/app/mount.ts
@@ -0,0 +1,97 @@
+/**
+ * The redesign, mounted by the app rather than pushed into it.
+ *
+ * `tests/harness/live_shell.js` proved this assembly by injecting it over the
+ * debugger, which was enough to see it and not enough to ship it: nothing in
+ * the Files app constructed any of this, so opening the window normally still
+ * gave you the stock one. This is the same three lines, run by the app itself.
+ *
+ * The stock UI is not torn down. It is still initialised and still holds every
+ * piece we have not replaced: the dialogs, the IO progress panel, the context
+ * menus, the crostini share flow. This draws over it, opaque and full window,
+ * so the machinery underneath stays alive and reachable while the surface is
+ * ours. Remove `#kibaos-shell` and the old window is exactly as it was, which
+ * is the property that makes it safe to put this in front of a real
+ * filesystem before all of those have an answer.
+ *
+ * Every collaborator arrives as an argument. Nothing here reads a global, so
+ * the local loop can compile it without the ChromeOS type definitions and the
+ * hardware harness can build the same thing from the running app's own
+ * objects.
+ */
+import type {FileManagerPrivateSlice, LastErrorSource, MetadataModelSlice, ResolveUrl, VolumeManagerSlice} from '../adapter/chromeos_platform.js';
+import {ChromeOsPlatform} from '../adapter/chromeos_platform.js';
+import {ChromeOsBackend} from '../adapter/chromeos_backend.js';
+import {TOKENS_CSS} from '../ui/tokens_css.js';
+import {FilesShell} from '../ui/shell.js';
+
+export interface MountOptions {
+  readonly api: FileManagerPrivateSlice;
+  readonly runtime: LastErrorSource;
+  readonly volumes: VolumeManagerSlice;
+  readonly metadata: MetadataModelSlice;
+  readonly resolveUrl: ResolveUrl;
+  /** Defaults to the document body. */
+  readonly container?: HTMLElement;
+}
+
+/** The id of the element the shell lives in, so it can be found and removed. */
+export const MOUNT_ID = 'kibaos-shell';
+
+/** The id of the style element, so a second mount replaces rather than repeats. */
+const STYLE_ID = 'kibaos-tokens';
+
+/**
+ * Puts the stylesheet in the document.
+ *
+ * As a `<style>` rather than a `<link>`, because the stylesheet cannot be its
+ * own pak resource: a new resource is a new id, the id map is compiled into
+ * chrome, and that is a full link rather than a pak swap. `tools/gen_tokens.py`
+ * turns `ui/tokens.css` into the string this writes, and `tests/run.sh` fails
+ * if the two have drifted.
+ */
+function applyTokens(): void {
+  let style = document.getElementById(STYLE_ID);
+  if (!style) {
+    style = document.createElement('style');
+    style.id = STYLE_ID;
+    document.head.appendChild(style);
+  }
+  style.textContent = TOKENS_CSS;
+}
+
+/**
+ * Builds the window and starts it.
+ *
+ * Returns null rather than throwing when it cannot start. A window that fails
+ * halfway is worse than the old window, so the host element goes away again
+ * and the app underneath is what you see. Deciding that here rather than in
+ * the caller means there is one place that knows what the fallback is.
+ */
+export async function mountKibaosShell(options: MountOptions):
+    Promise<FilesShell|null> {
+  const existing = document.getElementById(MOUNT_ID);
+  if (existing) {
+    existing.remove();
+  }
+  applyTokens();
+  const host = document.createElement('div');
+  host.id = MOUNT_ID;
+  (options.container ?? document.body).appendChild(host);
+
+  try {
+    const platform = new ChromeOsPlatform(
+        options.api, options.runtime, options.volumes, options.metadata,
+        options.resolveUrl,
+        // Null is an ordinary window rather than a picker. Dialog mode comes
+        // later, and passing the launch parameters here is all it will need.
+        null);
+    const shell = new FilesShell(host, new ChromeOsBackend(platform));
+    await shell.start();
+    return shell;
+  } catch (error) {
+    host.remove();
+    console.error('KibaOS Files did not start, leaving the stock window', error);
+    return null;
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/port/mock_backend.ts b/ui/file_manager/file_manager/kibaos/port/mock_backend.ts
new file mode 100644
index 0000000000..b761ff2fd7
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/port/mock_backend.ts
@@ -0,0 +1,412 @@
+/**
+ * An in memory backend, so the frontend can be built and tested without a
+ * ChromeOS session, a mount, or the Dell.
+ *
+ * This is the whole velocity argument. The greeter was built in four days
+ * because it ran headless against a mocked greetd socket and never needed the
+ * target machine to iterate. Files was slow because every check meant syncing a
+ * pak over ssh and pressing keys on a laptop.
+ *
+ * It injects latency and failure on purpose. A backend that always answers
+ * instantly and always succeeds trains a UI that cannot cope with the one that
+ * does neither.
+ */
+import type {FilesBackendPort} from './port.js';
+import type {ChangeEvent, DialogMode, EntryDto, EntryPage, FileKey, IoProgress, IoRequest, IoState, ListOptions, Metadata, MetadataField, MetadataSnapshot, TaskDescriptor, TaskId, Volume} from './types.js';
+import {asFileKey, FilesError} from './types.js';
+
+interface Node {
+  key: FileKey;
+  name: string;
+  isDirectory: boolean;
+  parent: FileKey|null;
+  children: FileKey[];
+  metadata: Metadata;
+  /** Set to make an operation touching this node fail, for failure tests. */
+  fail?: FilesError;
+}
+
+export interface MockOptions {
+  /** Milliseconds before any call answers. Zero by default so tests stay fast. */
+  latencyMs?: number;
+  /** Entries per page. Small values exercise the streaming path. */
+  pageSize?: number;
+  dialogMode?: DialogMode|null;
+}
+
+/** A queue that turns pushes into an async iterable, with abort support. */
+class Stream<T> {
+  private readonly pending: T[] = [];
+  private wake: (() => void)|null = null;
+  private closed = false;
+
+  push(value: T): void {
+    this.pending.push(value);
+    this.wake?.();
+  }
+
+  close(): void {
+    this.closed = true;
+    this.wake?.();
+  }
+
+  async * iterate(signal?: AbortSignal): AsyncIterable<T> {
+    while (true) {
+      if (signal?.aborted) {
+        return;
+      }
+      if (this.pending.length) {
+        yield this.pending.shift()!;
+        continue;
+      }
+      if (this.closed) {
+        return;
+      }
+      await new Promise<void>(resolve => {
+        this.wake = resolve;
+        signal?.addEventListener('abort', () => resolve(), {once: true});
+      });
+      this.wake = null;
+    }
+  }
+}
+
+export class MockBackend implements FilesBackendPort {
+  private readonly nodes = new Map<FileKey, Node>();
+  private readonly volumeList: Volume[] = [];
+  /**
+   * One revision per directory. `list` reports the revision it read at and
+   * `watch` stamps every change with the revision it produced, which is what
+   * lets a caller tell that it missed nothing between the two.
+   */
+  private readonly revisions = new Map<FileKey, number>();
+  private readonly watchers = new Map<FileKey, Set<Stream<ChangeEvent>>>();
+  private readonly ioStreams = new Set<Stream<IoProgress>>();
+  private readonly cancelled = new Set<TaskId>();
+  private nextTask = 1;
+  private options: Required<Omit<MockOptions, 'dialogMode'>>&
+      {dialogMode: DialogMode|null};
+
+  constructor(options: MockOptions = {}) {
+    this.options = {
+      latencyMs: options.latencyMs ?? 0,
+      pageSize: options.pageSize ?? 200,
+      dialogMode: options.dialogMode ?? null,
+    };
+  }
+
+  // ---- test construction -------------------------------------------------
+
+  addVolume(volume: Volume): this {
+    this.volumeList.push(volume);
+    if (!this.nodes.has(volume.root)) {
+      this.put({
+        key: volume.root,
+        name: volume.label,
+        isDirectory: true,
+        parent: null,
+        children: [],
+        metadata: {},
+      });
+    }
+    return this;
+  }
+
+  /** Adds an entry and notifies watchers of its parent, as a real change would. */
+  add(parent: FileKey, name: string, isDirectory: boolean,
+      metadata: Metadata = {}): FileKey {
+    const key = asFileKey(`${parent}/${name}`);
+    const node: Node = {key, name, isDirectory, parent, children: [], metadata};
+    this.put(node);
+    const parentNode = this.nodes.get(parent);
+    if (parentNode && !parentNode.children.includes(key)) {
+      parentNode.children.push(key);
+    }
+    const revision = this.bump(parent);
+    this.emit(parent, {kind: 'added', revision, entries: [toDto(node)]});
+    return key;
+  }
+
+  remove(key: FileKey): void {
+    const node = this.nodes.get(key);
+    if (!node) {
+      return;
+    }
+    const parent = node.parent;
+    this.nodes.delete(key);
+    if (parent) {
+      const parentNode = this.nodes.get(parent);
+      if (parentNode) {
+        parentNode.children = parentNode.children.filter(c => c !== key);
+      }
+      const revision = this.bump(parent);
+      this.emit(parent, {kind: 'removed', revision, keys: [key]});
+    }
+  }
+
+  /** Makes any operation touching this entry fail, for failure path tests. */
+  setFailure(key: FileKey, error: FilesError|undefined): void {
+    const node = this.nodes.get(key);
+    if (node) {
+      node.fail = error;
+    }
+  }
+
+  setLatency(ms: number): void {
+    this.options.latencyMs = ms;
+  }
+
+  private put(node: Node): void {
+    this.nodes.set(node.key, node);
+    if (node.isDirectory && !this.revisions.has(node.key)) {
+      this.revisions.set(node.key, 1);
+    }
+  }
+
+  private bump(key: FileKey): number {
+    const next = (this.revisions.get(key) ?? 1) + 1;
+    this.revisions.set(key, next);
+    return next;
+  }
+
+  private emit(key: FileKey, event: ChangeEvent): void {
+    for (const stream of this.watchers.get(key) ?? []) {
+      stream.push(event);
+    }
+  }
+
+  /**
+   * Always yields, even at zero latency.
+   *
+   * Returning synchronously made a copy of three files finish before its own
+   * caller got the task id back, so nothing could observe it running and
+   * cancellation was untestable. Nothing in the real backend is synchronous,
+   * and a mock that completes instantly trains a UI that never sees an
+   * intermediate state.
+   */
+  private async settle(): Promise<void> {
+    await new Promise(resolve => setTimeout(resolve, this.options.latencyMs));
+  }
+
+  private require(key: FileKey): Node {
+    const node = this.nodes.get(key);
+    if (!node) {
+      throw new FilesError('not-found', `There is no entry at ${key}.`);
+    }
+    if (node.fail) {
+      throw node.fail;
+    }
+    return node;
+  }
+
+  // ---- FilesBackendPort --------------------------------------------------
+
+  async * list(key: FileKey, options: ListOptions = {}):
+      AsyncIterable<EntryPage> {
+    await this.settle();
+    const node = this.require(key);
+    if (!node.isDirectory) {
+      throw new FilesError('unsupported', `${node.name} is not a folder.`);
+    }
+    const revision = this.revisions.get(key) ?? 1;
+    const size = options.pageSize ?? this.options.pageSize;
+    const all = node.children.map(child => this.nodes.get(child))
+                    .filter((n): n is Node => !!n)
+                    .filter(n => options.showHidden || !n.name.startsWith('.'))
+                    .map(toDto);
+    for (let i = 0; i < all.length || i === 0; i += size) {
+      if (options.signal?.aborted) {
+        return;
+      }
+      const slice = all.slice(i, i + size);
+      yield {revision, entries: slice, done: i + size >= all.length};
+      if (i + size >= all.length) {
+        return;
+      }
+      // Between pages, not just before the first. A listing that arrives all at
+      // once leaves no window for a change to race it, which is the window the
+      // session's buffered replay exists to close.
+      await this.settle();
+    }
+  }
+
+  async metadata(keys: readonly FileKey[], fields: readonly MetadataField[]):
+      Promise<MetadataSnapshot> {
+    await this.settle();
+    const out = new Map<FileKey, Metadata>();
+    for (const key of keys) {
+      const node = this.nodes.get(key);
+      if (!node) {
+        continue;
+      }
+      const picked: Record<string, unknown> = {};
+      for (const field of fields) {
+        if (field in node.metadata) {
+          picked[field] = (node.metadata as Record<string, unknown>)[field];
+        }
+      }
+      out.set(key, picked as Metadata);
+    }
+    return out;
+  }
+
+  async * watch(key: FileKey, signal?: AbortSignal): AsyncIterable<ChangeEvent> {
+    const stream = new Stream<ChangeEvent>();
+    let set = this.watchers.get(key);
+    if (!set) {
+      set = new Set();
+      this.watchers.set(key, set);
+    }
+    set.add(stream);
+    try {
+      yield* stream.iterate(signal);
+    } finally {
+      set.delete(stream);
+    }
+  }
+
+  async volumes(): Promise<readonly Volume[]> {
+    await this.settle();
+    return this.volumeList.slice();
+  }
+
+  async * search(query: string, scope: FileKey, options: ListOptions = {}):
+      AsyncIterable<EntryPage> {
+    await this.settle();
+    const needle = query.toLowerCase();
+    const found: EntryDto[] = [];
+    const walk = (key: FileKey) => {
+      const node = this.nodes.get(key);
+      if (!node) {
+        return;
+      }
+      if (node.key !== scope && node.name.toLowerCase().includes(needle)) {
+        found.push(toDto(node));
+      }
+      node.children.forEach(walk);
+    };
+    walk(scope);
+    const revision = this.revisions.get(scope) ?? 1;
+    const size = options.pageSize ?? this.options.pageSize;
+    for (let i = 0; i < found.length || i === 0; i += size) {
+      if (options.signal?.aborted) {
+        return;
+      }
+      yield {
+        revision,
+        entries: found.slice(i, i + size),
+        done: i + size >= found.length,
+      };
+      if (i + size >= found.length) {
+        return;
+      }
+    }
+  }
+
+  async tasks(keys: readonly FileKey[]): Promise<readonly TaskDescriptor[]> {
+    await this.settle();
+    if (!keys.length) {
+      return [];
+    }
+    return [
+      {id: 'mock-view', title: 'Preview', isDefault: true, isDlpBlocked: false},
+      {id: 'mock-edit', title: 'Edit', isDefault: false, isDlpBlocked: false},
+    ];
+  }
+
+  async executeTask(taskId: string, keys: readonly FileKey[]): Promise<void> {
+    await this.settle();
+    for (const key of keys) {
+      this.require(key);
+    }
+    // A task id the backend never offered is a caller bug, and the real one
+    // refuses it. Ignoring it here made the mock kinder than the platform,
+    // which is the direction that hides mistakes rather than finding them.
+    if (taskId !== 'mock-view' && taskId !== 'mock-edit') {
+      throw new FilesError('not-found', 'There is no such task.');
+    }
+  }
+
+  async startIo(request: IoRequest): Promise<TaskId> {
+    const taskId = `task-${this.nextTask++}` as TaskId;
+    // Deliberately not awaited. The point of this model is that the operation
+    // outlives the call, and the window, the way the real one does.
+    void this.runIo(taskId, request);
+    return taskId;
+  }
+
+  private async runIo(taskId: TaskId, request: IoRequest): Promise<void> {
+    const total = request.sources.length;
+    const report = (state: IoState, processed: number, error?: FilesError) => {
+      const progress: IoProgress = {
+        taskId,
+        kind: request.kind,
+        state,
+        processed,
+        total,
+        error,
+      };
+      for (const stream of this.ioStreams) {
+        stream.push(progress);
+      }
+    };
+    report('queued', 0);
+    for (let i = 0; i < total; i++) {
+      await this.settle();
+      if (this.cancelled.has(taskId)) {
+        report('cancelled', i);
+        return;
+      }
+      const node = this.nodes.get(request.sources[i]!);
+      if (!node) {
+        report('failed', i, new FilesError('not-found', 'It is no longer there.'));
+        return;
+      }
+      if (node.fail) {
+        report('failed', i, node.fail);
+        return;
+      }
+      report('running', i + 1);
+    }
+    report('succeeded', total);
+  }
+
+  async * subscribeIo(signal?: AbortSignal): AsyncIterable<IoProgress> {
+    const stream = new Stream<IoProgress>();
+    this.ioStreams.add(stream);
+    try {
+      yield* stream.iterate(signal);
+    } finally {
+      this.ioStreams.delete(stream);
+    }
+  }
+
+  async cancelIo(taskId: TaskId): Promise<void> {
+    this.cancelled.add(taskId);
+  }
+
+  async dialogMode(): Promise<DialogMode|null> {
+    await this.settle();
+    return this.options.dialogMode;
+  }
+
+  async confirmDialog(keys: readonly FileKey[]): Promise<void> {
+    await this.settle();
+    for (const key of keys) {
+      this.require(key);
+    }
+  }
+
+  async cancelDialog(): Promise<void> {
+    await this.settle();
+  }
+}
+
+function toDto(node: Node): EntryDto {
+  return {
+    key: node.key,
+    name: node.name,
+    isDirectory: node.isDirectory,
+    parent: node.parent,
+  };
+}
diff --git a/ui/file_manager/file_manager/kibaos/port/port.ts b/ui/file_manager/file_manager/kibaos/port/port.ts
new file mode 100644
index 0000000000..a7c4297cd6
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/port/port.ts
@@ -0,0 +1,58 @@
+/**
+ * The boundary between the KibaOS frontend and everything we kept.
+ *
+ * This is not a second copy of application state. The Files store already
+ * holds normalised entries, volumes and the current directory, and its own
+ * README forbids it depending on the UI layer, so the store sits above this and
+ * the components sit above that. What lives here is external capability and
+ * effect: the things only the browser process can do.
+ *
+ * Two implementations, one contract suite run against both. A suite that only
+ * exercises the mock proves the mock agrees with itself.
+ */
+import type {ChangeEvent, DialogMode, EntryPage, FileKey, IoProgress, IoRequest, ListOptions, MetadataField, MetadataSnapshot, TaskDescriptor, TaskId, Volume} from './types.js';
+
+export interface FilesBackendPort {
+  /** Streamed and cancellable; a directory of 100,000 entries is normal. */
+  list(key: FileKey, options?: ListOptions): AsyncIterable<EntryPage>;
+
+  /** Always batched. There is deliberately no per file variant. */
+  metadata(keys: readonly FileKey[], fields: readonly MetadataField[]):
+      Promise<MetadataSnapshot>;
+
+  /** Revisions align with `list`, so no change is lost between the two. */
+  watch(key: FileKey, signal?: AbortSignal): AsyncIterable<ChangeEvent>;
+
+  volumes(): Promise<readonly Volume[]>;
+
+  search(query: string, scope: FileKey, options?: ListOptions):
+      AsyncIterable<EntryPage>;
+
+  /** "Open with": web apps, PWAs, Android, Crostini and internal viewers. */
+  tasks(keys: readonly FileKey[]): Promise<readonly TaskDescriptor[]>;
+  executeTask(taskId: string, keys: readonly FileKey[]): Promise<void>;
+
+  /**
+   * File operations belong to the browser process, not to this window. Start a
+   * copy and close Files and it carries on and keeps reporting to the system
+   * tray, so the UI subscribes by id and reconnects rather than holding a
+   * handle that dies with the window.
+   */
+  startIo(request: IoRequest): Promise<TaskId>;
+  subscribeIo(signal?: AbortSignal): AsyncIterable<IoProgress>;
+  cancelIo(taskId: TaskId): Promise<void>;
+
+  /** Null unless Files was launched as the system file dialog. */
+  dialogMode(): Promise<DialogMode|null>;
+  confirmDialog(keys: readonly FileKey[]): Promise<void>;
+  cancelDialog(): Promise<void>;
+}
+
+/**
+ * Deliberately absent: shred.
+ *
+ * Per file secure deletion cannot be honoured on Btrfs, on an SSD, on eMMC or
+ * under snapshots. A signature that promises it is a safety lie in the worst
+ * possible place, so the capability does not exist rather than existing and
+ * being unreliable.
+ */
diff --git a/ui/file_manager/file_manager/kibaos/port/types.ts b/ui/file_manager/file_manager/kibaos/port/types.ts
new file mode 100644
index 0000000000..1a32095c11
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/port/types.ts
@@ -0,0 +1,170 @@
+/**
+ * The vocabulary the KibaOS frontend speaks.
+ *
+ * Everything here is a plain immutable value. Chromium `Entry` objects never
+ * reach a component: they are live handles owned by the plumbing, the list
+ * rebuilds them as rows recycle, and a component holding one is a component
+ * holding something that can change underneath it. Patch 0071 learned this the
+ * hard way and keys its cut marks by URL for the same reason.
+ */
+
+/**
+ * Identity for anything the file manager can show.
+ *
+ * Deliberately not a path. ChromeOS does not address files by POSIX path, and
+ * a string path cannot express Recent, Trash, Drive, MTP, an archive, a
+ * DocumentsProvider root or any File System Provider volume. The brand stops a
+ * raw path being passed where a key belongs.
+ */
+export type FileKey = string&{readonly __fileKey: unique symbol};
+
+export function asFileKey(value: string): FileKey {
+  return value as FileKey;
+}
+
+export type TaskId = string&{readonly __taskId: unique symbol};
+
+export interface EntryDto {
+  readonly key: FileKey;
+  readonly name: string;
+  readonly isDirectory: boolean;
+  readonly parent: FileKey|null;
+}
+
+/**
+ * Metadata is separate from the entry and always fetched in batches.
+ *
+ * ChromeOS resolves these through several asynchronous providers, including
+ * Drive sync state and enterprise data loss prevention. Asking per file across
+ * a directory of thousands is the wrong shape no matter how fast any one
+ * answer is.
+ */
+export type MetadataField = 'size'|'modificationTime'|'mimeType'|'pinned'|
+    'shared'|'availableOffline'|'restricted';
+
+export interface Metadata {
+  readonly size?: number;
+  readonly modificationTime?: number;
+  readonly mimeType?: string;
+  readonly pinned?: boolean;
+  readonly shared?: boolean;
+  readonly availableOffline?: boolean;
+  /** Blocked by policy. The UI must say so rather than silently failing. */
+  readonly restricted?: boolean;
+}
+
+export type MetadataSnapshot = ReadonlyMap<FileKey, Metadata>;
+
+export type VolumeKind = 'system'|'removable'|'archive'|'provided'|'drive'|
+    'android'|'crostini'|'mtp'|'trash'|'recent';
+
+/**
+ * What a place is for, as opposed to what kind of storage it is made of.
+ *
+ * A pictures folder on the internal disk is a `system` volume with a
+ * `pictures` purpose, and the two answers are wanted for different things: the
+ * kind decides which group the sidebar files it under, the purpose decides what
+ * it looks like. Absent when the platform does not say so, which is most
+ * volumes and is not a failure.
+ */
+export type VolumePurpose =
+    'home'|'desktop'|'documents'|'downloads'|'music'|'pictures'|'videos';
+
+export interface Volume {
+  readonly id: string;
+  readonly root: FileKey;
+  readonly label: string;
+  readonly kind: VolumeKind;
+  readonly removable: boolean;
+  readonly readOnly: boolean;
+  /** Null where the notion does not apply, such as Recent. */
+  readonly capacity: {readonly total: number, readonly free: number}|null;
+  readonly purpose?: VolumePurpose;
+}
+
+/**
+ * A page of a listing, carrying the revision it was read at.
+ *
+ * The revision is shared with `watch`. Without it, `list` followed by `watch`
+ * silently drops every change that lands between the two calls, and the list
+ * shows a directory that no longer exists in that state.
+ */
+export interface EntryPage {
+  readonly revision: number;
+  readonly entries: readonly EntryDto[];
+  readonly done: boolean;
+}
+
+export interface ListOptions {
+  readonly signal?: AbortSignal;
+  readonly showHidden?: boolean;
+  readonly pageSize?: number;
+}
+
+export type ChangeEvent =
+    {readonly kind: 'added', readonly revision: number,
+     readonly entries: readonly EntryDto[]}|
+    {readonly kind: 'removed', readonly revision: number,
+     readonly keys: readonly FileKey[]}|
+    {readonly kind: 'changed', readonly revision: number,
+     readonly keys: readonly FileKey[]}|
+    /** The directory itself went away, which is not the same as being empty. */
+    {readonly kind: 'gone', readonly revision: number};
+
+export type FilesErrorCode = 'not-found'|'permission-denied'|'busy'|
+    'read-only'|'no-space'|'cancelled'|'unsupported'|'io';
+
+/**
+ * Typed, because the UI has to say something different for each of these and
+ * matching on a message string is how that stops working in another language.
+ */
+export class FilesError extends Error {
+  constructor(
+      readonly code: FilesErrorCode, message: string,
+      /** Names the holding process for `busy`, so the UI can offer to end it. */
+      readonly holder?: {readonly pid: number, readonly name: string}) {
+    super(message);
+    this.name = 'FilesError';
+  }
+}
+
+export type IoKind = 'copy'|'move'|'trash'|'restore'|'delete'|'compress'|
+    'extract';
+
+export interface IoRequest {
+  readonly kind: IoKind;
+  readonly sources: readonly FileKey[];
+  readonly destination?: FileKey;
+}
+
+export type IoState = 'queued'|'running'|'succeeded'|'failed'|'cancelled';
+
+export interface IoProgress {
+  readonly taskId: TaskId;
+  readonly kind: IoKind;
+  readonly state: IoState;
+  readonly processed: number;
+  readonly total: number;
+  readonly currentName?: string;
+  readonly error?: FilesError;
+}
+
+/** The picker contract. Files is the system file dialog and must behave as one. */
+export type DialogKind = 'open-file'|'open-multi'|'open-folder'|'open-upload'|
+    'save-as'|'save-folder';
+
+export interface DialogMode {
+  readonly kind: DialogKind;
+  readonly typeList: readonly string[];
+  /** Callers that need a real Linux path cannot be offered Drive or a provider. */
+  readonly allowedPaths: 'native'|'any';
+  readonly defaultName?: string;
+}
+
+export interface TaskDescriptor {
+  readonly id: string;
+  readonly title: string;
+  readonly iconUrl?: string;
+  readonly isDefault: boolean;
+  readonly isDlpBlocked: boolean;
+}
diff --git a/ui/file_manager/file_manager/kibaos/session/navigation_session.ts b/ui/file_manager/file_manager/kibaos/session/navigation_session.ts
new file mode 100644
index 0000000000..142ebe1c97
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/session/navigation_session.ts
@@ -0,0 +1,195 @@
+/**
+ * One browsing context: a tab, or one side of a split.
+ *
+ * This exists because `DirectoryModel` owns exactly one current directory, one
+ * selection model and one watcher, and subscribes to a single store. Tabs and
+ * split panes are therefore a data model change rather than a component, and
+ * building them as components would work perfectly against a mock and then come
+ * apart against production. Each session owns its own listing, selection,
+ * search, cancellation and watcher lifetime.
+ */
+import type {FilesBackendPort} from '../port/port.js';
+import type {ChangeEvent, EntryDto, FileKey} from '../port/types.js';
+import {FilesError} from '../port/types.js';
+
+export interface SessionState {
+  readonly current: FileKey|null;
+  readonly entries: readonly EntryDto[];
+  readonly revision: number;
+  readonly loading: boolean;
+  readonly error: FilesError|null;
+  readonly selection: ReadonlySet<FileKey>;
+}
+
+type Listener = (state: SessionState) => void;
+
+export class NavigationSession {
+  private current: FileKey|null = null;
+  private entries: EntryDto[] = [];
+  private revision = 0;
+  private loading = false;
+  private error: FilesError|null = null;
+  private selection = new Set<FileKey>();
+  private anchor: FileKey|null = null;
+  private controller: AbortController|null = null;
+  private readonly listeners = new Set<Listener>();
+
+  constructor(readonly id: string, private readonly port: FilesBackendPort) {}
+
+  subscribe(listener: Listener): () => void {
+    this.listeners.add(listener);
+    listener(this.snapshot());
+    return () => this.listeners.delete(listener);
+  }
+
+  snapshot(): SessionState {
+    return {
+      current: this.current,
+      entries: this.entries.slice(),
+      revision: this.revision,
+      loading: this.loading,
+      error: this.error,
+      selection: new Set(this.selection),
+    };
+  }
+
+  private publish(): void {
+    const state = this.snapshot();
+    for (const listener of this.listeners) {
+      listener(state);
+    }
+  }
+
+  /**
+   * Watching starts before the listing and the buffered events are replayed
+   * afterwards.
+   *
+   * Listing first and then watching drops every change that lands in between,
+   * which is a directory that silently shows a state it was never in. The
+   * revision on each event is what says whether it is already reflected in what
+   * the listing returned.
+   */
+  async navigate(key: FileKey): Promise<void> {
+    this.controller?.abort();
+    const controller = new AbortController();
+    this.controller = controller;
+
+    this.current = key;
+    this.entries = [];
+    this.selection.clear();
+    this.anchor = null;
+    this.loading = true;
+    this.error = null;
+    this.publish();
+
+    const buffered: ChangeEvent[] = [];
+    let listed = false;
+    const pump = (async () => {
+      try {
+        for await (const event of this.port.watch(key, controller.signal)) {
+          if (listed) {
+            this.applyChange(event);
+            this.publish();
+          } else {
+            buffered.push(event);
+          }
+        }
+      } catch {
+        // A watch that cannot start is not a reason to show nothing; the
+        // listing below still stands, it simply will not update itself.
+      }
+    })();
+    void pump;
+
+    try {
+      for await (const page of this.port.list(key, {signal: controller.signal})) {
+        if (controller.signal.aborted) {
+          return;
+        }
+        this.revision = page.revision;
+        this.entries.push(...page.entries);
+        this.publish();
+      }
+      listed = true;
+      for (const event of buffered) {
+        if (event.revision > this.revision) {
+          this.applyChange(event);
+        }
+      }
+      this.loading = false;
+      this.publish();
+    } catch (error) {
+      if (controller.signal.aborted) {
+        return;
+      }
+      this.loading = false;
+      this.error = error instanceof FilesError ?
+          error :
+          new FilesError('io', 'That folder could not be opened.');
+      this.publish();
+    }
+  }
+
+  private applyChange(event: ChangeEvent): void {
+    this.revision = event.revision;
+    switch (event.kind) {
+      case 'added':
+        for (const entry of event.entries) {
+          if (!this.entries.some(e => e.key === entry.key)) {
+            this.entries.push(entry);
+          }
+        }
+        break;
+      case 'removed': {
+        const gone = new Set(event.keys);
+        this.entries = this.entries.filter(e => !gone.has(e.key));
+        // A selection that keeps naming something that is no longer there is
+        // how an operation later runs against nothing.
+        for (const key of gone) {
+          this.selection.delete(key);
+        }
+        break;
+      }
+      case 'changed':
+        break;
+      case 'gone':
+        this.entries = [];
+        this.selection.clear();
+        this.error = new FilesError('not-found', 'This folder is no longer there.');
+        break;
+    }
+  }
+
+  select(key: FileKey, mode: 'replace'|'toggle'|'range' = 'replace'): void {
+    if (mode === 'replace') {
+      this.selection = new Set([key]);
+      this.anchor = key;
+    } else if (mode === 'toggle') {
+      if (!this.selection.delete(key)) {
+        this.selection.add(key);
+      }
+      this.anchor = key;
+    } else {
+      // Ranges are resolved over indices rather than by walking rendered rows,
+      // because at a hundred thousand entries only a handful exist in the DOM.
+      const from = this.anchor ? this.indexOf(this.anchor) : 0;
+      const to = this.indexOf(key);
+      if (from >= 0 && to >= 0) {
+        const [lo, hi] = from <= to ? [from, to] : [to, from];
+        this.selection = new Set(
+            this.entries.slice(lo, hi + 1).map(entry => entry.key));
+      }
+    }
+    this.publish();
+  }
+
+  private indexOf(key: FileKey): number {
+    return this.entries.findIndex(entry => entry.key === key);
+  }
+
+  dispose(): void {
+    this.controller?.abort();
+    this.controller = null;
+    this.listeners.clear();
+  }
+}
diff --git a/ui/file_manager/file_manager/kibaos/tests/adapter/adapter_test.ts b/ui/file_manager/file_manager/kibaos/tests/adapter/adapter_test.ts
new file mode 100644
index 0000000000..f415fc4207
--- /dev/null
+++ b/ui/file_manager/file_manager/kibaos/tests/adapter/adapter_test.ts
@@ -0,0 +1,712 @@
+/**
+ * What the shared contract cannot ask.
+ *
+ * The contract is written to be true of any backend, so it cannot mention
+ * DOMException names, ChromeOS volume type strings, or the fact that a change
+ * event is allowed to omit what changed. Those are the adapter's whole job, so
+ * they are tested here.
+ */
+import {ChromeOsBackend} from '../../adapter/chromeos_backend.js';
+import type {ChangeEvent, EntryPage, IoProgress} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import {FakePlatform} from './fake_platform.js';
+import {armed} from '../contract/port_contract.js';
+import {beginCheck} from '../progress.js';
+
+const ROOT = 'filesystem:chrome://file-manager/external/myfiles';
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+function withRoot(options?: ConstructorParameters<typeof FakePlatform>[0]):
+    FakePlatform {
+  return new FakePlatform(options).addVolume({
+    volumeId: 'system',
+    volumeType: 'downloads',
+    label: 'My files',
+    url: ROOT,
+    sizeStats: {totalSize: 512e9, remainingSize: 8.7e9},
+  });
+}
+
+async function drain(pages: AsyncIterable<EntryPage>): Promise<string[]> {
+  const names: string[] = [];
+  for await (const page of pages) {
+    names.push(...page.entries.map(entry => entry.name));
+  }
+  return names;
+}
+
+interface Check {
+  name: string;
+  run(): Promise<void>;
+}
+
+const CHECKS: Check[] = [
+  {
+    name: 'every DOMException the platform throws becomes a typed code',
+    async run() {
+      const expected: Array<[string, string]> = [
+        ['NotFoundError', 'not-found'],
+        ['TypeMismatchError', 'unsupported'],
+        ['NoModificationAllowedError', 'read-only'],
+        ['SecurityError', 'permission-denied'],
+        ['NotAllowedError', 'permission-denied'],
+        ['QuotaExceededError', 'no-space'],
+        ['AbortError', 'cancelled'],
+        // A key naming a volume that is no longer mounted fails this way, not
+        // as NotFoundError. Measured on hardware; the fake had no opinion.
+        ['EncodingError', 'not-found'],
+        // Anything unrecognised is io rather than a crash or a guess.
+        ['SomeFutureChromeError', 'io'],
+      ];
+      for (const [name, code] of expected) {
+        const platform = withRoot();
+        const folder = platform.add(ROOT, 'sub', true);
+        platform.failResolve(folder, name);
+        const port = new ChromeOsBackend(platform);
+        try {
+          await drain(port.list(asFileKey(folder)));
+          throw new AssertionError(`${name} did not fail at all`);
+        } catch (error) {
+          assert(error instanceof FilesError,
+                 `${name} came back as ${(error as Error)?.name}, not a FilesError`);
+          equal(error.code, code, `${name} mapped to the wrong code`);
+        }
+      }
+    },
+  },
+  {
+    name: 'a change event that does not say what changed is worked out',
+    async run() {
+      // The real API reports only that a directory changed, every time.
