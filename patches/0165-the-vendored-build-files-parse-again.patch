--- a/ui/display/manager/display_manager.cc
+++ b/ui/display/manager/display_manager.cc
@@ -552,6 +552,17 @@ void DisplayManager::RefreshFontParams() {
     }
   }
 
+  // KibaOS: the subpixel order is one setting for every monitor, and a
+  // monitor turned on its side would show it the wrong way round.
+  if (!base::SysInfo::IsRunningOnChromeOS()) {
+    for (const auto& display : active_display_list_) {
+      if (GetDisplayInfo(display.id()).GetLogicalActiveRotation() !=
+          Display::ROTATE_0) {
+        force_disable_subpixel_font_rendering = true;
+      }
+    }
+  }
+
   if (features::IsOledScaleFactorEnabled()) {
     force_disable_subpixel_font_rendering = true;
   }
@@ -874,10 +885,15 @@ void DisplayManager::RegisterDisplayProperty(
 
   info.SetRotation(rotation, Display::RotationSource::USER);
   info.SetRotation(rotation, Display::RotationSource::ACTIVE);
-  info.set_zoom_factor(display_zoom_factor);
+  // KibaOS compatibility: on a Linux host each display's scale is its device
+  // scale factor alone, which Ash's display source sets, so a zoom saved
+  // with the display, by an older session or ChromeOS's own default, is not
+  // brought back.
+  const bool keep_zoom = base::SysInfo::IsRunningOnChromeOS();
+  info.set_zoom_factor(keep_zoom ? display_zoom_factor : 1.f);
 
   for (const auto& it : display_zoom_factor_map) {
-    info.AddZoomFactorForSize(it.first, it.second);
+    info.AddZoomFactorForSize(it.first, keep_zoom ? it.second : 1.f);
   }
 
   if (overscan_insets) {
@@ -2431,6 +2447,12 @@ void DisplayManager::ApplyDefaultZoomFactorIfNecessary(
     return;
