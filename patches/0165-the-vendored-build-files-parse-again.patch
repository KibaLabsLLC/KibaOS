+/**
+ * The real backend: `FilesBackendPort` over the plumbing we kept.
+ *
+ * Everything it touches is behind `Platform`, so the contract suite runs
+ * against it here rather than only on a machine. That proves the translation:
+ * identity, paging, error mapping, revisions and the change diff. It does not
+ * prove that `Platform` describes ChromeOS correctly, and only hardware can.
+ *
+ * Four capabilities are implemented: list, metadata, watch and volumes, which
+ * is what the window uses. The rest throw `unsupported` rather than returning
+ * something plausible, and the contract reports them as skipped rather than
+ * passing over them quietly.
+ */
+import type {FilesBackendPort} from '../port/port.js';
+import type {ChangeEvent, DialogKind, DialogMode, EntryDto, EntryPage, FileKey, IoKind, IoProgress, IoRequest, IoState, ListOptions, Metadata, MetadataField, MetadataSnapshot, TaskDescriptor, TaskId, Volume, VolumeKind, VolumePurpose} from '../port/types.js';
+import {asFileKey, FilesError} from '../port/types.js';
+import type {Platform, PlatformEntry, PlatformIoProgress, PlatformIoState, PlatformIoType, PlatformMetadata, PlatformResultingTasks, PlatformTaskDescriptor, PlatformVolume} from './platform.js';
+
+/** ChromeOS volume types, as they are actually spelled. */
+/**
+ * What a place is for, keyed by the tail of its volume id.
+ *
+ * The id and not the label. `local_root:Pictures` is spelled that way whatever
+ * language the desktop is in, and its label is whatever XDG decided to call it,
+ * so matching on the label would give a French install a sidebar of identical
+ * disk glyphs. Anything not listed simply has no purpose, which is the ordinary
+ * case and draws the disk it always drew.
+ */
+const PURPOSES: Record<string, VolumePurpose> = {
+  Desktop: 'desktop',
+  Documents: 'documents',
+  Downloads: 'downloads',
+  Music: 'music',
+  Pictures: 'pictures',
+  Videos: 'videos',
+};
+
+/** The part of `local_root:Pictures` after the colon, or '' if there is none. */
+function suffixOf(volumeId: string): string {
+  const colon = volumeId.indexOf(':');
+  return colon < 0 ? '' : volumeId.slice(colon + 1);
+}
+
+/**
+ * Which id suffix names the account's own home directory.
+ *
+ * Nothing in a single volume says "this one is home". ChromeOS's `downloads`
+ * volume is My files and its id carries the account name, and the same account
+ * home is published separately as `local_root:<account>`, so the downloads
+ * volume is read for the name and whatever local_root shares it is home.
+ *
+ * Undefined where there is no downloads volume, which means no place is marked
+ * as home rather than that the wrong one is.
+ */
+function homeSuffixOf(volumes: readonly PlatformVolume[]): string|undefined {
+  const downloads = volumes.find(volume => volume.volumeType === 'downloads');
+  const suffix = downloads ? suffixOf(downloads.volumeId) : '';
+  return suffix || undefined;
+}
+
+function purposeOf(volume: PlatformVolume, home: string|undefined):
+    VolumePurpose|undefined {
+  // My files is the account's own files whatever its id looks like. Usually
+  // the test below would catch it anyway, because the account name is read off
+  // this very volume and so always matches it. Usually is not always: an id
+  // with no colon in it yields no account name at all, and then this is the
+  // only line that marks a home.
+  if (volume.volumeType === 'downloads') {
+    return 'home';
+  }
+  const suffix = suffixOf(volume.volumeId);
+  if (home !== undefined && suffix === home) {
+    return 'home';
+  }
+  return PURPOSES[suffix];
