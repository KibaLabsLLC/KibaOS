+void AndroidAppsHandler::ConnectKibaosProgress() {
+  if (kibaos_proxy_) {
+    return;
+  }
+  dbus::Bus* bus = arc::GetKibaOSAndroidBus();
+  if (!bus) {
+    return;
+  }
+  kibaos_proxy_ =
+      bus->GetObjectProxy(kKibaosService, dbus::ObjectPath(kKibaosPath));
+  kibaos_proxy_->ConnectToSignal(
+      kKibaosInterface, "Progress",
+      base::BindRepeating(&AndroidAppsHandler::OnKibaosProgress,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce([](const std::string&, const std::string&, bool ok) {
+        LOG_IF(ERROR, !ok) << "KibaOS Android: could not watch Progress";
+      }));
+}
+
+void AndroidAppsHandler::HandleRequestKibaosAndroidInfo(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (!arc::IsKibaOSAndroidEnabled()) {
+    return;
+  }
+  ConnectKibaosProgress();
+  if (!kibaos_proxy_) {
+    return;
+  }
+  dbus::MethodCall call(kKibaosInterface, "Info");
+  kibaos_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&AndroidAppsHandler::OnKibaosInfoReply,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AndroidAppsHandler::OnKibaosInfoReply(dbus::Response* response,
+                                           dbus::ErrorResponse* error) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  std::string json;
+  if (!reader.PopString(&json)) {
+    return;
+  }
+  std::optional<base::Value> parsed = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (parsed && parsed->is_dict()) {
+    FireWebUIListener("kibaos-android-info", *parsed);
+  }
+}
+
+void AndroidAppsHandler::HandleKibaosAndroidCall(const base::ListValue& args) {
+  AllowJavascript();
+  if (!arc::IsKibaOSAndroidEnabled() || args.size() != 1 ||
+      !args[0].is_string()) {
+    return;
+  }
+  const std::string& what = args[0].GetString();
+  // Only these four exist; the page cannot ask for anything else.
+  const char* method = what == "update"        ? "Update"
+                       : what == "remove"      ? "Remove"
+                       : what == "rollback"    ? "Rollback"
+                       : what == "diagnostics" ? "Diagnostics"
+                                               : nullptr;
+  if (!method) {
+    return;
+  }
+  ConnectKibaosProgress();
+  if (!kibaos_proxy_) {
+    return;
+  }
+  dbus::MethodCall call(kKibaosInterface, method);
+  kibaos_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_MAX,
+      base::BindOnce(&AndroidAppsHandler::OnKibaosCallReply,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AndroidAppsHandler::OnKibaosCallReply(dbus::Response* response,
+                                           dbus::ErrorResponse* error) {
+  LOG_IF(ERROR, !response) << "KibaOS Android: call failed: "
+                           << (error ? error->GetErrorName() : "no reply");
+  HandleRequestKibaosAndroidInfo(base::ListValue());
+}
+
+void AndroidAppsHandler::HandleRequestKibaosNetworkApps(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (!arc::IsKibaOSAndroidEnabled()) {
+    return;
+  }
+  ConnectKibaosProgress();
+  if (!kibaos_proxy_) {
+    return;
+  }
+  dbus::MethodCall call(kKibaosInterface, "NetworkApps");
+  kibaos_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&AndroidAppsHandler::OnKibaosNetworkAppsReply,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AndroidAppsHandler::OnKibaosNetworkAppsReply(
+    dbus::Response* response,
+    dbus::ErrorResponse* error) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  std::string json;
+  if (!reader.PopString(&json)) {
+    return;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (parsed && parsed->is_list()) {
+    FireWebUIListener("kibaos-android-network-apps", *parsed);
+  }
+}
+
+void AndroidAppsHandler::HandleSetKibaosNetworkAllowed(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (!arc::IsKibaOSAndroidEnabled() || args.size() != 2 ||
+      !args[0].is_string() || !args[1].is_bool()) {
+    return;
+  }
+  ConnectKibaosProgress();
+  if (!kibaos_proxy_) {
+    return;
+  }
+  dbus::MethodCall call(kKibaosInterface, "SetNetworkAllowed");
+  dbus::MessageWriter writer(&call);
+  writer.AppendString(args[0].GetString());
+  writer.AppendBool(args[1].GetBool());
+  kibaos_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_MAX,
+      base::BindOnce(
+          [](base::WeakPtr<AndroidAppsHandler> self, dbus::Response* response,
+             dbus::ErrorResponse* error) {
+            LOG_IF(ERROR, !response)
+                << "KibaOS Android: network switch failed: "
+                << (error ? error->GetErrorName() : "no reply");
+            if (self) {
+              self->HandleRequestKibaosNetworkApps(base::ListValue());
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AndroidAppsHandler::OnKibaosProgress(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  std::string stage;
+  int32_t percent = 0;
+  if (!reader.PopString(&stage) || !reader.PopInt32(&percent)) {
+    return;
+  }
+  FireWebUIListener("kibaos-android-progress", base::Value(stage),
+                    base::Value(percent));
+  if (stage == "done" || stage == "failed") {
+    HandleRequestKibaosAndroidInfo(base::ListValue());
+  }
+}
+
