[Unit]
Description=Build and validate a KibaOS release candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/kibaos/release-build.conf
ExecStart=/usr/bin/bash /usr/local/src/kibaos/ci/build-release-candidate.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
