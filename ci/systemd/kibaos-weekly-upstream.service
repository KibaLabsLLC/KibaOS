[Unit]
Description=Validate and promote the weekly KibaOS Chromium upstream candidate
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/kibaos/weekly-upstream.conf

[Service]
Type=oneshot
EnvironmentFile=-/etc/kibaos/release-build.conf
EnvironmentFile=/etc/kibaos/weekly-upstream.conf
ExecStart=/usr/bin/bash /usr/local/src/kibaos/ci/update-chromium-candidate.sh --run
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=infinity
